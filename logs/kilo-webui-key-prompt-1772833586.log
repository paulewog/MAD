 \t\t\t\tallFeatures = append(allFeatures, f)\n240: \t\t\t}\n241: \t\t}\n242: \t\tw.Header().Set(\"Content-Type\", \"text/html\")\n243: \t\tdata := map[string]interface{}{\n244: \t\t\t\"StageGroups\": groupFeaturesByStage(allFeatures),\n245: \t\t\t\"Key\":         r.URL.Query().Get(\"key\"),\n246: \t\t}\n247: \t\tif err := tmpl.ExecuteTemplate(w, \"board_fragment\", data); err != nil {\n248: \t\t\tlog.Printf(\"template error: %v\", err)\n249: \t\t\thttp.Error(w, \"internal server error\", 500)\n250: \t\t}\n251: \t})\n252: \n253: \t// Favicon\n254: \tmux.HandleFunc(\"/favicon.svg\", func(w http.ResponseWriter, r *http.Request) {\n255: \t\tdata, err := staticFS.ReadFile(\"static/favicon.svg\")\n256: \t\tif err != nil {\n257: \t\t\thttp.NotFound(w, r)\n258: \t\t\treturn\n259: \t\t}\n260: \t\tw.Header().Set(\"Content-Type\", \"image/svg+xml\")\n261: \t\tw.Header().Set(\"Cache-Control\", \"public, max-age=86400\")\n262: \t\tw.Write(data)\n263: \t})\n264: \n265: \t// Service worker (served from root for scope)\n266: \tmux.HandleFunc(\"/sw.js\", func(w http.ResponseWriter, r *http.Request) {\n267: \t\tdata, err := staticFS.ReadFile(\"static/sw.js\")\n268: \t\tif err != nil {\n269: \t\t\thttp.NotFound(w, r)\n270: \t\t\treturn\n271: \t\t}\n272: \t\tw.Header().Set(\"Content-Type\", \"application/javascript\")\n273: \t\tw.Header().Set(\"Service-Worker-Allowed\", \"/\")\n274: \t\tw.Header().Set(\"Cache-Control\", \"no-cache\")\n275: \t\tw.Write(data)\n276: \t})\n277: \n278: \t// WebSocket endpoint\n279: \tmux.HandleFunc(\"/ws\", func(w http.ResponseWriter, r *http.Request) {\n280: \t\t// Auth via query param or header\n281: \t\tauthorized := false\n282: \t\tif cfg.APIKey == \"\" {\n283: \t\t\tauthorized = true\n284: \t\t} else {\n285: \t\t\tif r.URL.Query().Get(\"api_key\") == cfg.APIKey {\n286: \t\t\t\tauthorized = true\n287: \t\t\t} else if checkAPIAuth(r, cfg.APIKey) {\n288: \t\t\t\tauthorized = true\n289: \t\t\t}\n290: \t\t}\n291: \t\tif !authorized {\n292: \t\t\twriteJSON(