r-radius:4px;color:#c9d1d9;font-size:0.9rem;font-family:inherit\">\n266:                     <option value=\"\">Select a client...</option>\n267:                 </select>\n268:             </div>\n269:             <div style=\"margin-bottom:1rem\">\n270:                 <label style=\"display:block;color:#8b949e;font-size:0.8rem;margin-bottom:0.3rem\">Title *</label>\n271:                 <input type=\"text\" id=\"new-idea-title\" placeholder=\"Enter idea title\" style=\"width:100%;padding:0.5rem;background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#c9d1d9;font-size:0.9rem;font-family:inherit\">\n272:             </div>\n273:             <div style=\"margin-bottom:1rem\">\n274:                 <label style=\"display:block;color:#8b949e;font-size:0.8rem;margin-bottom:0.3rem\">Board *</label>\n275:                 <input type=\"text\" id=\"new-idea-board\" placeholder=\"e.g., default\" style=\"width:100%;padding:0.5rem;background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#c9d1d9;font-size:0.9rem;font-family:inherit\">\n276:             </div>\n277:             <div style=\"margin-bottom:1rem\">\n278:                 <label style=\"display:block;color:#8b949e;font-size:0.8rem;margin-bottom:0.3rem\">Description</label>\n279:                 <textarea id=\"new-idea-description\" placeholder=\"Optional description\" rows=\"3\" style=\"width:100%;padding:0.5rem;background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#c9d1d9;font-size:0.9rem;font-family:inherit;resize:vertical\"></textarea>\n280:             </div>\n281:             <div style=\"display:flex;gap:0.5rem;justify-content:flex-end\">\n282:                 <button onclick=\"closeNewIdeaModal()\" style=\"padding:0.5rem 1rem;background:#30363d;color:#c9d1d9;border:none;border-radius:4px;cursor:pointer;font-size:0.85rem;font-family:inherit\">Cancel</button>\n283:                 <button onclick=\"submitNewIdea()\" id=\"submit-idea-btn\" style=\"padding:0.5rem 1rem;backgrou