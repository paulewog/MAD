iteJSON(reg); err != nil {\n\t\tt.Fatalf(\"write register: %v\", err)\n\t}\n\n\tvar resp map[string]string\n\tif err := conn.ReadJSON(&resp); err != nil {\n\t\tt.Fatalf(\"read ack: %v\", err)\n\t}\n\tif resp[\"type\"] != \"ack\" {\n\t\tt.Fatalf(\"expected ack, got %v\", resp)\n\t}\n\n\tstateMsg := map[string]interface{}{\n\t\t\"type\":      \"state_update\",\n\t\t\"client_id\": \"test-client\",\n\t\t\"auto_plan\": true,\n\t\t\"auto_impl\": false,\n\t\t\"features\":  []interface{}{},\n\t}\n\tif err := conn.WriteJSON(stateMsg); err != nil {\n\t\tt.Fatalf(\"write state: %v\", err)\n\t}\n\n\ttime.Sleep(50 * time.Millisecond)\n\n\tclientState, ok := hub.GetClient(\"test-client\")\n\tif !ok {\n\t\tt.Fatal(\"client not found\")\n\t}\n\n\tif !clientState.AutoPlan {\n\t\tt.Error(\"AutoPlan should be true\")\n\t}\n\tif clientState.AutoImpl {\n\t\tt.Error(\"AutoImpl should be false\")\n\t}\n}\n\nfunc TestHubStateUpdateAutoModeBothTrue(t *testing.T) {\n\tcfg := testConfig(\"test-key\")\n\thub := NewHub(cfg)\n\tgo hub.Run()\n\tdefer func() {\n\t\thub.unregister <- &Client{clientID: \"test-client-2\"}\n\t\ttime.Sleep(50 * time.Millisecond)\n\t}()\n\n\t_, ts := startTestServer(cfg)\n\tdefer ts.Close()\n\n\tconn, _, err := websocket.DefaultDialer.Dial(\"ws\"+ts.URL[4:]+\"/ws?api_key=test-key\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"dial failed: %v\", err)\n\t}\n\tdefer conn.Close()\n\n\treg := map[string]string{\n\t\t\"type\":      \"register\",\n\t\t\"client_id\": \"test-client-2\",\n\t\t\"api_key\":   \"test-key\",\n\t}\n\tconn.WriteJSON(reg)\n\tconn.ReadJSON(&resp)\n\n\tstateMsg := map[string]interface{}{\n\t\t\"type\":      \"state_update\",\n\t\t\"client_id\": \"test-client-2\",\n\t\t\"auto_plan\": true,\n\t\t\"auto_impl\": true,\n\t\t\"features\":  []interface{}{},\n\t}\n\tconn.WriteJSON(stateMsg)\n\n\ttime.Sleep(50 * time.Millisecond)\n\n\tclientState, _ := hub.GetClient(\"test-client-2\")\n\tif !clientState.AutoPlan || !clientState.AutoImpl {\n\t\tt.Error(\"both AutoPlan 