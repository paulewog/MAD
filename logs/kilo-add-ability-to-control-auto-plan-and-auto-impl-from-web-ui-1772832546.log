{"type":"tool_use","timestamp":1772832564497,"sessionID":"ses_33af21c17ffeSjD9lLu1QoQ8dY","part":{"id":"prt_cc50e24e3001E1uyW3klpeKjoH","sessionID":"ses_33af21c17ffeSjD9lLu1QoQ8dY","messageID":"msg_cc50e08f5001DlCV4fc8l9wC5E","type":"tool","callID":"call_function_zgzysp7eek0o_1","tool":"read","state":{"status":"completed","input":{"filePath":"/home/paule/MAD/pipeline/test_auto_mode.py"},"output":"<path>/home/paule/MAD/pipeline/test_auto_mode.py</path>\n<type>file</type>\n<content>1: \"\"\"Tests for auto-plan/auto-impl WebSocket controls in ServerClient.\"\"\"\n2: \n3: import asyncio\n4: import json\n5: import unittest\n6: from unittest.mock import AsyncMock, MagicMock, patch\n7: \n8: import sys, os\n9: sys.path.insert(0, os.path.dirname(__file__))\n10: \n11: from server_client import ServerClient\n12: \n13: \n14: class TestPushStateAutoMode(unittest.IsolatedAsyncioTestCase):\n15:     \"\"\"Test that push_state() includes auto_plan and auto_impl booleans.\"\"\"\n16: \n17:     async def _make_connected_client(self):\n18:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test-client\")\n19:         client._connected = True\n20:         client._ws = AsyncMock()\n21:         client._ws.send = AsyncMock()\n22:         return client\n23: \n24:     async def test_push_state_includes_auto_plan_true_auto_impl_false(self):\n25:         client = await self._make_connected_client()\n26:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=False)\n27:         sent = json.loads(client._ws.send.call_args[0][0])\n28:         self.assertTrue(sent[\"auto_plan\"])\n29:         self.assertFalse(sent[\"auto_impl\"])\n30: \n31:     async def test_push_state_both_false_by_default(self):\n32:         client = await self._make_connected_client()\n33:         await client.push_state([])\n34:         sent = json.loads(client._ws.send.call_args[0][0])\n35:         self.assertFalse(sent[\"auto_plan\"])\n36:         self.assertFalse(sent[\"auto_impl\"])\n37: \n38:     async def test_push_state_both_true(self):\n39:         client = await self._make_connected_client()\n40:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=True)\n41:         sent = json.loads(client._ws.send.call_args[0][0])\n42:         self.assertTrue(sent[\"auto_plan\"])\n43:         self.assertTrue(sent[\"auto_impl\"])\n44: \n45:     async def test_push_state_not_connected_returns_early(self):\n46:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test-client\")\n47:         client._connected = False\n48:         client._ws = None\n49:         # Should not raise\n50:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=True)\n51: \n52: \n53: class TestHandleIncomingSetAutoMode(unittest.IsolatedAsyncioTestCase):\n54:     \"\"\"Test _handle_incoming() for set_auto_mode messages.\"\"\"\n55: \n56:     async def test_set_auto_mode_plan_true(self):\n57:         callback = MagicMock()\n58:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n59:         await client._handle_incoming(json.dumps({\n60:             \"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": True\n61:         }))\n62:         callback.assert_called_once_with(\"plan\", True)\n63: \n64:     async def test_set_auto_mode_impl_false(self):\n65:         callback = MagicMock()\n66:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n67:         await client._handle_incoming(json.dumps({\n68:             \"type\": \"set_auto_mode\", \"mode\": \"impl\", \"enabled\": False\n69:         }))\n70:         callback.assert_called_once_with(\"impl\", False)\n71: \n72:     async def test_set_auto_mode_no_callback_no_crash(self):\n73:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\")\n74:         # Should not raise\n75:         await client._handle_incoming(json.dumps({\n76:             \"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": True\n77:         }))\n78: \n79:     async def test_set_auto_mode_callback_exception_caught(self):\n80:         def bad_callback(mode, enabled):\n81:             raise RuntimeError(\"boom\")\n82:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=bad_callback)\n83:         # Should not raise\n84:         await client._handle_incoming(json.dumps({\n85:             \"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": True\n86:         }))\n87: \n88: \n89: class TestHandleIncomingSetAutoModeInvalid(unittest.IsolatedAsyncioTestCase):\n90:     \"\"\"Test that invalid set_auto_mode messages are silently dropped.\"\"\"\n91: \n92:     async def _assert_callback_not_called(self, msg):\n93:         callback = MagicMock()\n94:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n95:         await client._handle_incoming(json.dumps(msg))\n96:         callback.assert_not_called()\n97: \n98:     async def test_invalid_mode(self):\n99:         await self._assert_callback_not_called(\n100:             {\"type\": \"set_auto_mode\", \"mode\": \"foo\", \"enabled\": True})\n101: \n102:     async def test_empty_mode(self):\n103:         await self._assert_callback_not_called(\n104:             {\"type\": \"set_auto_mode\", \"mode\": \"\", \"enabled\": True})\n105: \n106:     async def test_missing_mode(self):\n107:         await self._assert_callback_not_called(\n108:             {\"type\": \"set_auto_mode\", \"enabled\": True})\n109: \n110:     async def test_enabled_not_bool_string(self):\n111:         await self._assert_callback_not_called(\n112:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": \"yes\"})\n113: \n114:     async def test_enabled_not_bool_int(self):\n115:         await self._assert_callback_not_called(\n116:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": 1})\n117: \n118:     async def test_enabled_null(self):\n119:         await self._assert_callback_not_called(\n120:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": None})\n121: \n122:     async def test_missing_enabled(self):\n123:         await self._assert_callback_not_called(\n124:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\"})\n125: \n126:     async def test_missing_both(self):\n127:         await self._assert_callback_not_called(\n128:             {\"type\": \"set_auto_mode\"})\n129: \n130:     async def test_null_mode(self):\n131:         await self._assert_callback_not_called(\n132:             {\"type\": \"set_auto_mode\", \"mode\": None, \"enabled\": True})\n133: \n134:     async def test_non_json_message(self):\n135:         callback = MagicMock()\n136:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n137:         await client._handle_incoming(\"hello\")\n138:         callback.assert_not_called()\n139: \n140: \n141: if __name__ == \"__main__\":\n142:     unittest.main()\n\n(End of file - total 142 lines)\n</content>","title":"pipeline/test_auto_mode.py","metadata":{"preview":"\"\"\"Tests for auto-plan/auto-impl WebSocket controls in ServerClient.\"\"\"\n\nimport asyncio\nimport json\nimport unittest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nimport sys, os\nsys.path.insert(0, os.path.dirname(__file__))\n\nfrom server_client import ServerClient\n\n\nclass TestPushStateAutoMode(unittest.IsolatedAsyncioTestCase):\n    \"\"\"Test that push_state() includes auto_plan and auto_impl booleans.\"\"\"\n\n    async def _make_connected_client(self):\n        client = ServerClient(\"ws://localhost:9999\", \"key\", \"test-client\")\n        client._connected = True\n        client._ws = AsyncMock()","truncated":false,"loaded":[]},"time":{"start":1772832564453,"end":1772832564496}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I need to examine the existing test patterns in the project. Let me look at the existing test files, especially `test_auto_mode.py` which likely has tests for auto-mode functionality, and also look at `test_server_client.py` to understand the test patterns.","format":"anthropic-claude-v1","index":0,"signature":"8142ea28a0f0bbfa03d74d70e7464221f509b5728b8f45026c165bff63c2fe23"}]}}}}
{"type":"tool_use","timestamp":1772832564944,"sessionID":"ses_33af21c17ffeSjD9lLu1QoQ8dY","part":{"id":"prt_cc50e24e7001Sg6UoZCxDH2Tp8","sessionID":"ses_33af21c17ffeSjD9lLu1QoQ8dY","messageID":"msg_cc50e08f5001DlCV4fc8l9wC5E","type":"tool","callID":"call_function_zgzysp7eek0o_2","tool":"read","state":{"status":"completed","input":{"filePath":"/home/paule/MAD/pipeline/test_server_client.py"},"output":"<path>/home/paule/MAD/pipeline/test_server_client.py</path>\n<type>file</type>\n<content>1: \"\"\"Tests for server client/config integration (server_client.py + config.py server bits).\n2: \n3: Run with:\n4:     pytest test_server_client.py -v\n5: \"\"\"\n6: \n7: import asyncio\n8: import json\n9: import logging\n10: import sys\n11: from datetime import datetime, timezone\n12: from pathlib import Path\n13: from types import SimpleNamespace\n14: from unittest.mock import AsyncMock, MagicMock, patch\n15: \n16: import pytest\n17: \n18: sys.path.insert(0, str(Path(__file__).parent))\n19: \n20: from config import Config, ServerConfig\n21: from server_client import ServerClient\n22: \n23: \n24: # ---------------------------------------------------------------------------\n25: # Fixtures\n26: # ---------------------------------------------------------------------------\n27: \n28: @pytest.fixture\n29: def tmp_config(tmp_path):\n30:     \"\"\"Create a temp config file and return its path.\"\"\"\n31:     def _make(data):\n32:         config_dir = tmp_path / \".mad\"\n33:         config_dir.mkdir(parents=True, exist_ok=True)\n34:         config_file = config_dir / \"config.json\"\n35:         config_file.write_text(json.dumps(data))\n36:         return config_file\n37:     return _make\n38: \n39: \n40: def _make_feature(title=\"Test Feature\", stage=\"ideas\", board=\"default\",\n41:                   created=\"2025-01-01\", fid=\"f1\", logs=None):\n42:     \"\"\"Create a mock feature object matching FeatureFile interface.\"\"\"\n43:     f = SimpleNamespace()\n44:     f.title = title\n45:     f.current_stage = stage\n46:     f.board = board\n47:     f.created = created\n48:     f.id = fid\n49:     f.description = \"\"\n50:     f.questions = []\n51:     f._data = {\"pipeline_log\": logs or [], \"history\": []}\n52:     return f\n53: \n54: \n55: class FakeWebSocket:\n56:     \"\"\"Fake websocket connection for unit tests.\"\"\"\n57: \n58:     def __init__(self, responses=None, fail_send=False, fail_recv=False):\n59:         self._responses = list(responses or [])\n60:         self._sent = []\n61:         self._closed = False\n62:         self._fail_send = fail_send\n63:         self._fail_recv = fail_recv\n64: \n65:     async def send(self, data):\n66:         if self._fail_send:\n67:             raise ConnectionError(\"send failed\")\n68:         self._sent.append(data)\n69: \n70:     async def recv(self):\n71:         if self._fail_recv:\n72:             raise ConnectionError(\"recv failed\")\n73:         if self._responses:\n74:             return self._responses.pop(0)\n75:         # Block forever (simulate long-lived connection)\n76:         await asyncio.sleep(3600)\n77: \n78:     async def close(self):\n79:         self._closed = True\n80: \n81:     def __aiter__(self):\n82:         return self\n83: \n84:     async def __anext__(self):\n85:         if self._fail_recv or not self._responses:\n86:             raise StopAsyncIteration\n87:         return self._responses.pop(0)\n88: \n89: \n90: # ---------------------------------------------------------------------------\n91: # Config.server property tests\n92: # ---------------------------------------------------------------------------\n93: \n94: class TestConfigServer:\n95: \n96:     def test_server_disabled_by_default(self, tmp_config):\n97:         path = tmp_config({\n98:             \"current_agent\": \"claude\",\n99:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n100:             \"boards\": [\"default\"],\n101:         })\n102:         cfg = Config(path=path)\n103:         assert cfg.server is None\n104: \n105:     def test_server_disabled_explicitly(self, tmp_config):\n106:         path = tmp_config({\n107:             \"current_agent\": \"claude\",\n108:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n109:             \"boards\": [\"default\"],\n110:             \"server\": {\"enabled\": False, \"url\": \"ws://localhost:8080\", \"api_key\": \"k\", \"client_id\": \"c\"},\n111:         })\n112:         cfg = Config(path=path)\n113:         assert cfg.server is None\n114: \n115:     def test_server_enabled_full_config(self, tmp_config):\n116:         path = tmp_config({\n117:             \"current_agent\": \"claude\",\n118:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n119:             \"boards\": [\"default\"],\n120:             \"server\": {\n121:                 \"enabled\": True,\n122:                 \"url\": \"ws://localhost:8080\",\n123:                 \"api_key\": \"secret\",\n124:                 \"client_id\": \"my-machine\",\n125:                 \"push_interval_seconds\": 5.0,\n126:             },\n127:         })\n128:         cfg = Config(path=path)\n129:         sc = cfg.server\n130:         assert sc is not None\n131:         assert isinstance(sc, ServerConfig)\n132:         assert sc.enabled is True\n133:         assert sc.url == \"ws://localhost:8080\"\n134:         assert sc.api_key == \"secret\"\n135:         assert sc.client_id == \"my-machine\"\n136:         assert sc.push_interval_seconds == 5.0\n137: \n138:     def test_server_enabled_default_push_interval(self, tmp_config):\n139:         path = tmp_config({\n140:             \"current_agent\": \"claude\",\n141:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n142:             \"boards\": [\"default\"],\n143:             \"server\": {\n144:                 \"enabled\": True,\n145:                 \"url\": \"ws://localhost:8080\",\n146:                 \"api_key\": \"k\",\n147:                 \"client_id\": \"c\",\n148:             },\n149:         })\n150:         cfg = Config(path=path)\n151:         sc = cfg.server\n152:         assert sc.push_interval_seconds == 10.0\n153: \n154:     def test_server_enabled_missing_url_returns_none(self, tmp_config, caplog):\n155:         path = tmp_config({\n156:             \"current_agent\": \"claude\",\n157:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n158:             \"boards\": [\"default\"],\n159:             \"server\": {\"enabled\": True, \"api_key\": \"k\", \"client_id\": \"c\"},\n160:         })\n161:         cfg = Config(path=path)\n162:         with caplog.at_level(logging.WARNING):\n163:             result = cfg.server\n164:         assert result is None\n165: \n166:     def test_server_enabled_missing_api_key_returns_none(self, tmp_config, caplog):\n167:         path = tmp_config({\n168:             \"current_agent\": \"claude\",\n169:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n170:             \"boards\": [\"default\"],\n171:             \"server\": {\"enabled\": True, \"url\": \"ws://localhost:8080\", \"client_id\": \"c\"},\n172:         })\n173:         cfg = Config(path=path)\n174:         with caplog.at_level(logging.WARNING):\n175:             result = cfg.server\n176:         assert result is None\n177: \n178:     def test_server_enabled_missing_client_id_returns_none(self, tmp_config, caplog):\n179:         path = tmp_config({\n180:             \"current_agent\": \"claude\",\n181:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n182:             \"boards\": [\"default\"],\n183:             \"server\": {\"enabled\": True, \"url\": \"ws://localhost:8080\", \"api_key\": \"k\"},\n184:         })\n185:         cfg = Config(path=path)\n186:         with caplog.at_level(logging.WARNING):\n187:             result = cfg.server\n188:         assert result is None\n189: \n190:     def test_server_enabled_empty_api_key_returns_none(self, tmp_config, caplog):\n191:         path = tmp_config({\n192:             \"current_agent\": \"claude\",\n193:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n194:             \"boards\": [\"default\"],\n195:             \"server\": {\"enabled\": True, \"url\": \"ws://localhost:8080\", \"api_key\": \"\", \"client_id\": \"c\"},\n196:         })\n197:         cfg = Config(path=path)\n198:         with caplog.at_level(logging.WARNING):\n199:             result = cfg.server\n200:         assert result is None\n201: \n202:     def test_partial_server_block_no_crash(self, tmp_config):\n203:         path = tmp_config({\n204:             \"current_agent\": \"claude\",\n205:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n206:             \"boards\": [\"default\"],\n207:             \"server\": {\"enabled\": True},\n208:         })\n209:         cfg = Config(path=path)\n210:         # Should not crash, should return None\n211:         assert cfg.server is None\n212: \n213:     def test_server_block_empty_dict(self, tmp_config):\n214:         path = tmp_config({\n215:             \"current_agent\": \"claude\",\n216:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n217:             \"boards\": [\"default\"],\n218:             \"server\": {},\n219:         })\n220:         cfg = Config(path=path)\n221:         assert cfg.server is None\n222: \n223:     def test_no_server_block_at_all(self, tmp_config):\n224:         path = tmp_config({\n225:             \"current_agent\": \"claude\",\n226:             \"agents\": {\"claude\": {\"command\": \"claude\", \"headless_flag\": \"-p\"}},\n227:             \"boards\": [\"default\"],\n228:         })\n229:         cfg = Config(path=path)\n230:         assert cfg.server is None\n231: \n232: \n233: # ---------------------------------------------------------------------------\n234: # ServerClient unit tests\n235: # ---------------------------------------------------------------------------\n236: \n237: class TestServerClientInit:\n238: \n239:     def test_initial_state(self):\n240:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"my-client\")\n241:         assert sc.connected is False\n242:         assert sc._url == \"ws://localhost:8080\"\n243:         assert sc._api_key == \"key\"\n244:         assert sc._client_id == \"my-client\"\n245:         assert sc._backoff == 1.0\n246:         assert sc._max_backoff == 30.0\n247: \n248: \n249: class TestServerClientConnect:\n250: \n251:     @pytest.mark.asyncio\n252:     async def test_connect_success(self):\n253:         ack_response = json.dumps({\"type\": \"ack\"})\n254:         fake_ws = FakeWebSocket(responses=[ack_response])\n255: \n256:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n257:              patch(\"server_client.websockets\") as mock_ws:\n258:             mock_ws.connect = AsyncMock(return_value=fake_ws)\n259:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"client-1\")\n260:             result = await sc.connect()\n261: \n262:         assert result is True\n263:         assert sc.connected is True\n264:         assert sc._backoff == 1.0  # reset on success\n265:         # Verify register message was sent\n266:         sent = json.loads(fake_ws._sent[0])\n267:         assert sent[\"type\"] == \"register\"\n268:         assert sent[\"client_id\"] == \"client-1\"\n269:         assert sent[\"api_key\"] == \"key\"\n270: \n271:     @pytest.mark.asyncio\n272:     async def test_connect_ws_url_appended(self):\n273:         ack_response = json.dumps({\"type\": \"ack\"})\n274:         fake_ws = FakeWebSocket(responses=[ack_response])\n275: \n276:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n277:              patch(\"server_client.websockets\") as mock_ws:\n278:             mock_ws.connect = AsyncMock(return_value=fake_ws)\n279:             sc = ServerClient(\"http://localhost:8080\", \"key\", \"c\")\n280:             await sc.connect()\n281: \n282:         call_args = mock_ws.connect.call_args\n283:         assert call_args[0][0] == \"http://localhost:8080/ws\"\n284: \n285:     @pytest.mark.asyncio\n286:     async def test_connect_url_trailing_slash_handled(self):\n287:         ack_response = json.dumps({\"type\": \"ack\"})\n288:         fake_ws = FakeWebSocket(responses=[ack_response])\n289: \n290:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n291:              patch(\"server_client.websockets\") as mock_ws:\n292:             mock_ws.connect = AsyncMock(return_value=fake_ws)\n293:             sc = ServerClient(\"http://localhost:8080/\", \"key\", \"c\")\n294:             await sc.connect()\n295: \n296:         call_args = mock_ws.connect.call_args\n297:         assert call_args[0][0] == \"http://localhost:8080/ws\"\n298: \n299:     @pytest.mark.asyncio\n300:     async def test_connect_server_rejects(self):\n301:         err_response = json.dumps({\"type\": \"error\", \"message\": \"unauthorized\"})\n302:         fake_ws = FakeWebSocket(responses=[err_response])\n303: \n304:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n305:              patch(\"server_client.websockets\") as mock_ws:\n306:             mock_ws.connect = AsyncMock(return_value=fake_ws)\n307:             sc = ServerClient(\"ws://localhost:8080\", \"wrong\", \"c\")\n308:             result = await sc.connect()\n309: \n310:         assert result is False\n311:         assert sc.connected is False\n312:         assert fake_ws._closed is True\n313: \n314:     @pytest.mark.asyncio\n315:     async def test_connect_network_failure(self):\n316:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n317:              patch(\"server_client.websockets\") as mock_ws:\n318:             mock_ws.connect = AsyncMock(side_effect=ConnectionRefusedError(\"refused\"))\n319:             sc = ServerClient(\"ws://localhost:9999\", \"key\", \"c\")\n320:             result = await sc.connect()\n321: \n322:         assert result is False\n323:         assert sc.connected is False\n324: \n325:     @pytest.mark.asyncio\n326:     async def test_connect_no_websockets_library(self):\n327:         with patch(\"server_client.HAS_WEBSOCKETS\", False):\n328:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n329:             result = await sc.connect()\n330: \n331:         assert result is False\n332: \n333:     @pytest.mark.asyncio\n334:     async def test_connect_timeout_on_ack(self):\n335:         # Simulate ack never arriving\n336:         fake_ws = FakeWebSocket(responses=[])\n337: \n338:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n339:              patch(\"server_client.websockets\") as mock_ws:\n340:             mock_ws.connect = AsyncMock(return_value=fake_ws)\n341:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n342:             # This should timeout waiting for ack and return False\n343:             result = await sc.connect()\n344: \n345:         assert result is False\n346:         assert sc.connected is False\n347: \n348: \n349: # ---------------------------------------------------------------------------\n350: # ServerClient.push_state tests\n351: # ---------------------------------------------------------------------------\n352: \n353: class TestServerClientPushState:\n354: \n355:     @pytest.mark.asyncio\n356:     async def test_push_state_when_connected(self):\n357:         fake_ws = FakeWebSocket()\n358:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c1\")\n359:         sc._ws = fake_ws\n360:         sc._connected = True\n361: \n362:         features = [_make_feature(\"F1\", \"ideas\", \"board1\", \"2025-01-01\", \"f1\")]\n363:         await sc.push_state(features)\n364: \n365:         assert len(fake_ws._sent) == 1\n366:         payload = json.loads(fake_ws._sent[0])\n367:         assert payload[\"type\"] == \"state_update\"\n368:         assert payload[\"client_id\"] == \"c1\"\n369:         assert \"timestamp\" in payload\n370:         assert len(payload[\"features\"]) == 1\n371:         assert payload[\"features\"][0][\"title\"] == \"F1\"\n372:         assert payload[\"features\"][0][\"stage\"] == \"ideas\"\n373:         assert payload[\"features\"][0][\"board\"] == \"board1\"\n374:         assert payload[\"features\"][0][\"id\"] == \"f1\"\n375: \n376:     @pytest.mark.asyncio\n377:     async def test_push_state_not_connected_silently_skips(self):\n378:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n379:         sc._connected = False\n380:         sc._ws = None\n381: \n382:         # Should not raise\n383:         await sc.push_state([_make_feature()])\n384: \n385:     @pytest.mark.asyncio\n386:     async def test_push_state_send_failure_marks_disconnected(self):\n387:         fake_ws = FakeWebSocket(fail_send=True)\n388:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n389:         sc._ws = fake_ws\n390:         sc._connected = True\n391: \n392:         await sc.push_state([_make_feature()])\n393: \n394:         assert sc._connected is False\n395: \n396:     @pytest.mark.asyncio\n397:     async def test_push_state_empty_features(self):\n398:         fake_ws = FakeWebSocket()\n399:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n400:         sc._ws = fake_ws\n401:         sc._connected = True\n402: \n403:         await sc.push_state([])\n404: \n405:         payload = json.loads(fake_ws._sent[0])\n406:         assert payload[\"features\"] == []\n407:         assert payload[\"logs\"] == []\n408: \n409:     @pytest.mark.asyncio\n410:     async def test_push_state_includes_logs(self):\n411:         fake_ws = FakeWebSocket()\n412:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n413:         sc._ws = fake_ws\n414:         sc._connected = True\n415: \n416:         feature = _make_feature(logs=[\n417:             {\"ts\": \"2025-01-01T00:00:00Z\", \"phase\": \"planning\", \"output\": \"did stuff\"},\n418:         ])\n419:         await sc.push_state([feature])\n420: \n421:         payload = json.loads(fake_ws._sent[0])\n422:         assert len(payload[\"logs\"]) == 1\n423:         assert payload[\"logs\"][0][\"phase\"] == \"planning\"\n424:         assert payload[\"logs\"][0][\"client_id\"] == \"c\"\n425: \n426:     @pytest.mark.asyncio\n427:     async def test_push_state_truncates_log_output(self):\n428:         fake_ws = FakeWebSocket()\n429:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n430:         sc._ws = fake_ws\n431:         sc._connected = True\n432: \n433:         long_output = \"x\" * 1000\n434:         feature = _make_feature(logs=[\n435:             {\"ts\": \"t\", \"phase\": \"p\", \"output\": long_output},\n436:         ])\n437:         await sc.push_state([feature])\n438: \n439:         payload = json.loads(fake_ws._sent[0])\n440:         assert len(payload[\"logs\"][0][\"output\"]) == 500\n441: \n442:     @pytest.mark.asyncio\n443:     async def test_push_state_limits_logs_per_feature(self):\n444:         fake_ws = FakeWebSocket()\n445:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n446:         sc._ws = fake_ws\n447:         sc._connected = True\n448: \n449:         logs = [{\"ts\": f\"t{i}\", \"phase\": \"p\", \"output\": f\"log{i}\"} for i in range(20)]\n450:         feature = _make_feature(logs=logs)\n451:         await sc.push_state([feature])\n452: \n453:         payload = json.loads(fake_ws._sent[0])\n454:         # Only last 10 per feature\n455:         assert len(payload[\"logs\"]) == 10\n456:         assert payload[\"logs\"][0][\"output\"] == \"log10\"\n457: \n458:     @pytest.mark.asyncio\n459:     async def test_push_state_timestamp_is_utc_iso(self):\n460:         fake_ws = FakeWebSocket()\n461:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n462:         sc._ws = fake_ws\n463:         sc._connected = True\n464: \n465:         await sc.push_state([_make_feature()])\n466: \n467:         payload = json.loads(fake_ws._sent[0])\n468:         ts = payload[\"timestamp\"]\n469:         # Should be parseable as ISO format and contain timezone info\n470:         parsed = datetime.fromisoformat(ts)\n471:         assert parsed.tzinfo is not None\n472: \n473: \n474: # ---------------------------------------------------------------------------\n475: # ServerClient.disconnect tests\n476: # ---------------------------------------------------------------------------\n477: \n478: class TestServerClientDisconnect:\n479: \n480:     @pytest.mark.asyncio\n481:     async def test_disconnect_sends_message_and_closes(self):\n482:         fake_ws = FakeWebSocket()\n483:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c1\")\n484:         sc._ws = fake_ws\n485:         sc._connected = True\n486: \n487:         await sc.disconnect()\n488: \n489:         assert sc._connected is False\n490:         assert sc._ws is None\n491:         assert fake_ws._closed is True\n492:         # Check disconnect message was sent\n493:         sent = json.loads(fake_ws._sent[0])\n494:         assert sent[\"type\"] == \"disconnect\"\n495:         assert sent[\"client_id\"] == \"c1\"\n496: \n497:     @pytest.mark.asyncio\n498:     async def test_disconnect_when_not_connected(self):\n499:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n500:         sc._ws = None\n501:         sc._connected = False\n502:         # Should not raise\n503:         await sc.disconnect()\n504: \n505:     @pytest.mark.asyncio\n506:     async def test_disconnect_with_send_error(self):\n507:         fake_ws = FakeWebSocket(fail_send=True)\n508:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n509:         sc._ws = fake_ws\n510:         sc._connected = True\n511: \n512:         # Should not raise even if send fails\n513:         await sc.disconnect()\n514:         assert sc._connected is False\n515:         assert sc._ws is None\n516: \n517: \n518: # ---------------------------------------------------------------------------\n519: # ServerClient.reconnect_loop tests\n520: # ---------------------------------------------------------------------------\n521: \n522: class TestServerClientReconnectLoop:\n523: \n524:     @pytest.mark.asyncio\n525:     async def test_reconnect_loop_no_websockets(self):\n526:         with patch(\"server_client.HAS_WEBSOCKETS\", False):\n527:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n528:             # Should return immediately\n529:             await sc.reconnect_loop()\n530: \n531:     @pytest.mark.asyncio\n532:     async def test_reconnect_loop_cancelled_cleanly(self):\n533:         fake_ws = FakeWebSocket(responses=[json.dumps({\"type\": \"ack\"})])\n534: \n535:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n536:              patch(\"server_client.websockets\") as mock_ws:\n537:             mock_ws.connect = AsyncMock(return_value=fake_ws)\n538: \n539:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n540:             task = asyncio.create_task(sc.reconnect_loop())\n541:             await asyncio.sleep(0.1)\n542:             task.cancel()\n543: \n544:             # reconnect_loop catches CancelledError, calls disconnect, and returns cleanly\n545:             try:\n546:                 await task\n547:             except asyncio.CancelledError:\n548:                 pass\n549:             # Verify it disconnected cleanly\n550:             assert sc._connected is False\n551:             assert sc._ws is None\n552: \n553:     @pytest.mark.asyncio\n554:     async def test_reconnect_backoff_increases(self):\n555:         call_count = 0\n556:         backoffs = []\n557: \n558:         original_sleep = asyncio.sleep\n559: \n560:         async def mock_connect(*args, **kwargs):\n561:             raise ConnectionRefusedError(\"refused\")\n562: \n563:         async def mock_sleep(duration):\n564:             nonlocal call_count\n565:             backoffs.append(duration)\n566:             call_count += 1\n567:             if call_count >= 5:\n568:                 raise asyncio.CancelledError()\n569:             await original_sleep(0)\n570: \n571:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n572:              patch(\"server_client.websockets\") as mock_ws, \\\n573:              patch(\"asyncio.sleep\", side_effect=mock_sleep):\n574:             mock_ws.connect = AsyncMock(side_effect=ConnectionRefusedError(\"refused\"))\n575: \n576:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n577:             try:\n578:                 await sc.reconnect_loop()\n579:             except asyncio.CancelledError:\n580:                 pass\n581: \n582:         # Backoff should increase: 1, 2, 4, 8, 16\n583:         assert len(backoffs) >= 4\n584:         assert backoffs[0] == 1.0\n585:         assert backoffs[1] == 2.0\n586:         assert backoffs[2] == 4.0\n587:         assert backoffs[3] == 8.0\n588: \n589:     @pytest.mark.asyncio\n590:     async def test_reconnect_backoff_caps_at_30(self):\n591:         call_count = 0\n592:         backoffs = []\n593: \n594:         async def mock_sleep(duration):\n595:             nonlocal call_count\n596:             backoffs.append(duration)\n597:             call_count += 1\n598:             if call_count >= 8:\n599:                 raise asyncio.CancelledError()\n600: \n601:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n602:              patch(\"server_client.websockets\") as mock_ws, \\\n603:              patch(\"asyncio.sleep\", side_effect=mock_sleep):\n604:             mock_ws.connect = AsyncMock(side_effect=ConnectionRefusedError(\"refused\"))\n605: \n606:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n607:             try:\n608:                 await sc.reconnect_loop()\n609:             except asyncio.CancelledError:\n610:                 pass\n611: \n612:         # After enough failures, backoff should cap at 30\n613:         assert any(b == 30.0 for b in backoffs), f\"expected 30.0 cap in {backoffs}\"\n614: \n615:     @pytest.mark.asyncio\n616:     async def test_reconnect_resets_backoff_on_success(self):\n617:         call_count = 0\n618: \n619:         async def mock_sleep(duration):\n620:             nonlocal call_count\n621:             call_count += 1\n622:             if call_count >= 2:\n623:                 raise asyncio.CancelledError()\n624: \n625:         ack = json.dumps({\"type\": \"ack\"})\n626:         fake_ws = FakeWebSocket(responses=[ack])\n627: \n628:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n629:              patch(\"server_client.websockets\") as mock_ws, \\\n630:              patch(\"asyncio.sleep\", side_effect=mock_sleep):\n631:             mock_ws.connect = AsyncMock(return_value=fake_ws)\n632: \n633:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n634:             sc._backoff = 16.0  # Simulate previous failures\n635: \n636:             try:\n637:                 await sc.reconnect_loop()\n638:             except asyncio.CancelledError:\n639:                 pass\n640: \n641:         # After successful connect, backoff should reset to 1.0\n642:         assert sc._backoff <= 2.0  # 1.0 * 2 after one sleep cycle\n643: \n644: \n645: # ---------------------------------------------------------------------------\n646: # HAS_WEBSOCKETS import guard\n647: # ---------------------------------------------------------------------------\n648: \n649: class TestWebsocketsImportGuard:\n650: \n651:     def test_has_websockets_flag_exists(self):\n652:         import server_client\n653:         assert hasattr(server_client, \"HAS_WEBSOCKETS\")\n654: \n655:     @pytest.mark.asyncio\n656:     async def test_no_import_error_when_disabled(self):\n657:         \"\"\"When HAS_WEBSOCKETS is False, connect should return False without crashing.\"\"\"\n658:         with patch(\"server_client.HAS_WEBSOCKETS\", False):\n659:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n660:             assert await sc.connect() is False\n661:             assert sc.connected is False\n662: \n663: \n664: # ---------------------------------------------------------------------------\n665: # ServerConfig dataclass tests\n666: # ---------------------------------------------------------------------------\n667: \n668: class TestServerConfigDataclass:\n669: \n670:     def test_defaults(self):\n671:         sc = ServerConfig(enabled=True, url=\"ws://x\", api_key=\"k\", client_id=\"c\")\n672:         assert sc.push_interval_seconds == 10.0\n673: \n674:     def test_custom_interval(self):\n675:         sc = ServerConfig(enabled=True, url=\"ws://x\", api_key=\"k\", client_id=\"c\",\n676:                           push_interval_seconds=2.5)\n677:         assert sc.push_interval_seconds == 2.5\n678: \n679:     def test_fields(self):\n680:         sc = ServerConfig(enabled=True, url=\"ws://x\", api_key=\"k\", client_id=\"c\")\n681:         assert sc.enabled is True\n682:         assert sc.url == \"ws://x\"\n683:         assert sc.api_key == \"k\"\n684:         assert sc.client_id == \"c\"\n685: \n686: \n687: # ---------------------------------------------------------------------------\n688: # ServerClient._handle_incoming tests\n689: # ---------------------------------------------------------------------------\n690: \n691: class TestHandleIncoming:\n692: \n693:     @pytest.mark.asyncio\n694:     async def test_answer_questions_dispatches_to_callback(self):\n695:         received = {}\n696: \n697:         async def on_answers(feature_id, answers):\n698:             received[\"feature_id\"] = feature_id\n699:             received[\"answers\"] = answers\n700: \n701:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_answers_received=on_answers)\n702:         msg = json.dumps({\n703:             \"type\": \"answer_questions\",\n704:             \"feature_id\": \"feat-1\",\n705:             \"answers\": [\n706:                 {\"question\": \"What color?\", \"answer\": \"blue\"},\n707:                 {\"question\": \"What size?\", \"answer\": \"large\"},\n708:             ],\n709:         })\n710:         await sc._handle_incoming(msg)\n711: \n712:         assert received[\"feature_id\"] == \"feat-1\"\n713:         assert len(received[\"answers\"]) == 2\n714:         assert received[\"answers\"][0][\"question\"] == \"What color?\"\n715:         assert received[\"answers\"][0][\"answer\"] == \"blue\"\n716:         assert received[\"answers\"][1][\"answer\"] == \"large\"\n717: \n718:     @pytest.mark.asyncio\n719:     async def test_answer_questions_no_callback_no_crash(self):\n720:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n721:         msg = json.dumps({\n722:             \"type\": \"answer_questions\",\n723:             \"feature_id\": \"f1\",\n724:             \"answers\": [{\"question\": \"q\", \"answer\": \"a\"}],\n725:         })\n726:         # Should not raise\n727:         await sc._handle_incoming(msg)\n728: \n729:     @pytest.mark.asyncio\n730:     async def test_answer_questions_empty_feature_id_ignored(self):\n731:         called = False\n732: \n733:         async def on_answers(feature_id, answers):\n734:             nonlocal called\n735:             called = True\n736: \n737:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_answers_received=on_answers)\n738:         msg = json.dumps({\n739:             \"type\": \"answer_questions\",\n740:             \"feature_id\": \"\",\n741:             \"answers\": [{\"question\": \"q\", \"answer\": \"a\"}],\n742:         })\n743:         await sc._handle_incoming(msg)\n744:         assert called is False\n745: \n746:     @pytest.mark.asyncio\n747:     async def test_answer_questions_missing_feature_id_ignored(self):\n748:         called = False\n749: \n750:         async def on_answers(feature_id, answers):\n751:             nonlocal called\n752:             called = True\n753: \n754:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_answers_received=on_answers)\n755:         msg = json.dumps({\n756:             \"type\": \"answer_questions\",\n757:             \"answers\": [{\"question\": \"q\", \"answer\": \"a\"}],\n758:         })\n759:         await sc._handle_incoming(msg)\n760:         assert called is False\n761: \n762:     @pytest.mark.asyncio\n763:     async def test_answer_questions_empty_answers_array(self):\n764:         received = {}\n765: \n766:         async def on_answers(feature_id, answers):\n767:             received[\"answers\"] = answers\n768: \n769:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_answers_received=on_answers)\n770:         msg = json.dumps({\n771:             \"type\": \"answer_questions\",\n772:             \"feature_id\": \"f1\",\n773:             \"answers\": [],\n774:         })\n775:         await sc._handle_incoming(msg)\n776:         assert received[\"answers\"] == []\n777: \n778:     @pytest.mark.asyncio\n779:     async def test_handle_incoming_malformed_json(self):\n780:         called = False\n781: \n782:         async def on_answers(feature_id, answers):\n783:             nonlocal called\n784:             called = True\n785: \n786:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_answers_received=on_answers)\n787:         # Should not raise, should not call callback\n788:         await sc._handle_incoming(\"{not valid json\")\n789:         assert called is False\n790: \n791:     @pytest.mark.asyncio\n792:     async def test_handle_incoming_unknown_type_ignored(self):\n793:         called = False\n794: \n795:         async def on_answers(feature_id, answers):\n796:             nonlocal called\n797:             called = True\n798: \n799:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_answers_received=on_answers)\n800:         msg = json.dumps({\"type\": \"some_unknown_type\", \"data\": \"hello\"})\n801:         await sc._handle_incoming(msg)\n802:         assert called is False\n803: \n804:     @pytest.mark.asyncio\n805:     async def test_handle_incoming_callback_error_does_not_crash(self):\n806:         async def on_answers(feature_id, answers):\n807:             raise ValueError(\"handler exploded\")\n808: \n809:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_answers_received=on_answers)\n810:         msg = json.dumps({\n811:             \"type\": \"answer_questions\",\n812:             \"feature_id\": \"f1\",\n813:             \"answers\": [{\"question\": \"q\", \"answer\": \"a\"}],\n814:         })\n815:         # Should not raise even though callback raises\n816:         await sc._handle_incoming(msg)\n817: \n818:     @pytest.mark.asyncio\n819:     async def test_answer_questions_special_characters_preserved(self):\n820:         received = {}\n821: \n822:         async def on_answers(feature_id, answers):\n823:             received[\"answers\"] = answers\n824: \n825:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_answers_received=on_answers)\n826:         special = \"line1\\nline2\\ttab \\\"quotes\\\" <html> & 🎉 こんにちは\"\n827:         msg = json.dumps({\n828:             \"type\": \"answer_questions\",\n829:             \"feature_id\": \"f1\",\n830:             \"answers\": [{\"question\": \"q\", \"answer\": special}],\n831:         })\n832:         await sc._handle_incoming(msg)\n833:         assert received[\"answers\"][0][\"answer\"] == special\n834: \n835: \n836: # ---------------------------------------------------------------------------\n837: # ServerClient reconnect_loop dispatches incoming messages\n838: # ---------------------------------------------------------------------------\n839: \n840: class TestReconnectLoopDispatch:\n841: \n842:     @pytest.mark.asyncio\n843:     async def test_reconnect_loop_dispatches_answer_questions(self):\n844:         \"\"\"When connected, incoming answer_questions messages are dispatched.\"\"\"\n845:         received = {}\n846: \n847:         async def on_answers(feature_id, answers):\n848:             received[\"feature_id\"] = feature_id\n849:             received[\"answers\"] = answers\n850: \n851:         ack = json.dumps({\"type\": \"ack\"})\n852:         answer_msg = json.dumps({\n853:             \"type\": \"answer_questions\",\n854:             \"feature_id\": \"f1\",\n855:             \"answers\": [{\"question\": \"q\", \"answer\": \"a\"}],\n856:         })\n857:         fake_ws = FakeWebSocket(responses=[ack, answer_msg])\n858: \n859:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n860:              patch(\"server_client.websockets\") as mock_ws:\n861:             mock_ws.connect = AsyncMock(return_value=fake_ws)\n862: \n863:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\",\n864:                               on_answers_received=on_answers)\n865:             task = asyncio.create_task(sc.reconnect_loop())\n866:             await asyncio.sleep(0.2)\n867:             task.cancel()\n868:             try:\n869:                 await task\n870:             except asyncio.CancelledError:\n871:                 pass\n872: \n873:         assert received.get(\"feature_id\") == \"f1\"\n874:         assert len(received.get(\"answers\", [])) == 1\n875: \n876: \n877: # ---------------------------------------------------------------------------\n878: # ServerClient.push_state includes questions field\n879: # ---------------------------------------------------------------------------\n880: \n881: class TestPushStateQuestions:\n882: \n883:     @pytest.mark.asyncio\n884:     async def test_push_state_includes_questions(self):\n885:         fake_ws = FakeWebSocket()\n886:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n887:         sc._ws = fake_ws\n888:         sc._connected = True\n889: \n890:         feature = _make_feature(\"F1\", \"requested-input\", \"board1\", \"2025-01-01\", \"f1\")\n891:         feature.questions = [\n892:             {\"question\": \"What color?\", \"answer\": \"\"},\n893:             {\"question\": \"What size?\", \"answer\": \"large\"},\n894:         ]\n895:         await sc.push_state([feature])\n896: \n897:         payload = json.loads(fake_ws._sent[0])\n898:         qs = payload[\"features\"][0][\"questions\"]\n899:         assert len(qs) == 2\n900:         assert qs[0][\"question\"] == \"What color?\"\n901:         assert qs[0][\"answer\"] == \"\"\n902:         assert qs[1][\"answer\"] == \"large\"\n903: \n904:     @pytest.mark.asyncio\n905:     async def test_push_state_empty_questions(self):\n906:         fake_ws = FakeWebSocket()\n907:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n908:         sc._ws = fake_ws\n909:         sc._connected = True\n910: \n911:         feature = _make_feature(\"F1\", \"ideas\", \"board1\", \"2025-01-01\", \"f1\")\n912:         feature.questions = []\n913:         await sc.push_state([feature])\n914: \n915:         payload = json.loads(fake_ws._sent[0])\n916:         assert payload[\"features\"][0][\"questions\"] == []\n917: \n918:     @pytest.mark.asyncio\n919:     async def test_push_state_includes_history(self):\n920:         fake_ws = FakeWebSocket()\n921:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n922:         sc._ws = fake_ws\n923:         sc._connected = True\n924: \n925:         feature = _make_feature(\"F1\", \"plan-inbox\", \"board1\", \"2025-01-01\", \"f1\")\n926:         feature._data[\"history\"] = [\n927:             {\"ts\": \"2025-01-01T00:00:00Z\", \"stage\": \"PLAN-INBOX\", \"note\": \"Questions answered via web UI\"},\n928:         ]\n929:         await sc.push_state([feature])\n930: \n931:         payload = json.loads(fake_ws._sent[0])\n932:         hist = payload[\"features\"][0][\"history\"]\n933:         assert len(hist) == 1\n934:         assert hist[0][\"note\"] == \"Questions answered via web UI\"\n935: \n936: \n937: # ---------------------------------------------------------------------------\n938: # ServerClient on_answers_received callback wiring\n939: # ---------------------------------------------------------------------------\n940: \n941: class TestServerClientCallbackWiring:\n942: \n943:     def test_callback_stored_on_init(self):\n944:         async def cb(fid, ans):\n945:             pass\n946: \n947:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_answers_received=cb)\n948:         assert sc._on_answers_received is cb\n949: \n950:     def test_callback_default_none(self):\n951:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n952:         assert sc._on_answers_received is None\n953: \n954: \n955: # ---------------------------------------------------------------------------\n956: # STAGE_ACTIONS config tests\n957: # ---------------------------------------------------------------------------\n958: \n959: class TestStageActions:\n960: \n961:     def test_stage_actions_exists(self):\n962:         from state import STAGE_ACTIONS\n963:         assert isinstance(STAGE_ACTIONS, dict)\n964:         assert \"plan\" in STAGE_ACTIONS\n965:         assert \"implement\" in STAGE_ACTIONS\n966: \n967:     def test_stage_actions_plan_stages(self):\n968:         from state import STAGE_ACTIONS\n969:         assert STAGE_ACTIONS[\"plan\"] == [\"plan-inbox\", \"reviewing-plan\", \"requested-input\", \"approved\"]\n970: \n971:     def test_stage_actions_implement_stages(self):\n972:         from state import STAGE_ACTIONS\n973:         assert STAGE_ACTIONS[\"implement\"] == [\"approved\", \"spec-writing\"]\n974: \n975:     def test_approved_in_both_actions(self):\n976:         \"\"\"approved stage should allow both plan and implement.\"\"\"\n977:         from state import STAGE_ACTIONS\n978:         assert \"approved\" in STAGE_ACTIONS[\"plan\"]\n979:         assert \"approved\" in STAGE_ACTIONS[\"implement\"]\n980: \n981:     def test_server_client_imports_stage_actions(self):\n982:         import server_client\n983:         assert hasattr(server_client, \"STAGE_ACTIONS\")\n984: \n985: \n986: # ---------------------------------------------------------------------------\n987: # push_state available_actions tests\n988: # ---------------------------------------------------------------------------\n989: \n990: class TestPushStateAvailableActions:\n991: \n992:     @pytest.mark.asyncio\n993:     async def test_feature_in_plan_inbox_has_plan_action(self):\n994:         fake_ws = FakeWebSocket()\n995:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n996:         sc._ws = fake_ws\n997:         sc._connected = True\n998: \n999:         feature = _make_feature(\"F1\", \"plan-inbox\", \"board1\", \"2025-01-01\", \"f1\")\n1000:         await sc.push_state([feature])\n1001: \n1002:         payload = json.loads(fake_ws._sent[0])\n1003:         assert \"plan\" in payload[\"features\"][0][\"available_actions\"]\n1004: \n1005:     @pytest.mark.asyncio\n1006:     async def test_feature_in_approved_has_both_actions(self):\n1007:         fake_ws = FakeWebSocket()\n1008:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1009:         sc._ws = fake_ws\n1010:         sc._connected = True\n1011: \n1012:         feature = _make_feature(\"F1\", \"approved\", \"board1\", \"2025-01-01\", \"f1\")\n1013:         await sc.push_state([feature])\n1014: \n1015:         payload = json.loads(fake_ws._sent[0])\n1016:         actions = payload[\"features\"][0][\"available_actions\"]\n1017:         assert \"plan\" in actions\n1018:         assert \"implement\" in actions\n1019: \n1020:     @pytest.mark.asyncio\n1021:     async def test_feature_in_done_has_no_actions(self):\n1022:         fake_ws = FakeWebSocket()\n1023:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1024:         sc._ws = fake_ws\n1025:         sc._connected = True\n1026: \n1027:         feature = _make_feature(\"F1\", \"done\", \"board1\", \"2025-01-01\", \"f1\")\n1028:         await sc.push_state([feature])\n1029: \n1030:         payload = json.loads(fake_ws._sent[0])\n1031:         assert payload[\"features\"][0][\"available_actions\"] == []\n1032: \n1033:     @pytest.mark.asyncio\n1034:     async def test_feature_in_ideas_has_no_actions(self):\n1035:         fake_ws = FakeWebSocket()\n1036:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1037:         sc._ws = fake_ws\n1038:         sc._connected = True\n1039: \n1040:         feature = _make_feature(\"F1\", \"ideas\", \"board1\", \"2025-01-01\", \"f1\")\n1041:         await sc.push_state([feature])\n1042: \n1043:         payload = json.loads(fake_ws._sent[0])\n1044:         assert payload[\"features\"][0][\"available_actions\"] == []\n1045: \n1046:     @pytest.mark.asyncio\n1047:     async def test_feature_in_spec_writing_has_implement_only(self):\n1048:         fake_ws = FakeWebSocket()\n1049:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1050:         sc._ws = fake_ws\n1051:         sc._connected = True\n1052: \n1053:         feature = _make_feature(\"F1\", \"spec-writing\", \"board1\", \"2025-01-01\", \"f1\")\n1054:         await sc.push_state([feature])\n1055: \n1056:         payload = json.loads(fake_ws._sent[0])\n1057:         actions = payload[\"features\"][0][\"available_actions\"]\n1058:         assert \"implement\" in actions\n1059:         assert \"plan\" not in actions\n1060: \n1061:     @pytest.mark.asyncio\n1062:     async def test_plan_agent_running_excludes_plan_action(self):\n1063:         fake_ws = FakeWebSocket()\n1064:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1065:         sc._ws = fake_ws\n1066:         sc._connected = True\n1067: \n1068:         plan_status = SimpleNamespace(running=True, phase=\"planning\", feature_slug=\"f1\", agent=\"claude\")\n1069:         feature = _make_feature(\"F1\", \"plan-inbox\", \"board1\", \"2025-01-01\", \"f1\")\n1070:         await sc.push_state([feature], plan_status=plan_status)\n1071: \n1072:         payload = json.loads(fake_ws._sent[0])\n1073:         assert \"plan\" not in payload[\"features\"][0][\"available_actions\"]\n1074: \n1075:     @pytest.mark.asyncio\n1076:     async def test_impl_agent_running_excludes_implement_action(self):\n1077:         fake_ws = FakeWebSocket()\n1078:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1079:         sc._ws = fake_ws\n1080:         sc._connected = True\n1081: \n1082:         impl_status = SimpleNamespace(running=True, phase=\"implementing\", feature_slug=\"f1\", agent=\"claude\")\n1083:         feature = _make_feature(\"F1\", \"approved\", \"board1\", \"2025-01-01\", \"f1\")\n1084:         await sc.push_state([feature], impl_status=impl_status)\n1085: \n1086:         payload = json.loads(fake_ws._sent[0])\n1087:         actions = payload[\"features\"][0][\"available_actions\"]\n1088:         assert \"plan\" in actions\n1089:         assert \"implement\" not in actions\n1090: \n1091:     @pytest.mark.asyncio\n1092:     async def test_both_agents_running_no_actions(self):\n1093:         fake_ws = FakeWebSocket()\n1094:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1095:         sc._ws = fake_ws\n1096:         sc._connected = True\n1097: \n1098:         plan_status = SimpleNamespace(running=True, phase=\"planning\", feature_slug=\"f1\", agent=\"claude\")\n1099:         impl_status = SimpleNamespace(running=True, phase=\"implementing\", feature_slug=\"f2\", agent=\"claude\")\n1100:         feature = _make_feature(\"F1\", \"approved\", \"board1\", \"2025-01-01\", \"f1\")\n1101:         await sc.push_state([feature], plan_status=plan_status, impl_status=impl_status)\n1102: \n1103:         payload = json.loads(fake_ws._sent[0])\n1104:         assert payload[\"features\"][0][\"available_actions\"] == []\n1105: \n1106:     @pytest.mark.asyncio\n1107:     async def test_agent_not_running_does_not_exclude(self):\n1108:         fake_ws = FakeWebSocket()\n1109:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1110:         sc._ws = fake_ws\n1111:         sc._connected = True\n1112: \n1113:         plan_status = SimpleNamespace(running=False, phase=\"\", feature_slug=\"\", agent=\"\")\n1114:         feature = _make_feature(\"F1\", \"plan-inbox\", \"board1\", \"2025-01-01\", \"f1\")\n1115:         await sc.push_state([feature], plan_status=plan_status)\n1116: \n1117:         payload = json.loads(fake_ws._sent[0])\n1118:         assert \"plan\" in payload[\"features\"][0][\"available_actions\"]\n1119: \n1120:     @pytest.mark.asyncio\n1121:     async def test_multiple_features_different_actions(self):\n1122:         fake_ws = FakeWebSocket()\n1123:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1124:         sc._ws = fake_ws\n1125:         sc._connected = True\n1126: \n1127:         f1 = _make_feature(\"F1\", \"plan-inbox\", \"b\", \"2025-01-01\", \"f1\")\n1128:         f2 = _make_feature(\"F2\", \"spec-writing\", \"b\", \"2025-01-01\", \"f2\")\n1129:         f3 = _make_feature(\"F3\", \"done\", \"b\", \"2025-01-01\", \"f3\")\n1130:         await sc.push_state([f1, f2, f3])\n1131: \n1132:         payload = json.loads(fake_ws._sent[0])\n1133:         assert \"plan\" in payload[\"features\"][0][\"available_actions\"]\n1134:         assert \"implement\" in payload[\"features\"][1][\"available_actions\"]\n1135:         assert payload[\"features\"][2][\"available_actions\"] == []\n1136: \n1137: \n1138: # ---------------------------------------------------------------------------\n1139: # push_state stage_actions field tests\n1140: # ---------------------------------------------------------------------------\n1141: \n1142: class TestPushStateStageActions:\n1143: \n1144:     @pytest.mark.asyncio\n1145:     async def test_push_state_includes_stage_actions(self):\n1146:         fake_ws = FakeWebSocket()\n1147:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1148:         sc._ws = fake_ws\n1149:         sc._connected = True\n1150: \n1151:         await sc.push_state([_make_feature()])\n1152: \n1153:         payload = json.loads(fake_ws._sent[0])\n1154:         assert \"stage_actions\" in payload\n1155:         from state import STAGE_ACTIONS\n1156:         assert payload[\"stage_actions\"] == STAGE_ACTIONS\n1157: \n1158:     @pytest.mark.asyncio\n1159:     async def test_push_state_includes_agent_dicts(self):\n1160:         fake_ws = FakeWebSocket()\n1161:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1162:         sc._ws = fake_ws\n1163:         sc._connected = True\n1164: \n1165:         plan_status = SimpleNamespace(running=True, phase=\"planning\", feature_slug=\"my-feat\", agent=\"claude\")\n1166:         await sc.push_state([_make_feature()], plan_status=plan_status)\n1167: \n1168:         payload = json.loads(fake_ws._sent[0])\n1169:         assert payload[\"plan_agent\"][\"running\"] is True\n1170:         assert payload[\"plan_agent\"][\"feature\"] == \"my-feat\"\n1171:         assert payload[\"impl_agent\"][\"running\"] is False\n1172: \n1173:     @pytest.mark.asyncio\n1174:     async def test_push_state_none_agents_default_dict(self):\n1175:         fake_ws = FakeWebSocket()\n1176:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1177:         sc._ws = fake_ws\n1178:         sc._connected = True\n1179: \n1180:         await sc.push_state([_make_feature()])\n1181: \n1182:         payload = json.loads(fake_ws._sent[0])\n1183:         assert payload[\"plan_agent\"] == {\"running\": False, \"phase\": \"\", \"feature\": \"\", \"agent\": \"\"}\n1184:         assert payload[\"impl_agent\"] == {\"running\": False, \"phase\": \"\", \"feature\": \"\", \"agent\": \"\"}\n1185: \n1186:     @pytest.mark.asyncio\n1187:     async def test_push_state_includes_auto_mode_flags(self):\n1188:         fake_ws = FakeWebSocket()\n1189:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1190:         sc._ws = fake_ws\n1191:         sc._connected = True\n1192: \n1193:         await sc.push_state([_make_feature()], auto_plan_enabled=True, auto_impl_enabled=False)\n1194: \n1195:         payload = json.loads(fake_ws._sent[0])\n1196:         assert payload[\"auto_plan\"] is True\n1197:         assert payload[\"auto_impl\"] is False\n1198: \n1199: \n1200: # ---------------------------------------------------------------------------\n1201: # _handle_incoming start_agent tests\n1202: # ---------------------------------------------------------------------------\n1203: \n1204: class TestHandleIncomingStartAgent:\n1205: \n1206:     @pytest.mark.asyncio\n1207:     async def test_start_agent_plan_dispatches_callback(self):\n1208:         received = {}\n1209: \n1210:         def on_start(feature_id, action):\n1211:             received[\"feature_id\"] = feature_id\n1212:             received[\"action\"] = action\n1213: \n1214:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_start_agent=on_start)\n1215:         msg = json.dumps({\n1216:             \"type\": \"start_agent\",\n1217:             \"feature_id\": \"abc123\",\n1218:             \"action\": \"plan\",\n1219:         })\n1220:         await sc._handle_incoming(msg)\n1221: \n1222:         assert received[\"feature_id\"] == \"abc123\"\n1223:         assert received[\"action\"] == \"plan\"\n1224: \n1225:     @pytest.mark.asyncio\n1226:     async def test_start_agent_implement_dispatches_callback(self):\n1227:         received = {}\n1228: \n1229:         def on_start(feature_id, action):\n1230:             received[\"feature_id\"] = feature_id\n1231:             received[\"action\"] = action\n1232: \n1233:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_start_agent=on_start)\n1234:         msg = json.dumps({\n1235:             \"type\": \"start_agent\",\n1236:             \"feature_id\": \"xyz789\",\n1237:             \"action\": \"implement\",\n1238:         })\n1239:         await sc._handle_incoming(msg)\n1240: \n1241:         assert received[\"feature_id\"] == \"xyz789\"\n1242:         assert received[\"action\"] == \"implement\"\n1243: \n1244:     @pytest.mark.asyncio\n1245:     async def test_start_agent_no_callback_no_crash(self):\n1246:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1247:         msg = json.dumps({\n1248:             \"type\": \"start_agent\",\n1249:             \"feature_id\": \"f1\",\n1250:             \"action\": \"plan\",\n1251:         })\n1252:         # Should not raise\n1253:         await sc._handle_incoming(msg)\n1254: \n1255:     @pytest.mark.asyncio\n1256:     async def test_start_agent_unknown_action_ignored(self):\n1257:         called = False\n1258: \n1259:         def on_start(feature_id, action):\n1260:             nonlocal called\n1261:             called = True\n1262: \n1263:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_start_agent=on_start)\n1264:         msg = json.dumps({\n1265:             \"type\": \"start_agent\",\n1266:             \"feature_id\": \"f1\",\n1267:             \"action\": \"migrate\",\n1268:         })\n1269:         await sc._handle_incoming(msg)\n1270:         assert called is False\n1271: \n1272:     @pytest.mark.asyncio\n1273:     async def test_start_agent_empty_feature_id_ignored(self):\n1274:         called = False\n1275: \n1276:         def on_start(feature_id, action):\n1277:             nonlocal called\n1278:             called = True\n1279: \n1280:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_start_agent=on_start)\n1281:         msg = json.dumps({\n1282:             \"type\": \"start_agent\",\n1283:             \"feature_id\": \"\",\n1284:             \"action\": \"plan\",\n1285:         })\n1286:         await sc._handle_incoming(msg)\n1287:         assert called is False\n1288: \n1289:     @pytest.mark.asyncio\n1290:     async def test_start_agent_missing_fields_ignored(self):\n1291:         called = False\n1292: \n1293:         def on_start(feature_id, action):\n1294:             nonlocal called\n1295:             called = True\n1296: \n1297:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_start_agent=on_start)\n1298:         msg = json.dumps({\"type\": \"start_agent\"})\n1299:         await sc._handle_incoming(msg)\n1300:         assert called is False\n1301: \n1302:     @pytest.mark.asyncio\n1303:     async def test_start_agent_null_fields_ignored(self):\n1304:         called = False\n1305: \n1306:         def on_start(feature_id, action):\n1307:             nonlocal called\n1308:             called = True\n1309: \n1310:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_start_agent=on_start)\n1311:         msg = json.dumps({\n1312:             \"type\": \"start_agent\",\n1313:             \"feature_id\": None,\n1314:             \"action\": None,\n1315:         })\n1316:         await sc._handle_incoming(msg)\n1317:         assert called is False\n1318: \n1319:     @pytest.mark.asyncio\n1320:     async def test_start_agent_callback_error_does_not_crash(self):\n1321:         def on_start(feature_id, action):\n1322:             raise ValueError(\"handler exploded\")\n1323: \n1324:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_start_agent=on_start)\n1325:         msg = json.dumps({\n1326:             \"type\": \"start_agent\",\n1327:             \"feature_id\": \"f1\",\n1328:             \"action\": \"plan\",\n1329:         })\n1330:         # Should not raise even though callback raises\n1331:         await sc._handle_incoming(msg)\n1332: \n1333:     @pytest.mark.asyncio\n1334:     async def test_start_agent_callback_called_exactly_once(self):\n1335:         call_count = 0\n1336: \n1337:         def on_start(feature_id, action):\n1338:             nonlocal call_count\n1339:             call_count += 1\n1340: \n1341:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_start_agent=on_start)\n1342:         msg = json.dumps({\n1343:             \"type\": \"start_agent\",\n1344:             \"feature_id\": \"f1\",\n1345:             \"action\": \"plan\",\n1346:         })\n1347:         await sc._handle_incoming(msg)\n1348:         assert call_count == 1\n1349: \n1350: \n1351: # ---------------------------------------------------------------------------\n1352: # on_start_agent callback wiring tests\n1353: # ---------------------------------------------------------------------------\n1354: \n1355: class TestStartAgentCallbackWiring:\n1356: \n1357:     def test_on_start_agent_stored_on_init(self):\n1358:         def cb(fid, action):\n1359:             pass\n1360: \n1361:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_start_agent=cb)\n1362:         assert sc._on_start_agent is cb\n1363: \n1364:     def test_on_start_agent_default_none(self):\n1365:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n1366:         assert sc._on_start_agent is None\n1367: \n1368: \n1369: # ---------------------------------------------------------------------------\n1370: # reconnect_loop dispatches start_agent messages\n1371: # ---------------------------------------------------------------------------\n1372: \n1373: class TestReconnectLoopStartAgent:\n1374: \n1375:     @pytest.mark.asyncio\n1376:     async def test_reconnect_loop_dispatches_start_agent(self):\n1377:         received = {}\n1378: \n1379:         def on_start(feature_id, action):\n1380:             received[\"feature_id\"] = feature_id\n1381:             received[\"action\"] = action\n1382: \n1383:         ack = json.dumps({\"type\": \"ack\"})\n1384:         start_msg = json.dumps({\n1385:             \"type\": \"start_agent\",\n1386:             \"feature_id\": \"f1\",\n1387:             \"action\": \"implement\",\n1388:         })\n1389:         fake_ws = FakeWebSocket(responses=[ack, start_msg])\n1390: \n1391:         with patch(\"server_client.HAS_WEBSOCKETS\", True), \\\n1392:              patch(\"server_client.websockets\") as mock_ws:\n1393:             mock_ws.connect = AsyncMock(return_value=fake_ws)\n1394: \n1395:             sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\",\n1396:                               on_start_agent=on_start)\n1397:             task = asyncio.create_task(sc.reconnect_loop())\n1398:             await asyncio.sleep(0.2)\n1399:             task.cancel()\n1400:             try:\n1401:                 await task\n1402:             except asyncio.CancelledError:\n1403:                 pass\n1404: \n1405:         assert received.get(\"feature_id\") == \"f1\"\n1406:         assert received.get(\"action\") == \"implement\"\n\n(End of file - total 1406 lines)\n</content>","title":"pipeline/test_server_client.py","metadata":{"preview":"\"\"\"Tests for server client/config integration (server_client.py + config.py server bits).\n\nRun with:\n    pytest test_server_client.py -v\n\"\"\"\n\nimport asyncio\nimport json\nimport logging\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nimport pytest\n\nsys.path.insert(0, str(Path(__file__).parent))\n\nfrom config import Config, ServerConfig","truncated":false,"loaded":[]},"time":{"start":1772832564937,"end":1772832564942}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I need to examine the existing test patterns in the project. Let me look at the ex