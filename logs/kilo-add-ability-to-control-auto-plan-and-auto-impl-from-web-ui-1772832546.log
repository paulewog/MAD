{"type":"tool_use","timestamp":1772832730324,"sessionID":"ses_33af21c17ffeSjD9lLu1QoQ8dY","part":{"id":"prt_cc5101b93001C6xxwK5OxcgXcL","sessionID":"ses_33af21c17ffeSjD9lLu1QoQ8dY","messageID":"msg_cc5100c50001YbLX05ggeTlYR4","type":"tool","callID":"call_function_mf73p2al9cxj_1","tool":"write","state":{"status":"completed","input":{"content":"\"\"\"Tests for TUI auto-mode handling - callback and state management.\n\nCovers:\n1. TUI callback toggles auto-mode state correctly\n2. push_state passes auto-mode state to server\n3. Edge cases for state management\n\"\"\"\n\nimport asyncio\nimport json\nimport unittest\nfrom unittest.mock import AsyncMock, MagicMock, patch, PropertyMock\n\nimport sys, os\nsys.path.insert(0, os.path.dirname(os.path.dirname(__file__)))\n\nfrom types import SimpleNamespace\n\n\nclass MockFeature:\n    \"\"\"Mock FeatureFile for testing.\"\"\"\n    \n    def __init__(self, fid=\"f1\", stage=\"ideas\", board=\"default\"):\n        self.id = fid\n        self.title = f\"Feature {fid}\"\n        self.current_stage = stage\n        self.board = board\n        self.created = \"2025-01-01\"\n        self.description = \"\"\n        self.questions = []\n        self._data = {\"pipeline_log\": [], \"history\": []}\n    \n    @staticmethod\n    def find(fid):\n        return None\n    \n    def add_history(self, stage, note):\n        self._data[\"history\"].append({\"ts\": \"2025-01-01T00:00:00Z\", \"stage\": stage, \"note\": note})\n\n\nclass TestTUIHandleSetAutoMode(unittest.IsolatedAsyncioTestCase):\n    \"\"\"Test 1.4: TUI callback toggles auto-mode state.\n    \n    Verify that the _handle_set_auto_mode() callback correctly updates\n    self.auto_plan_enabled and self.auto_implement_enabled.\n    \"\"\"\n    \n    def _create_mock_tui(self):\n        \"\"\"Create a mock TUI with necessary attributes.\"\"\"\n        with patch('tui.MADTui.__init__', return_value=None):\n            from tui import MADTui\n            tui = object.__new__(MADTui)\n            tui._server_client = None\n            tui.active_board = \"default\"\n            tui._plan_running = False\n            tui._implement_running = False\n            tui.auto_plan_enabled = False\n            tui.auto_implement_enabled = False\n            tui._current_features = []\n            return tui\n    \n    def test_handle_set_auto_mode_plan_true(self):\n        \"\"\"Verify callback sets auto_plan_enabled=True for mode='plan'.\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = False\n        tui.auto_implement_enabled = False\n        \n        with patch.object(tui, '_update_status_bar'):\n            with patch.object(tui, '_load_features', return_value=[]):\n                with patch.object(tui, '_push_to_server'):\n                    tui._handle_set_auto_mode(\"plan\", True)\n        \n        self.assertTrue(tui.auto_plan_enabled)\n        self.assertFalse(tui.auto_implement_enabled)\n\n    def test_handle_set_auto_mode_plan_false(self):\n        \"\"\"Verify callback sets auto_plan_enabled=False for mode='plan'.\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = True\n        tui.auto_implement_enabled = False\n        \n        with patch.object(tui, '_update_status_bar'):\n            with patch.object(tui, '_load_features', return_value=[]):\n                with patch.object(tui, '_push_to_server'):\n                    tui._handle_set_auto_mode(\"plan\", False)\n        \n        self.assertFalse(tui.auto_plan_enabled)\n        self.assertFalse(tui.auto_implement_enabled)\n\n    def test_handle_set_auto_mode_impl_true(self):\n        \"\"\"Verify callback sets auto_implement_enabled=True for mode='impl'.\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = False\n        tui.auto_implement_enabled = False\n        \n        with patch.object(tui, '_update_status_bar'):\n            with patch.object(tui, '_load_features', return_value=[]):\n                with patch.object(tui, '_push_to_server'):\n                    tui._handle_set_auto_mode(\"impl\", True)\n        \n        self.assertFalse(tui.auto_plan_enabled)\n        self.assertTrue(tui.auto_implement_enabled)\n\n    def test_handle_set_auto_mode_impl_false(self):\n        \"\"\"Verify callback sets auto_implement_enabled=False for mode='impl'.\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = False\n        tui.auto_implement_enabled = True\n        \n        with patch.object(tui, '_update_status_bar'):\n            with patch.object(tui, '_load_features', return_value=[]):\n                with patch.object(tui, '_push_to_server'):\n                    tui._handle_set_auto_mode(\"impl\", False)\n        \n        self.assertFalse(tui.auto_plan_enabled)\n        self.assertFalse(tui.auto_implement_enabled)\n\n    def test_handle_set_auto_mode_unknown_mode_ignored(self):\n        \"\"\"Verify unknown mode is ignored (no state change).\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = True\n        tui.auto_implement_enabled = True\n        \n        with patch.object(tui, '_update_status_bar'):\n            with patch.object(tui, '_load_features', return_value=[]):\n                with patch.object(tui, '_push_to_server'):\n                    tui._handle_set_auto_mode(\"unknown\", True)\n        \n        self.assertTrue(tui.auto_plan_enabled)\n        self.assertTrue(tui.auto_implement_enabled)\n\n    def test_handle_set_auto_mode_triggers_state_push(self):\n        \"\"\"Verify callback triggers state push to server after toggle.\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = False\n        \n        push_mock = AsyncMock()\n        tui._server_client = MagicMock()\n        tui._server_client.connected = True\n        \n        with patch.object(tui, '_update_status_bar'):\n            with patch.object(tui, '_load_features', return_value=[]):\n                with patch.object(tui, '_push_to_server', push_mock):\n                    tui._handle_set_auto_mode(\"plan\", True)\n        \n        push_mock.assert_called_once()\n\n\nclass TestTUIPushStateIncludesAutoMode(unittest.IsolatedAsyncioTestCase):\n    \"\"\"Test 1.2: TUI passes auto-mode state to push_state().\n    \n    Verify that every call to push_state() includes the current \n    auto_plan_enabled and auto_implement_enabled values.\n    \"\"\"\n    \n    def _create_mock_tui(self):\n        \"\"\"Create a mock TUI with necessary attributes.\"\"\"\n        with patch('tui.MADTui.__init__', return_value=None):\n            from tui import MADTui\n            tui = object.__new__(MADTui)\n            tui._server_client = MagicMock()\n            tui._server_client.connected = True\n            tui._server_client.push_state = AsyncMock()\n            tui.active_board = \"default\"\n            tui._plan_running = False\n            tui._implement_running = False\n            tui._current_features = []\n            return tui\n    \n    async def test_push_state_passes_auto_plan_enabled_true(self):\n        \"\"\"Verify push_state called with auto_plan_enabled=True.\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = True\n        tui.auto_implement_enabled = False\n        \n        features = [MockFeature()]\n        await tui._push_to_server(features)\n        \n        call_kwargs = tui._server_client.push_state.call_args\n        self.assertTrue(call_kwargs.kwargs.get('auto_plan_enabled'))\n        self.assertFalse(call_kwargs.kwargs.get('auto_impl_enabled'))\n\n    async def test_push_state_passes_auto_impl_enabled_true(self):\n        \"\"\"Verify push_state called with auto_impl_enabled=True.\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = False\n        tui.auto_implement_enabled = True\n        \n        features = [MockFeature()]\n        await tui._push_to_server(features)\n        \n        call_kwargs = tui._server_client.push_state.call_args\n        self.assertFalse(call_kwargs.kwargs.get('auto_plan_enabled'))\n        self.assertTrue(call_kwargs.kwargs.get('auto_impl_enabled'))\n\n    async def test_push_state_passes_both_enabled(self):\n        \"\"\"Verify push_state called with both auto modes enabled.\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = True\n        tui.auto_implement_enabled = True\n        \n        features = [MockFeature()]\n        await tui._push_to_server(features)\n        \n        call_kwargs = tui._server_client.push_state.call_args\n        self.assertTrue(call_kwargs.kwargs.get('auto_plan_enabled'))\n        self.assertTrue(call_kwargs.kwargs.get('auto_impl_enabled'))\n\n    async def test_push_state_passes_both_disabled(self):\n        \"\"\"Verify push_state called with both auto modes disabled.\"\"\"\n        tui = self._create_mock_tui()\n        tui.auto_plan_enabled = False\n        tui.auto_implement_enabled = False\n        \n        features = [MockFeature()]\n        await tui._push_to_server(features)\n        \n        call_kwargs = tui._server_client.push_state.call_args\n        self.assertFalse(call_kwargs.kwargs.get('auto_plan_enabled'))\n        self.assertFalse(call_kwargs.kwargs.get('auto_impl_enabled'))\n\n\nclass TestTUIAutoModeCallbacks(unittest.IsolatedAsyncioTestCase):\n    \"\"\"Test that TUI wires up the on_set_auto_mode callback correctly.\"\"\"\n    \n    def test_tui_passes_callback_to_server_client(self):\n        \"\"\"Verify TUI provides on_set_auto_mode callback to ServerClient.\"\"\"\n        with patch('tui.MADTui.__init__', return_value=None):\n            with patch('tui.MADTui._connect_server'):\n                with patch('tui.MADTui.set_interval'):\n                    from tui import MADTui\n                    \n                    tui = object.__new__(MADTui)\n                    tui._server_client = None\n                    \n                    mock_config = SimpleNamespace(\n                        enabled=True,\n                        url=\"ws://localhost:8080\",\n                        api_key=\"test-key\",\n                        client_id=\"test-client\"\n                    )\n                    \n                    with patch('tui.ServerClient') as MockServerClient:\n                        mock_instance = MagicMock()\n                        MockServerClient.return_value = mock_instance\n                        \n                        tui._server_client = None\n                        tui._start_server_client(mock_config)\n                        \n                        call_kwargs = MockServerClient.call_args.kwargs\n                        self.assertIn('on_set_auto_mode', call_kwargs)\n                        self.assertEqual(call_kwargs['on_set_auto_mode'], tui._handle_set_auto_mode)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","filePath":"/home/paule/MAD/pipeline/test_tui_auto_mode.py"},"output":"Wrote file successfully.\n\nLSP errors detected in other files:\n<diagnostics file=\"/home/paule/MAD/pipeline/test_auto_mode.py\">\nERROR [27:38] \"send\" is not a known attribute of \"None\"\nERROR [27:43] Cannot access attribute \"call_args\" for class \"MethodType\"\n  Attribute \"call_args\" is unknown\nERROR [34:38] \"send\" is not a known attribute of \"None\"\nERROR [34:43] Cannot access attribute \"call_args\" for class \"MethodType\"\n  Attribute \"call_args\" is unknown\nERROR [41:38] \"send\" is not a known attribute of \"None\"\nERROR [41:43] Cannot access attribute \"call_args\" for class \"MethodType\"\n  Attribute \"call_args\" is unknown\n</diagnostics>\n\nLSP errors detected in other files:\n<diagnostics file=\"/home/paule/MAD/pipeline/test_server_client.py\">\nERROR [152:19] \"push_interval_seconds\" is not a known attribute of \"None\"\nERROR [359:12] Cannot assign to attribute \"_ws\" for class \"ServerClient\"\n  Expression of type \"FakeWebSocket\" cannot be assigned 