fer resp.Body.Close()\n\n\tif resp.StatusCode != http.StatusNotFound {\n\t\tt.Errorf(\"status = %d, want 404\", resp.StatusCode)\n\t}\n}\n\nfunc TestAutoModeEndpoint_ClientDisconnected(t *testing.T) {\n\thub, ts := startTestServerT(t, testConfig(\"test-key\"))\n\tdefer ts.Close()\n\n\tconn := wsConnect(t, ts, \"test-key\", \"client-1\")\n\tdefer conn.Close()\n\n\tif !waitForClient(hub, \"client-1\", time.Second) {\n\t\tt.Fatal(\"client not registered\")\n\t}\n\n\tconn.Close()\n\ttime.Sleep(50 * time.Millisecond)\n\n\tbody := bytes.NewBufferString(`{\"mode\": \"plan\", \"enabled\": true}`)\n\treq, _ := http.NewRequest(\"POST\", ts.URL+\"/api/clients/client-1/auto-mode\", body)\n\treq.Header.Set(\"Authorization\", \"Bearer test-key\")\n\tresp, err := http.DefaultClient.Do(req)\n\tif err != nil {\n\t\tt.Fatalf(\"request failed: %v\", err)\n\t}\n\tdefer resp.Body.Close()\n\n\tif resp.StatusCode != http.StatusUnprocessableEntity {\n\t\tt.Errorf(\"status = %d, want 422\", resp.StatusCode)\n\t}\n}\n\nfunc TestAutoModeEndpoint_MissingAuth(t *testing.T) {\n\t_, ts := startTestServerT(t, testConfig(\"test-key\"))\n\tdefer ts.Close()\n\n\tbody := bytes.NewBufferString(`{\"mode\": \"plan\", \"enabled\": true}`)\n\treq, _ := http.NewRequest(\"POST\", ts.URL+\"/api/clients/client-1/auto-mode\", body)\n\tresp, err := http.DefaultClient.Do(req)\n\tif err != nil {\n\t\tt.Fatalf(\"request failed: %v\", err)\n\t}\n\tdefer resp.Body.Close()\n\n\tif resp.StatusCode != http.StatusUnauthorized {\n\t\tt.Errorf(\"status = %d, want 401\", resp.StatusCode)\n\t}\n}\n\nfunc TestAutoModeEndpoint_InvalidAuth(t *testing.T) {\n\t_, ts := startTestServerT(t, testConfig(\"test-key\"))\n\tdefer ts.Close()\n\n\tbody := bytes.NewBufferString(`{\"mode\": \"plan\", \"enabled\": true}`)\n\treq, _ := http.NewRequest(\"POST\", ts.URL+\"/api/clients/client-1/auto-mode\", body)\n\treq.Header.Set(\"Authorization\", \"Bearer wrong-key\")\n\tresp, err := http.DefaultClient.Do(req)\n\tif err != nil {\n\t\tt.Fatalf