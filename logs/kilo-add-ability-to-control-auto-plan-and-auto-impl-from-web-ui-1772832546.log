g.T) {\n\thub, ts := startTestServerT(t, testConfig(\"test-key\"))\n\tdefer ts.Close()\n\n\tconn := wsConnect(t, ts, \"test-key\", \"client-1\")\n\tdefer conn.Close()\n\n\tif !waitForClient(hub, \"client-1\", time.Second) {\n\t\tt.Fatal(\"client not registered\")\n\t}\n\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 10; i++ {\n\t\twg.Add(1)\n\t\tgo func(i int) {\n\t\t\tdefer wg.Done()\n\t\t\tbody := bytes.NewBufferString(`{\"mode\": \"plan\", \"enabled\": true}`)\n\t\t\treq, _ := http.NewRequest(\"POST\", ts.URL+\"/api/clients/client-1/auto-mode\", body)\n\t\t\treq.Header.Set(\"Authorization\", \"Bearer test-key\")\n\t\t\thttp.DefaultClient.Do(req)\n\t\t}(i)\n\t}\n\twg.Wait()\n\n\tcount := 0\n\tfor {\n\t\tvar msg struct {\n\t\t\tType string `json:\"type\"`\n\t\t}\n\t\terr := conn.SetReadDeadline(time.Now().Add(100 * time.Millisecond))\n\t\tif err != nil {\n\t\t\tbreak\n\t\t}\n\t\tif err := conn.ReadJSON(&msg); err != nil {\n\t\t\tbreak\n\t\t}\n\t\tif msg.Type == \"set_auto_mode\" {\n\t\t\tcount++\n\t\t}\n\t}\n\n\tif count != 10 {\n\t\tt.Errorf(\"received %d messages, want 10\", count)\n\t}\n}\n\nfunc TestAutoModeEndpoint_PollingStateIncludesAutoMode(t *testing.T) {\n\thub, ts := startTestServerT(t, testConfig(\"test-key\"))\n\tdefer ts.Close()\n\n\tconn := wsConnect(t, ts, \"test-key\", \"client-1\")\n\tdefer conn.Close()\n\n\tif !waitForClient(hub, \"client-1\", time.Second) {\n\t\tt.Fatal(\"client not registered\")\n\t}\n\n\tstateMsg := map[string]interface{}{\n\t\t\"type\":       \"state_update\",\n\t\t\"client_id\":  \"client-1\",\n\t\t\"auto_plan\":  true,\n\t\t\"auto_impl\":  false,\n\t\t\"features\":   []interface{}{},\n\t}\n\tif err := conn.WriteJSON(stateMsg); err != nil {\n\t\tt.Fatalf(\"failed to send state: %v\", err)\n\t}\n\n\ttime.Sleep(50 * time.Millisecond)\n\n\tresp := apiGet(t, ts, \"/api/clients/client-1?key=test-key\", \"test-key\")\n\tdefer resp.Body.Close()\n\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Fatalf(\"status = %d, want 200\", resp.StatusCode)\n\t}\n\n\tvar clientState map[string]interface{}\n\tif err := json.NewDecoder(resp.Body).Decode(&clientState); err != nil {\n\t\tt.Fatalf(\"decode failed: %v\", err)\n\t}\n\n\tautoPlan, ok := clientState[\"auto_plan\"].(bool)\n\tif !ok || !autoPlan {\n\t\tt.Errorf(\"auto_plan = %v, want true\", clientState[\"auto_plan\"])\n\t}\n\n\tautoImpl, ok := clientState[\"auto_impl\"].(bool)\n\tif !ok || autoImpl {\n\t\tt.Errorf(\"auto_impl = %v, want false\", clientState[\"auto_impl\"])\n\t}\n}\n\nfunc TestAutoModeEndpoint_PollingStateAutoModeDefault(t *testing.T) {\n\thub, ts := startTestServerT(t, testConfig(\"test-key\"))\n\tdefer ts.Close()\n\n\tconn := wsConnect(t, ts, \"test-key\", \"client-1\")\n\tdefer conn.Close()\n\n\tif !waitForClient(hub, \"client-1\", time.Second) {\n\t\tt.Fatal(\"client not registered\")\n\t}\n\n\tstateMsg := map[string]interface{}{\n\t\t\"type\":\",\n\t\t\"      \"state_updateclient_id\": \"client-1\",\n\t\t\"features\":  []interface{}{},\n\t}\n\tif err := conn.WriteJSON(stateMsg); err != nil {\n\t\tt.Fatalf(\"failed to send state: %v\", err)\n\t}\n\n\ttime.Sleep(50 * time.Millisecond)\n\n\tresp := apiGet(t, ts, \"/api/clients/client-1?key=test-key\", \"test-key\")\n\tdefer resp.Body.Close()\n\n\tvar clientState map[string]interface{}\n\tif err := json.NewDecoder(resp.Body).Decode(&clientState); err != nil {\n\t\tt.Fatalf(\"decode failed: %v\", err)\n\t}\n\n\tif clientState[\"auto_plan\"] != nil {\n\t\tt.Errorf(\"auto_plan should be absent/nil, got %v\", clientState[\"auto_plan\"])\n\t}\n\tif clientState[\"auto_impl\"] != nil {\n\t\tt.Errorf(\"auto_impl should be absent/nil, got %v\", clientState[\"auto_impl\"])\n\t}\n}\n","filePath":"/home/paule/MAD/server/api_auto_mode_test.go"},"output":"Wrote file successfully.\n\nLSP errors detected in other files:\n<diagnostics file=\"/home/paule/MAD/pipeline/test_auto_mode.py\">\nERROR [27:38] \"send\" is not a known attribute of \"None\"\nERROR [27:43] Cannot access attribute \"call_args\" for