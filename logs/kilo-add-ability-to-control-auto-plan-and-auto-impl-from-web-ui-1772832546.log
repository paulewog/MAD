")\n\tif !ok {\n\t\tt.Fatal(\"client not found\")\n\t}\n\n\tif !clientState.AutoPlan {\n\t\tt.Error(\"AutoPlan should be true\")\n\t}\n\tif clientState.AutoImpl {\n\t\tt.Error(\"AutoImpl should be false\")\n\t}\n}\n\nfunc TestHubStateUpdateAutoModeBothTrue(t *testing.T) {\n\tcfg := testConfig(\"test-key\")\n\thub := NewHub(cfg)\n\tgo hub.Run()\n\tdefer func() {\n\t\thub.unregister <- &Client{clientID: \"test-client-2\"}\n\t\ttime.Sleep(50 * time.Millisecond)\n\t}()\n\n\t_, ts := startTestServer(cfg)\n\tdefer ts.Close()\n\n\tconn, _, err := websocket.DefaultDialer.Dial(\"ws\"+ts.URL[4:]+\"/ws?api_key=test-key\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"dial failed: %v\", err)\n\t}\n\tdefer conn.Close()\n\n\treg := map[string]string{\n\t\t\"type\":      \"register\",\n\t\t\"client_id\": \"test-client-2\",\n\t\t\"api_key\":   \"test-key\",\n\t}\n\tconn.WriteJSON(reg)\n\tconn.ReadJSON(&resp)\n\n\tstateMsg := map[string]interface{}{\n\t\t\"type\":       \"state_update\",\n\t\t\"client_id\":  \"test-client-2\",\n\t\t\"auto_plan\":  true,\n\t\t\"auto_impl\":  true,\n\t\t\"features\":   []interface{}{},\n\t}\n\tconn.WriteJSON(stateMsg)\n\n\ttime.Sleep(50 * time.Millisecond)\n\n\tclientState, _ := hub.GetClient(\"test-client-2\")\n\tif !clientState.AutoPlan || !clientState.AutoImpl {\n\t\tt.Error(\"both AutoPlan and AutoImpl should be true\")\n\t}\n}\n\nfunc TestHubStateUpdateAutoModeMissingFields(t *testing.T) {\n\tcfg := testConfig(\"test-key\")\n\thub := NewHub(cfg)\n\tgo hub.Run()\n\tdefer func() {\n\t\thub.unregister <- &Client{clientID: \"test-client-3\"}\n\t\ttime.Sleep(50 * time.Millisecond)\n\t}()\n\n\t_, ts := startTestServer(cfg)\n\tdefer ts.Close()\n\n\tconn, _, err := websocket.DefaultDialer.Dial(\"ws\"+ts.URL[4:]+\"/ws?api_key=test-key\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"dial failed: %v\", err)\n\t}\n\tdefer conn.Close()\n\n\treg := map[string]string{\n\t\t\"type\":      \"register\",\n\t\t\"client_id\": \"test-client-3\",\n\t\t\"api_key\":   \"test-key\",\n\t}\n\tconn.WriteJSON(reg)\n\tconn.ReadJSON(&resp)\n\n\tstateMsg := map[string]interface{}{\n\t\t\"type\":       \"state_update\",\n\t\t\"client_id\":  \"test-client-3\",\n\t\t\"features\":   []interface{}{},\n\t}\n\tconn.WriteJSON(stateMsg)\n\n\ttime.Sleep(50 * time.Millisecond)\n\n\tclientState, _ := hub.GetClient(\"test-client-3\")\n\tif clientState.AutoPlan || clientState.AutoImpl {\n\t\tt.Error(\"AutoPlan and AutoImpl should remain false when not in message\")\n\t}\n}\n\nfunc TestHubStateUpdateAutoModeInvalidBool(t *testing.T) {\n\tcfg := testConfig(\"test-key\")\n\thub := NewHub(cfg)\n\tgo hub.Run()\n\tdefer func() {\n\t\thub.unregister <- &Client{clientID: \"test-client-4\"}\n\t\ttime.Sleep(50 * time.Millisecond)\n\t}()\n\n\t_, ts := startTestServer(cfg)\n\tdefer ts.Close()\n\n\tconn, _, err := websocket.DefaultDialer.Dial(\"ws\"+ts.URL[4:]+\"/ws?api_key=test-key\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"dial failed: %v\", err)\n\t}\n\tdefer conn.Close()\n\n\treg := map[string]string{\n\t\t\"type\":      \"register\",\n\t\t\"client_id\": \"test-client-4\",\n\t\t\"api_key\":   \"test-key\",\n\t}\n\tconn.WriteJSON(reg)\n\tconn.ReadJSON(&resp)\n\n\tstateMsg := map[string]interface{}{\n\t\t\"type\":       \"state_update\",\n\t\t\"client_id\":  \"test-client-4\",\n\t\t\"auto_plan\":  \"true\",\n\t\t\"features\":    []interface{}{},\n\t}\n\tconn.WriteJSON(stateMsg)\n\n\ttime.Sleep(50 * time.Millisecond)\n\n\tclientState, _ := hub.GetClient(\"test-client-4\")\n\tif clientState.AutoPlan {\n\t\tt.Error(\"AutoPlan should remain false when invalid type provided\")\n\t}\n}\n\nfunc TestHubStateUpdateAutoModeJsonError(t *testing.T) {\n\tcfg := testConfig(\"test-key\")\n\thub := NewHub(cfg)\n\tgo hub.Run()\n\tdefer func() {\n\t\thub.unregister <- &Client{clientID: \"test-client-5\"}\n\t\ttime.Sleep(50 * time.Millisecond)\n\t}()\n\n\t_, ts := startTestServer(cfg)\n\tdefer ts.Close()\n\n\tconn, _, err := websocket.DefaultDialer.Dial(\"ws\"+ts.URL[4:]+\"/ws?api_key=test-key\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"dial failed: %v\", err)\n\t}\n\tdefer conn.Close()\n\n\treg := map[string]string{\n\t\t\"type\":      \"register\",\n\t\t\"client_id\": \"test-client-5\",\n\t\t\"api_key\":   \"test-key\",\n\t}\n\tconn.WriteJSON(reg)\n\tconn.ReadJSON(&resp)\n\n\tconn.WriteMessage(websocket.TextMessage, []byte(\"not valid json\"))\n\n\ttime.Sleep(50 * time.Millisecond)\n\n\tclientState, _ := hub.GetClient(\"test-client-5\")\n\tif clientState.AutoPlan || clientState.AutoImpl {\n\t\tt.Error(\"state should remain unchanged after malformed message\")\n\t}\n}\n\nfunc TestHubSendToClientAutoModeMessage(t *testing.T) {\n\tcfg := testConfig(\"test-key\")\n\thub := NewHub(cfg)\n\tgo hub.Run()\n\tdefer func() {\n\t\thub.unregister <- &Client{clientID: \"test-client-6\"}\n\t\ttime.Sleep(50 * time.Millisecond)\n\t}()\n\n\t_, ts := startTestServer(cfg)\n\tdefer ts.Close()\n\n\tconn, _, err := websocket.DefaultDialer.Dial(\"ws\"+ts.URL[4:]+\"/ws?api_key=test-key\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"dial failed: %v\", err)\n\t}\n\tdefer conn.Close()\n\n\treg := map[string]string{\n\t\t\"type\":      \"register\",\n\t\t\"client_id\": \"test-client-6\",\n\t\t\"api_key\":   \"test-key\",\n\t}\n\tconn.WriteJSON(reg)\n\tconn.ReadJSON(&resp)\n\n\tautoModeMsg, _ := json.Marshal(map[string]interface{}{\n\t\t\"type\":    \"set_auto_mode\",\n\t\t\"mode\":    \"plan\",\n\t\t\"enabled\": true,\n\t})\n\tif err := hub.SendToClient(\"test-client-6\", autoModeMsg); err != nil {\n\t\tt.Fatalf(\"send to client failed: %v\", err)\n\t}\n\n\tvar msg map[string]interface{}\n\tif err := conn.ReadJSON(&msg); err != nil {\n\t\tt.Fatalf(\"read message failed: %v\", err)\n\t}\n\n\tif msg[\"type\"] != \"set_auto_mode\" {\n\t\tt.Errorf(\"msg.Type = %v, want set_auto_mode\", msg[\"type\"])\n\t}\n\tif msg[\"mode\"] != \"plan\" {\n\t\tt.Errorf(\"msg.Mode = %v, want plan\", msg[\"mode\"])\n\t}\n\tif msg[\"enabled\"] != true {\n\t\tt.Errorf(\"msg.Enabled = %v, want true\", msg[\"enabled\"])\n\t}\n}\n\nfunc TestHubSendToClientDisconnected(t *testing.T) {\n\tcfg := testConfig(\"test-key\")\n\thub := NewHub(cfg)\n\tgo hub.Run()\n\n\tautoModeMsg, _ := json.Marshal(map[string]interface{}{\n\t\t\"type\":    \"set_auto_mode\",\n\t\t\"mode\":    \"plan\",\n\t\t\"enabled\": true,\n\t})\n\terr := hub.SendToClient(\"nonexistent\", autoModeMsg)\n\tif err == nil {\n\t\tt.Error(\"expected error when sending to nonexistent client\")\n\t}\n}\n","filePath":"/home/paule/MAD/server/hub_auto_mode_test.go"},"output":"Wrote file successfully.\n\nLSP errors detected in other files:\n<diagnostics file=\"/home/paule/MAD/pipeline/test_auto_mode.py\">\nERROR [27:38] \"send\" is not a known attribute of \"None\"\nERROR [27:43] Cannot access attribute \"call_args\" for class \"MethodType\"\n  Attribute \"call_args\" is unknown\nERROR [34:38] \"send\" is not a known attribute of \"None\"\nERROR [34:43] Cannot access attribute \"call_args\" for class \"MethodType\"\n  Attribute \"call_args\" is unknown\nERROR [41:38] \"send\" is not a known attribute of \"None\"\nERROR [41:43] Cannot access attribute \"call_args\" for class \"MethodType\"\n  Attribute \"call_args\" is unknown\n</diagnostics>\n\nLSP errors detected in other files:\n<diagnostics file=\"/home/paule/MAD/pipeline/test_server_client.py\">\nERROR [152:19] \"push_interval_seconds\" is not a known attribute of \"None\"\nERROR [359:12] Cannot assign to attribute \"_ws\" for class \"ServerClient\"\n  Expression of type \"FakeWebSocket\" cannot be assigned to attribute \"_ws\" of class \"ServerClient\"\n    Type \"FakeWebSocket\" is not assignable to type \"ClientConnection | None\"\n      \"FakeWebSocket\" is not assignable to \"None\"\n      \"FakeWebSocket\" is not assignable to \"ClientConnection\"\nERROR [389:12] Cannot assign to attribute \"_ws\" for class \"ServerClient\"\n  Expression of type \"FakeWebSocket\" cannot be assigned to attribute \"_ws\" of class \"ServerClient\"\n    Type \"FakeWebSocket\" is not 