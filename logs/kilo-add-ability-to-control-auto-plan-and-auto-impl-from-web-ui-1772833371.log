{"type":"tool_use","timestamp":1772833382204,"sessionID":"ses_33ae5868bffebKMG7yTxNi7a0E","part":{"id":"prt_cc51a9c40001RxpfE0yYmGURY2","sessionID":"ses_33ae5868bffebKMG7yTxNi7a0E","messageID":"msg_cc51a91e8001k2YMF125jpG6Gc","type":"tool","callID":"call_function_24ixr3mdmcc9_1","tool":"read","state":{"status":"completed","input":{"filePath":"/home/paule/MAD/pipeline/server_client.py"},"output":"<path>/home/paule/MAD/pipeline/server_client.py</path>\n<type>file</type>\n<content>1: \"\"\"WebSocket client for pushing pipeline state to the MAD monitoring server.\"\"\"\n2: \n3: import asyncio\n4: import json\n5: import logging\n6: from datetime import datetime, timezone\n7: from typing import Callable, List, Optional\n8: \n9: try:\n10:     import websockets\n11:     from websockets.exceptions import ConnectionClosed\n12:     HAS_WEBSOCKETS = True\n13: except ImportError:\n14:     HAS_WEBSOCKETS = False\n15: \n16: from state import STAGE_ACTIONS\n17: \n18: logger = logging.getLogger(__name__)\n19: \n20: \n21: class ServerClient:\n22:     \"\"\"Async WebSocket client that pushes feature state to the MAD server.\"\"\"\n23: \n24:     def __init__(self, url: str, api_key: str, client_id: str, on_connect=None,\n25:                  on_answers_received=None,\n26:                  on_set_auto_mode: Optional[Callable[[str, bool], None]] = None,\n27:                  on_start_agent: Optional[Callable[[str, str], None]] = None,\n28:                  on_idea_created: Optional[Callable[[str, str, str], None]] = None):\n29:         self._url = url\n30:         self._api_key = api_key\n31:         self._client_id = client_id\n32:         self._ws = None\n33:         self._connected = False\n34:         self._backoff = 1.0\n35:         self._max_backoff = 30.0\n36:         self._on_connect = on_connect\n37:         self._on_answers_received = on_answers_received\n38:         self._on_set_auto_mode = on_set_auto_mode\n39:         self._on_start_agent = on_start_agent\n40:         self._on_idea_created = on_idea_created\n41: \n42:     @property\n43:     def connected(self) -> bool:\n44:         return self._connected\n45: \n46:     async def connect(self) -> bool:\n47:         \"\"\"Connect to the server and register.\"\"\"\n48:         if not HAS_WEBSOCKETS:\n49:             return False\n50:         try:\n51:             # Build WebSocket URL with ws endpoint\n52:             ws_url = self._url.rstrip(\"/\") + \"/ws\"\n53:             self._ws = await websockets.connect(\n54:                 ws_url,\n55:                 additional_headers={\"Authorization\": f\"Bearer {self._api_key}\"},\n56:                 max_size=10 * 1024 * 1024,  # 10MB\n57:             )\n58:             # Send register message\n59:             await self._ws.send(json.dumps({\n60:                 \"type\": \"register\",\n61:                 \"client_id\": self._client_id,\n62:                 \"api_key\": self._api_key,\n63:             }))\n64:             # Wait for ack\n65:             response = await asyncio.wait_for(self._ws.recv(), timeout=5.0)\n66:             data = json.loads(response)\n67:             if data.get(\"type\") == \"ack\":\n68:                 self._connected = True\n69:                 self._backoff = 1.0  # Reset backoff on success\n70:                 logger.info(f\"Connected to server as '{self._client_id}'\")\n71:                 return True\n72:             else:\n73:                 logger.warning(f\"Server rejected registration: {data}\")\n74:                 await self._ws.close()\n75:                 self._ws = None\n76:                 return False\n77:         except Exception as e:\n78:             logger.warning(f\"Failed to connect to server: {e}\")\n79:             self._connected = False\n80:             if self._ws:\n81:                 try:\n82:                     await self._ws.close()\n83:                 except Exception:\n84:                     pass\n85:                 self._ws = None\n86:             return False\n87: \n88:     async def push_state(self, features: list, plan_status=None, impl_status=None,\n89:                          auto_plan_enabled: bool = False, auto_impl_enabled: bool = False) -> None:\n90:         \"\"\"Push current feature state to the server.\n91: \n92:         Args:\n93:             features: List of FeatureFile objects\n94:             plan_status: Optional AgentStatus for the plan agent\n95:             impl_status: Optional AgentStatus for the implement agent\n96:             auto_plan_enabled: Whether auto-plan mode is enabled\n97:             auto_impl_enabled: Whether auto-impl mode is enabled\n98:         \"\"\"\n99:         if not self._connected or not self._ws:\n100:             return\n101:         try:\n102:             feature_summaries = []\n103:             log_entries = []\n104:             for f in features:\n105:                 available = []\n106:                 for action, allowed_stages in STAGE_ACTIONS.items():\n107:                     if f.current_stage in allowed_stages:\n108:                         if action == \"plan\" and plan_status and plan_status.running:\n109:                             continue\n110:                         if action == \"implement\" and impl_status and impl_status.running:\n111:                             continue\n112:                         available.append(action)\n113:                 feature_summaries.append({\n114:                     \"title\": f.title,\n115:                     \"stage\": f.current_stage,\n116:                     \"board\": f.board,\n117:                     \"created\": f.created,\n118:                     \"id\": f.id,\n119:                     \"description\": f.description[:1000] if f.description else \"\",\n120:                     \"history\": f._data.get(\"history\", []),\n121:                     \"questions\": f.questions,\n122:                     \"available_actions\": available,\n123:                 })\n124:                 # Collect log entries from the feature\n125:                 raw_logs = f._data.get(\"pipeline_log\", [])\n126:                 for entry in raw_logs[-10:]:  # Only send last 10 per feature\n127:                     log_entries.append({\n128:                         \"timestamp\": entry.get(\"ts\", \"\"),\n129:                         \"phase\": entry.get(\"phase\", \"\"),\n130:                         \"output\": entry.get(\"output\", \"\")[:500],  # Truncate long outputs\n131:                         \"client_id\": self._client_id,\n132:                     })\n133: \n134:             msg = {\n135:                 \"type\": \"state_update\",\n136:                 \"client_id\": self._client_id,\n137:                 \"timestamp\": datetime.now(timezone.utc).isoformat(),\n138:                 \"features\": feature_summaries,\n139:                 \"logs\": log_entries,\n140:             }\n141: \n142:             def _agent_dict(status):\n143:                 if status is None:\n144:                     return {\"running\": False, \"phase\": \"\", \"feature\": \"\", \"agent\": \"\"}\n145:                 return {\n146:                     \"running\": status.running,\n147:                     \"phase\": status.phase,\n148:                     \"feature\": status.feature_slug,\n149:                     \"agent\": status.agent,\n150:                 }\n151: \n152:             msg[\"stage_actions\"] = STAGE_ACTIONS\n153:             msg[\"plan_agent\"] = _agent_dict(plan_status)\n154:             msg[\"impl_agent\"] = _agent_dict(impl_status)\n155:             msg[\"auto_plan\"] = auto_plan_enabled\n156:             msg[\"auto_impl\"] = auto_impl_enabled\n157: \n158:             message = json.dumps(msg)\n159:             await self._ws.send(message)\n160:         except Exception as e:\n161:             logger.warning(f\"Failed to push state: {e}\")\n162:             self._connected = False\n163: \n164:     async def disconnect(self) -> None:\n165:         \"\"\"Send disconnect message and close the WebSocket.\"\"\"\n166:         if self._ws:\n167:             try:\n168:                 if self._connected:\n169:                     await self._ws.send(json.dumps({\n170:                         \"type\": \"disconnect\",\n171:                         \"client_id\": self._client_id,\n172:                     }))\n173:                 await self._ws.close()\n174:             except Exception:\n175:                 pass\n176:             finally:\n177:                 self._ws = None\n178:                 self._connected = False\n179: \n180:     async def _handle_incoming(self, raw: str) -> None:\n181:         \"\"\"Dispatch an incoming server message by type.\"\"\"\n182:         try:\n183:             data = json.loads(raw)\n184:         except json.JSONDecodeError:\n185:             logger.warning(\"Received non-JSON message from server\")\n186:             return\n187:         msg_type = data.get(\"type\")\n188:         if msg_type == \"answer_questions\":\n189:             feature_id = data.get(\"feature_id\", \"\")\n190:             answers = data.get(\"answers\", [])\n191:             if self._on_answers_received and feature_id:\n192:                 try:\n193:                     await self._on_answers_received(feature_id, answers)\n194:                 except Exception as e:\n195:                     logger.warning(f\"Error handling answer_questions: {e}\")\n196:         elif msg_type == \"set_auto_mode\":\n197:             mode = data.get(\"mode\")\n198:             enabled = data.get(\"enabled\")\n199:             if mode in (\"plan\", \"impl\") and isinstance(enabled, bool):\n200:                 if self._on_set_auto_mode:\n201:                     try:\n202:                         self._on_set_auto_mode(mode, enabled)\n203:                     except Exception as e:\n204:                         logger.warning(f\"Error handling set_auto_mode: {e}\")\n205:         elif msg_type == \"start_agent\":\n206:             feature_id = data.get(\"feature_id\", \"\")\n207:             action = data.get(\"action\", \"\")\n208:             if self._on_start_agent and feature_id and action in (\"plan\", \"implement\"):\n209:                 try:\n210:                     self._on_start_agent(feature_id, action)\n211:                 except Exception as e:\n212:                     logger.warning(f\"Error handling start_agent: {e}\")\n213:         elif msg_type == \"create_idea\":\n214:             title = data.get(\"title\", \"\")\n215:             board = data.get(\"board\", \"\")\n216:             description = data.get(\"description\", \"\")\n217:             if self._on_idea_created and title and board:\n218:                 try:\n219:                     self._on_idea_created(title, board, description)\n220:                 except Exception as e:\n221:                     logger.warning(f\"Error handling create_idea: {e}\")\n222:         # Other message types silently ignored\n223: \n224:     async def reconnect_loop(self) -> None:\n225:         \"\"\"Continuously attempt to connect and stay connected.\n226: \n227:         This runs forever as a background task. On disconnect,\n228:         retries with exponential backoff (1s -> 2s -> 4s -> ... -> 30s cap).\n229:         \"\"\"\n230:         if not HAS_WEBSOCKETS:\n231:             logger.warning(\"websockets not installed, server push disabled\")\n232:             return\n233: \n234:         while True:\n235:             try:\n236:                 connected = await self.connect()\n237:                 if connected:\n238:                     if self._on_connect:\n239:                         await self._on_connect()\n240:                     # Stay connected, dispatch incoming server messages\n241:                     try:\n242:                         async for message in self._ws:\n243:                             await self._handle_incoming(message)\n244:                     except Exception:\n245:                         pass\n246:                     # Connection dropped\n247:                     self._connected = False\n248:                     self._ws = None\n249:                     logger.info(\"Server connection lost, will reconnect...\")\n250:                     self._backoff = 1.0  # Reset on clean disconnect\n251: \n252:                 # Wait before reconnecting\n253:                 await asyncio.sleep(self._backoff)\n254:                 self._backoff = min(self._backoff * 2, self._max_backoff)\n255:             except asyncio.CancelledError:\n256:                 # Clean shutdown\n257:                 await self.disconnect()\n258:                 return\n259:             except Exception as e:\n260:                 logger.warning(f\"Reconnect error: {e}\")\n261:                 await asyncio.sleep(self._backoff)\n262:                 self._backoff = min(self._backoff * 2, self._max_backoff)\n\n(End of file - total 262 lines)\n</content>","title":"pipeline/server_client.py","metadata":{"preview":"\"\"\"WebSocket client for pushing pipeline state to the MAD monitoring server.\"\"\"\n\nimport asyncio\nimport json\nimport logging\nfrom datetime import datetime, timezone\nfrom typing import Callable, List, Optional\n\ntry:\n    import websockets\n    from websockets.exceptions import ConnectionClosed\n    HAS_WEBSOCKETS = True\nexcept ImportError:\n    HAS_WEBSOCKETS = False\n\nfrom state import STAGE_ACTIONS\n\nlogger = logging.getLogger(__name__)\n\n","truncated":false,"loaded":[]},"time":{"start":1772833382163,"end":1772833382203}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"All files exist. Let me read them to understand the existing patterns.","format":"anthropic-claude-v1","index":0,"signature":"c7a72a6651ff2fc1a1ad3711cd63eefc7bc527be77e08d0da982ccaeb2bf10f3"}]}}}}
{"type":"tool_use","timestamp":1772833382219,"sessionID":"ses_33ae5868bffebKMG7yTxNi7a0E","part":{"id":"prt_cc51a9f3e001K9w1jk0HdP1DOo","sessionID":"ses_33ae5868bffebKMG7yTxNi7a0E","messageID":"msg_cc51a91e8001k2YMF125jpG6Gc","type":"tool","callID":"call_function_24ixr3mdmcc9_2","tool":"read","state":{"status":"completed","input":{"filePath":"/home/paule/MAD/pipeline/tui.py"},"output":"<path>/home/paule/MAD/pipeline/tui.py</path>\n<type>file</type>\n<content>1: #!/usr/bin/env python3\n2: \"\"\"MAD Pipeline TUI — interactive kanban dashboard built with Textual.\"\"\"\n3: \n4: import asyncio\n5: import atexit\n6: import logging\n7: import os\n8: import signal\n9: import sys\n10: import time\n11: from pathlib import Path\n12: from typing import Optional\n13: \n14: logger = logging.getLogger(__name__)\n15: \n16: # Ensure pipeline modules are importable when running tui.py directly\n17: sys.path.insert(0, str(Path(__file__).parent))\n18: \n19: from agent_status import AgentStatus\n20: from config import Config\n21: from phases import run_pipeline, _load_prompt, update_design_doc, _get_latest_feedback\n22: from runner import AgentRunner, RateLimitError\n23: from state import STAGES, STAGE_ACTIONS, FeatureFile\n24: \n25: from textual import work\n26: from textual.app import App, ComposeResult\n27: from textual.binding import Binding\n28: from textual.containers import Horizontal, Vertical, VerticalScroll, Grid\n29: from textual.css.query import NoMatches\n30: from textual.message import Message\n31: from textual.reactive import reactive\n32: from textual.screen import ModalScreen\n33: from textual.widgets import (\n34:     Button,\n35:     Checkbox,\n36:     Header,\n37:     Input,\n38:     Label,\n39:     Log,\n40:     Markdown,\n41:     Select,\n42:     Static,\n43:     TabbedContent,\n44:     TabPane,\n45: )\n46: \n47: # Optional server push\n48: try:\n49:     from server_client import ServerClient, HAS_WEBSOCKETS\n50: except ImportError:\n51:     HAS_WEBSOCKETS = False\n52:     ServerClient = None\n53: \n54: # Pipeline phases that can have different agents assigned\n55: PIPELINE_PHASES = [\n56:     (\"planning\", \"Planning\"),\n57:     (\"reviewing_plan\", \"Plan Review\"),\n58:     (\"spec_writing\", \"Spec Writing\"),\n59:     (\"implementing\", \"Implementing\"),\n60:     (\"fix_feedback\", \"Fix Feedback\"),\n61:     (\"testing\", \"Testing\"),\n62:     (\"review\", \"Review\"),\n63: ]\n64: \n65: # Stages that require human attention — highlighted differently\n66: HUMAN_STAGES = {\"final-human-approval\"}\n67: \n68: # Display order: ideas first, then pipeline flow, then archived\n69: STAGE_DISPLAY_ORDER = [\n70:     \"ideas\",\n71:     \"plan-inbox\",\n72:     \"requested-input\",\n73:     \"reviewing-plan\",\n74:     \"approved\",\n75:     \"spec-writing\",\n76:     \"implementing\",\n77:     \"testing\",\n78:     \"review\",\n79:     \"final-human-approval\",\n80:     \"done\",\n81:     \"rejected\",\n82: ]\n83: \n84: \n85: def _feature_markdown(feature: FeatureFile) -> str:\n86:     \"\"\"Build a Markdown string showing all sections of a feature file.\"\"\"\n87:     header = f\"**Board:** {feature.board} | **Stage:** {feature.current_stage} | **ID:** {feature.id}\"\n88:     if feature.design_ref:\n89:         header += f\" | **Design:** {feature.design_ref}\"\n90:     \n91:     lines = [\n92:         f\"# {feature.title}\",\n93:         \"\",\n94:         header,\n95:         \"\",\n96:     ]\n97: \n98:     description = feature.get_section(\"Description\")\n99:     if description:\n100:         lines += [\"## Description\", \"\", description, \"\"]\n101: \n102:     if feature.plan:\n103:         lines += [\"## Plan\", \"\", feature.plan, \"\"]\n104: \n105:     if feature.impl_spec:\n106:         lines += [\"## Implementation Spec\", \"\", feature.impl_spec, \"\"]\n107: \n108:     if feature.test_spec:\n109:         lines += [\"## Test Spec\", \"\", feature.test_spec, \"\"]\n110: \n111:     if feature.impl_notes:\n112:         lines += [\"## Implementation Notes\", \"\", feature.impl_notes, \"\"]\n113: \n114:     # Show questions if any\n115:     questions = feature.questions\n116:     if questions:\n117:         lines += [\"## Questions for Human\", \"\"]\n118:         for i, q in enumerate(questions):\n119:             q_text = q.get(\"question\", \"\")\n120:             a_text = q.get(\"answer\", \"\")\n121:             if a_text:\n122:                 lines += [f\"- **Q{i+1}:** {q_text}\", f\"  - **A:** {a_text}\", \"\"]\n123:             else:\n124:                 lines += [f\"- **Q{i+1}:** {q_text} *(unanswered)*\", \"\"]\n125:         lines += [\"\", \"Press 'q' to answer questions\", \"\"]\n126: \n127:     if feature.history:\n128:         # Escape markdown in history to display as plain text\n129:         escaped_history = feature.history.replace(\"[\", r\"\\[\").replace(\"]\", r\"\\]\")\n130:         lines += [\"## History\", \"\", escaped_history, \"\"]\n131: \n132:     if feature.pipeline_log:\n133:         lines += [\"## Pipeline Log\", \"\", feature.pipeline_log, \"\"]\n134: \n135:     return \"\\n\".join(lines)\n136: \n137: \n138: # ---------------------------------------------------------------------------\n139: # Custom widgets for the kanban left pane\n140: # ---------------------------------------------------------------------------\n141: \n142: \n143: class StageHeader(Static):\n144:     \"\"\"Focusable stage header in the kanban list.\"\"\"\n145: \n146:     class Selected(Message):\n147:         \"\"\"Posted when this stage header is selected.\"\"\"\n148: \n149:         def __init__(self, stage: str) -> None:\n150:             self.stage = stage\n151:             super().__init__()\n152: \n153:     def __init__(self, stage: str, count: int) -> None:\n154:         self.stage = stage\n155:         self.count = count\n156:         if count > 0:\n157:             arrow = \"v\"\n158:         else:\n159:             arrow = \"-\"\n160:         label = f\" {arrow} {stage.upper()} ({count})\"\n161:         super().__init__(label)\n162:         self.can_focus = True\n163: \n164:         classes = \"stage-header\"\n165:         if count > 0:\n166:             classes += \" has-features\"\n167:         if stage in HUMAN_STAGES and count > 0:\n168:             classes += \" needs-attention\"\n169:         self.set_classes(classes)\n170: \n171:     def on_click(self) -> None:\n172:         self.post_message(self.Selected(self.stage))\n173: \n174: \n175: class FeatureItem(Static):\n176:     \"\"\"A clickable/focusable feature item in the kanban list.\"\"\"\n177: \n178:     class Selected(Message):\n179:         \"\"\"Posted when this feature item is selected.\"\"\"\n180: \n181:         def __init__(self, feature: FeatureFile) -> None:\n182:             self.feature = feature\n183:             super().__init__()\n184: \n185:     def __init__(self, feature: FeatureFile, is_selected: bool = False) -> None:\n186:         self.feature = feature\n187:         display_name = feature.slug\n188:         # Truncate long slugs for the left pane\n189:         if len(display_name) > 24:\n190:             display_name = display_name[:22] + \"..\"\n191:         indicator = \" << \" if is_selected else \"\"\n192:         super().__init__(f\"    {display_name}{indicator}\")\n193:         self.can_focus = True\n194:         classes = \"feature-item\"\n195:         if is_selected:\n196:             classes += \" --selected\"\n197:         self.set_classes(classes)\n198: \n199:     def on_click(self) -> None:\n200:         self.post_message(self.Selected(self.feature))\n201: \n202:     def on_focus(self) -> None:\n203:         self.post_message(self.Selected(self.feature))\n204: \n205: \n206: # ---------------------------------------------------------------------------\n207: # Modal dialogs\n208: # ---------------------------------------------------------------------------\n209: \n210: \n211: class RejectModal(ModalScreen[str | None]):\n212:     \"\"\"Modal to collect an optional rejection reason.\"\"\"\n213: \n214:     BINDINGS = [\n215:         Binding(\"escape\", \"cancel\", \"Cancel\"),\n216:     ]\n217: \n218:     CSS = \"\"\"\n219:     RejectModal {\n220:         align: center middle;\n221:     }\n222:     #reject-dialog {\n223:         width: 60;\n224:         height: auto;\n225:         max-height: 16;\n226:         border: thick $panel;\n227:         background: $surface;\n228:         padding: 1 2;\n229:     }\n230:     #reject-dialog Input {\n231:         margin: 1 0;\n232:     }\n233:     #reject-buttons {\n234:         margin-top: 1;\n235:         height: 3;\n236:     }\n237:     #reject-buttons Button {\n238:         margin: 0 1;\n239:     }\n240:     \"\"\"\n241: \n242:     def compose(self) -> ComposeResult:\n243:         with Vertical(id=\"reject-dialog\"):\n244:             yield Label(\"Reject feature -- optional reason:\")\n245:             yield Input(\n246:                 placeholder=\"Reason (press Enter to skip)\", id=\"reject-reason\"\n247:             )\n248:             with Horizontal(id=\"reject-buttons\"):\n249:                 yield Button(\"Reject\", variant=\"error\", id=\"reject-confirm\")\n250:                 yield Button(\"Cancel\", variant=\"default\", id=\"reject-cancel\")\n251: \n252:     def on_button_pressed(self, event: Button.Pressed) -> None:\n253:         if event.button.id == \"reject-confirm\":\n254:             reason_input = self.query_one(\"#reject-reason\", Input)\n255:             reason = reason_input.value.strip() or \"No reason given\"\n256:             self.dismiss(reason)\n257:         else:\n258:             self.dismiss(None)\n259: \n260:     def on_input_submitted(self, event: Input.Submitted) -> None:\n261:         reason = event.value.strip() or \"No reason given\"\n262:         self.dismiss(reason)\n263: \n264:     def action_cancel(self) -> None:\n265:         self.dismiss(None)\n266: \n267: \n268: class NewBoardModal(ModalScreen[str | None]):\n269:     \"\"\"Modal to create a new board.\"\"\"\n270: \n271:     BINDINGS = [Binding(\"escape\", \"cancel\", \"Cancel\")]\n272: \n273:     CSS = \"\"\"\n274:     NewBoardModal {\n275:         align: center middle;\n276:     }\n277:     #board-dialog {\n278:         width: 50;\n279:         height: auto;\n280:         border: thick $panel;\n281:         background: $surface;\n282:         padding: 1 2;\n283:     }\n284:     #board-dialog Input {\n285:         margin: 1 0;\n286:     }\n287:     #board-buttons {\n288:         margin-top: 1;\n289:         height: 3;\n290:     }\n291:     #board-buttons Button {\n292:         margin: 0 1;\n293:     }\n294:     \"\"\"\n295: \n296:     def compose(self) -> ComposeResult:\n297:         with Vertical(id=\"board-dialog\"):\n298:             yield Label(\"New Board\")\n299:             yield Label(\"Board name:\")\n300:             yield Input(placeholder=\"e.g. myproject\", id=\"board-name\")\n301:             with Horizontal(id=\"board-buttons\"):\n302:                 yield Button(\"Create\", variant=\"primary\", id=\"board-create\")\n303:                 yield Button(\"Cancel\", variant=\"default\", id=\"board-cancel\")\n304: \n305:     def on_button_pressed(self, event: Button.Pressed) -> None:\n306:         if event.button.id == \"board-create\":\n307:             self._submit()\n308:         else:\n309:             self.dismiss(None)\n310: \n311:     def on_input_submitted(self, event: Input.Submitted) -> None:\n312:         self._submit()\n313: \n314:     def _submit(self) -> None:\n315:         name = self.query_one(\"#board-name\", Input).value.strip()\n316:         if not name:\n317:             self.query_one(\"#board-name\", Input).focus()\n318:             return\n319:         self.dismiss(name)\n320: \n321:     def action_cancel(self) -> None:\n322:         self.dismiss(None)\n323: \n324: \n325: class AnswerQuestionsModal(ModalScreen[bool | None]):\n326:     \"\"\"Modal to answer questions raised by the planning agent.\"\"\"\n327: \n328:     BINDINGS = [\n329:         Binding(\"escape\", \"cancel\", \"Cancel\"),\n330:     ]\n331: \n332:     def __init__(self, feature: FeatureFile) -> None:\n333:         self.feature = feature\n334:         self.questions = [q for q in feature.questions if not q.get(\"answer\")]\n335:         self.original_indices = [i for i, q in enumerate(feature.questions) if not q.get(\"answer\")]\n336:         super().__init__()\n337: \n338:     def on_key(self, event) -> None:\n339:         \"\"\"Handle tab to move between inputs.\"\"\"\n340:         if event.key == \"tab\":\n341:             self._move_focus_next()\n342:             event.prevent_default()\n343:         elif event.key == \"shift+tab\":\n344:             self._move_focus_prev()\n345:             event.prevent_default()\n346:         elif event.key == \"escape\":\n347:             self.dismiss(None)\n348: \n349:     def _move_focus_next(self) -> None:\n350:         \"\"\"Move focus to next input.\"\"\"\n351:         from textual.widgets import Input\n352:         inputs = list(self.query(Input))\n353:         if not inputs:\n354:             return\n355:         current = self.focused\n356:         if current in inputs:\n357:             idx = inputs.index(current)  # type: ignore[arg-type]\n358:             if idx + 1 < len(inputs):\n359:                 inputs[idx + 1].focus()\n360:                 return\n361:         # First input or no focus\n362:         if inputs:\n363:             inputs[0].focus()\n364: \n365:     def _move_focus_prev(self) -> None:\n366:         \"\"\"Move focus to previous input.\"\"\"\n367:         from textual.widgets import Input\n368:         inputs = list(self.query(Input))\n369:         if not inputs:\n370:             return\n371:         current = self.focused\n372:         if current in inputs:\n373:             idx = inputs.index(current)  # type: ignore[arg-type]\n374:             if idx > 0:\n375:                 inputs[idx - 1].focus()\n376:                 return\n377:         # Last input\n378:         if inputs:\n379:             inputs[-1].focus()\n380: \n381:     CSS = \"\"\"\n382:     AnswerQuestionsModal {\n383:         align: center middle;\n384:     }\n385:     #questions-dialog {\n386:         width: 70;\n387:         height: 80%;\n388:         max-height: 80%;\n389:         border: thick $panel;\n390:         background: $surface;\n391:         padding: 1 2;\n392:     }\n393:     #questions-dialog VerticalLayout {\n394:         height: 100%;\n395:     }\n396:     #questions-dialog VerticalScroll {\n397:         height: 100%;\n398:     }\n399:     #questions-dialog Label {\n400:         width: 100%;\n401:         text-wrap: wrap;\n402:     }\n403:     #questions-dialog Input {\n404:         margin: 1 0;\n405:     }\n406:     #questions-buttons {\n407:         height: 3;\n408:         dock: bottom;\n409:     }\n410:     #questions-buttons Button {\n411:         margin: 0 1;\n412:     }\n413:     \"\"\"\n414: \n415:     def compose(self) -> ComposeResult:\n416:         with Vertical(id=\"questions-dialog\"):\n417:             with VerticalScroll(id=\"questions-content\"):\n418:                 yield Label(f\"[bold]Questions for: {self.feature.title}[/bold]\\n\")\n419:                 \n420:                 for i, q in enumerate(self.questions):\n421:                     yield Label(f\"\\nQ{i+1}: {q.get('question', '')}\", id=f\"q-{i}\")\n422:                     yield Input(\n423:                         value=q.get('answer', ''),\n424:                         id=f\"answer-{i}\",\n425:                         placeholder=\"Type your answer...\"\n426:                     )\n427:                 \n428:                 yield Label(\"\")\n429:             with Horizontal(id=\"questions-buttons\"):\n430:                 yield Button(\"Cancel\", variant=\"default\", id=\"cancel\")\n431:                 yield Button(\"Save & Continue\", variant=\"primary\", id=\"save\")\n432: \n433:     def on_button_pressed(self, event: Button.Pressed) -> None:\n434:         if event.button.id == \"cancel\":\n435:             self.dismiss(None)\n436:         elif event.button.id == \"save\":\n437:             # Save all answers using original indices\n438:             for i, orig_idx in enumerate(self.original_indices):\n439:                 input_widget = self.query_one(f\"#answer-{i}\", Input)\n440:                 self.feature.answer_question(orig_idx, input_widget.value)\n441:             \n442:             # Move back to plan-inbox to continue pipeline\n443:             self.feature.move_to_stage(\"plan-inbox\")\n444:             self.feature.save()\n445:             self.dismiss(True)\n446: \n447: \n448: class NewFeatureModal(ModalScreen[tuple[str, str, str] | None]):\n449:     \"\"\"Modal to create a new feature -- collects title, description, and board.\"\"\"\n450: \n451:     BINDINGS = [\n452:         Binding(\"escape\", \"cancel\", \"Cancel\"),\n453:     ]\n454: \n455:     def on_key(self, event) -> None:\n456:         \"\"\"Handle tab to move between inputs.\"\"\"\n457:         if event.key == \"tab\":\n458:             self._move_focus_next()\n459:             event.prevent_default()\n460:         elif event.key == \"shift+tab\":\n461:             self._move_focus_prev()\n462:             event.prevent_default()\n463: \n464:     def _move_focus_next(self) -> None:\n465:         \"\"\"Move focus to next input.\"\"\"\n466:         from textual.widgets import Input, Select\n467:         inputs = list(self.query(Input)) + list(self.query(Select))\n468:         if not inputs:\n469:             return\n470:         current = self.focused\n471:         if current in inputs:\n472:             idx = inputs.index(current)\n473:             if idx + 1 < len(inputs):\n474:                 inputs[idx + 1].focus()\n475:                 return\n476:         if inputs:\n477:             inputs[0].focus()\n478: \n479:     def _move_focus_prev(self) -> None:\n480:         \"\"\"Move focus to previous input.\"\"\"\n481:         from textual.widgets import Input, Select\n482:         inputs = list(self.query(Input)) + list(self.query(Select))\n483:         if not inputs:\n484:             return\n485:         current = self.focused\n486:         if current in inputs:\n487:             idx = inputs.index(current)\n488:             if idx > 0:\n489:                 inputs[idx - 1].focus()\n490:                 return\n491:         if inputs:\n492:             inputs[-1].focus()\n493: \n494:     CSS = \"\"\"\n495:     NewFeatureModal {\n496:         align: center middle;\n497:     }\n498:     #new-dialog {\n499:         width: 70;\n500:         height: auto;\n501:         max-height: 22;\n502:         border: thick $panel;\n503:         background: $surface;\n504:         padding: 1 2;\n505:     }\n506:     #new-dialog Input {\n507:         margin: 1 0;\n508:     }\n509:     #new-dialog Select {\n510:         margin: 1 0;\n511:     }\n512:     #new-buttons {\n513:         margin-top: 1;\n514:         height: 3;\n515:     }\n516:     #new-buttons Button {\n517:         margin: 0 1;\n518:     }\n519:     \"\"\"\n520: \n521:     def __init__(self, boards: list[str], default_board: str) -> None:\n522:         self.boards = boards\n523:         self.default_board = default_board\n524:         super().__init__()\n525: \n526:     def compose(self) -> ComposeResult:\n527:         options = [(b, b) for b in self.boards]\n528:         with Vertical(id=\"new-dialog\"):\n529:             yield Label(\"New Feature\")\n530:             yield Label(\"Board:\")\n531:             yield Select(options, value=self.default_board, id=\"new-board\")\n532:             yield Label(\"Title (required):\")\n533:             yield Input(placeholder=\"Feature title\", id=\"new-title\")\n534:             yield Label(\"Description (optional):\")\n535:             yield Input(placeholder=\"Brief description\", id=\"new-desc\")\n536:             with Horizontal(id=\"new-buttons\"):\n537:                 yield Button(\"Create\", variant=\"primary\", id=\"new-create\")\n538:                 yield Button(\"Cancel\", variant=\"default\", id=\"new-cancel\")\n539: \n540:     def on_button_pressed(self, event: Button.Pressed) -> None:\n541:         if event.button.id == \"new-create\":\n542:             self._submit()\n543:         else:\n544:             self.dismiss(None)\n545: \n546:     def on_input_submitted(self, event: Input.Submitted) -> None:\n547:         self._submit()\n548: \n549:     def _submit(self) -> None:\n550:         title = self.query_one(\"#new-title\", Input).value.strip()\n551:         if not title:\n552:             self.query_one(\"#new-title\", Input).focus()\n553:             return\n554:         desc = self.query_one(\"#new-desc\", Input).value.strip()\n555:         board = self.query_one(\"#new-board\", Select).value\n556:         if board is Select.BLANK:\n557:             board = self.default_board\n558:         self.dismiss((str(board), title, desc))\n559: \n560:     def action_cancel(self) -> None:\n561:         self.dismiss(None)\n562: \n563: \n564: class MoveFeatureModal(ModalScreen[str | None]):\n565:     \"\"\"Modal to move a feature to a different stage.\"\"\"\n566: \n567:     BINDINGS = [\n568:         Binding(\"escape\", \"cancel\", \"Cancel\"),\n569:     ]\n570: \n571:     CSS = \"\"\"\n572:     MoveFeatureModal {\n573:         align: center middle;\n574:     }\n575:     #move-dialog {\n576:         width: 50;\n577:         height: auto;\n578:         border: thick $panel;\n579:         background: $surface;\n580:         padding: 1 2;\n581:     }\n582:     #move-dialog Select {\n583:         margin: 1 0;\n584:     }\n585:     #move-buttons {\n586:         margin-top: 1;\n587:         height: 3;\n588:     }\n589:     #move-buttons Button {\n590:         margin: 0 1;\n591:     }\n592:     \"\"\"\n593: \n594:     def __init__(self, current_stage: str) -> None:\n595:         self.current_stage = current_stage\n596:         super().__init__()\n597: \n598:     def compose(self) -> ComposeResult:\n599:         from state import STAGES\n600:         options = [(s, s.replace(\"-\", \" \").title()) for s in STAGES]\n601:         with Vertical(id=\"move-dialog\"):\n602:             yield Label(\"Move to Stage:\")\n603:             # Don't set value in constructor - set it after mount\n604:             yield Select(options, id=\"move-stage\")\n605:             with Horizontal(id=\"move-buttons\"):\n606:                 yield Button(\"Move\", variant=\"primary\", id=\"move-go\")\n607:                 yield Button(\"Cancel\", variant=\"default\", id=\"move-cancel\")\n608: \n609:     def on_button_pressed(self, event: Button.Pressed) -> None:\n610:         if event.button.id == \"move-go\":\n611:             self._submit()\n612:         else:\n613:             self.dismiss(None)\n614: \n615:     def on_input_submitted(self, event: Input.Submitted) -> None:\n616:         self._submit()\n617: \n618:     def _submit(self) -> None:\n619:         from state import STAGES\n620:         select = self.query_one(\"#move-stage\", Select)\n621:         label = select.value\n622:         if label is Select.BLANK:\n623:             self.dismiss(self.current_stage)\n624:             return\n625:         \n626:         # Build reverse lookup: label -> stage\n627:         label_to_stage = {s.replace(\"-\", \" \").title(): s for s in STAGES}\n628:         stage = label_to_stage.get(str(label), str(label))\n629:         \n630:         if stage not in STAGES:\n631:             stage = self.current_stage\n632:         self.dismiss(stage)\n633: \n634:     def action_cancel(self) -> None:\n635:         self.dismiss(None)\n636: \n637: \n638: # ---------------------------------------------------------------------------\n639: # Settings panel\n640: # ---------------------------------------------------------------------------\n641: \n642: \n643: class SettingsPane(Static):\n644:     \"\"\"Settings panel for configuring agents and pipeline options.\"\"\"\n645: \n646:     CSS = \"\"\"\n647:     SettingsPane {\n648:         padding: 1;\n649:     }\n650:     .settings-row {\n651:         layout: horizontal;\n652:         height: auto;\n653:     }\n654:     .settings-row Label {\n655:         width: 20;\n656:     }\n657:     .settings-row Select {\n658:         width: 30;\n659:     }\n660:     \"\"\"\n661: \n662:     class SettingsChanged(Message):\n663:         \"\"\"Posted when settings are modified.\"\"\"\n664: \n665:         def __init__(self) -> None:\n666:             super().__init__()\n667: \n668:     def __init__(self, config: \"Config\", **kwargs) -> None:\n669:         super().__init__(**kwargs)\n670:         self._config = config\n671: \n672:     def compose(self) -> ComposeResult:\n673:         yield Label(\"[bold]Pipeline Settings[/bold]\\n\", id=\"settings-title\")\n674:         \n675:         # Default agent selector\n676:         agents = list(self._config.agents.keys())\n677:         current_default = self._config.current_agent_name\n678:         agent_options = [(a, a) for a in agents]\n679:         \n680:         yield Label(\"[bold]Default Agent[/bold]\", id=\"default-label\")\n681:         yield Select(\n682:             agent_options,\n683:             value=current_default,\n684:             id=\"default-agent-select\"\n685:         )\n686:         \n687:         yield Label(\"[bold]Phase Agent Assignments[/bold]\", id=\"phases-label\")\n688:         \n689:         # Phase assignments - horizontal rows\n690:         agent_for_phase = self._config.agent_for_phase\n691:         for phase_key, phase_label in PIPELINE_PHASES:\n692:             current_agent = agent_for_phase.get(phase_key, current_default)\n693:             phase_options = [(\"default\", \"default\")] + [(a, a) for a in agents]\n694:             with Horizontal(classes=\"settings-row\"):\n695:                 yield Label(f\"{phase_label}:\", id=f\"label-{phase_key}\")\n696:                 yield Select(\n697:                     phase_options,\n698:                     value=current_agent,\n699:                     id=f\"phase-{phase_key}\"\n700:                 )\n701:         \n702:         yield Button(\"Save Settings\", variant=\"primary\", id=\"save-settings\")\n703: \n704:     def on_button_pressed(self, event: Button.Pressed) -> None:\n705:         if event.button.id == \"save-settings\":\n706:             self._save_settings()\n707: \n708:     def _save_settings(self) -> None:\n709:         try:\n710:             # Get default agent\n711:             default_select = self.query_one(\"#default-agent-select\", Select)\n712:             new_default = default_select.value\n713:             if new_default and new_default != Select.BLANK and isinstance(new_default, str):\n714:                 self._config.set_current_agent(new_default)\n715:             \n716:             # Get phase assignments\n717:             new_agent_for_phase = {}\n718:             for phase_key, _ in PIPELINE_PHASES:\n719:                 phase_select = self.query_one(f\"#phase-{phase_key}\", Select)\n720:                 agent = phase_select.value\n721:                 if agent and agent != Select.BLANK and isinstance(agent, str):\n722:                     new_agent_for_phase[phase_key] = agent\n723:             \n724:             # Save phase assignments\n725:             self._config.set_agent_for_phases(new_agent_for_phase)\n726:             \n727:             self.post_message(self.SettingsChanged())\n728:             self.notify(\"Settings saved!\", severity=\"information\")\n729:         except Exception as e:\n730:             self.notify(f\"Failed to save: {e}\", severity=\"error\")\n731: \n732: # Number of stdout tail lines to display in the status widget\n733: _STATUS_TAIL_LINES = 8\n734: \n735: \n736: class AgentStatusWidget(Static):\n737:     \"\"\"Always-visible panel showing real-time agent progress at the bottom of the right pane.\n738:     \n739:     Can display either a single status or dual statuses (plan + implement).\n740:     \"\"\"\n741: \n742:     REFRESH_INTERVAL = 1.0  # seconds between re-renders\n743: \n744:     def __init__(\n745:         self,\n746:         status: AgentStatus | None = None,\n747:         plan_status: AgentStatus | None = None,\n748:         implement_status: AgentStatus | None = None,\n749:         **kwargs\n750:     ) -> None:\n751:         super().__init__(**kwargs)\n752:         self._status = status\n753:         self._plan_status = plan_status\n754:         self._implement_status = implement_status\n755: \n756:     def on_mount(self) -> None:\n757:         self.set_interval(self.REFRESH_INTERVAL, self.refresh)\n758: \n759:     def set_dual_statuses(self, plan_status: AgentStatus, implement_status: AgentStatus) -> None:\n760:         \"\"\"Set dual status objects for plan and implement pipelines.\"\"\"\n761:         self._plan_status = plan_status\n762:         self._implement_status = implement_status\n763:         self._status = None\n764: \n765:     def render(self) -> str:\n766:         # If we have plan_status only, show plan\n767:         if self._plan_status is not None and self._implement_status is None:\n768:             return self._render_single_with_label(self._plan_status, \"PLAN\")\n769:         # If we have impl_status only, show impl\n770:         if self._implement_status is not None and self._plan_status is None:\n771:             return self._render_single_with_label(self._implement_status, \"IMPL\")\n772:         # If we have dual statuses, show both\n773:         if self._plan_status or self._implement_status:\n774:             return self._render_dual()\n775:         # Otherwise show single status\n776:         if self._status:\n777:             return self._render_single(self._status)\n778:         return \"[dim]● idle[/dim]\"\n779: \n780:     def _render_single_with_label(self, status: AgentStatus, label: str) -> str:\n781:         \"\"\"Render a single status with a label (PLAN or IMPL).\"\"\"\n782:         if not status.running:\n783:             # Check auto mode\n784:             app = self.app\n785:             if label == \"PLAN\":\n786:                 auto_on = getattr(app, 'auto_plan_enabled', False)\n787:             else:\n788:                 auto_on = getattr(app, 'auto_implement_enabled', False)\n789:             if auto_on:\n790:                 return f\"[dim]○ {label} auto-ready[/dim]\"\n791:             return f\"[dim]○ {label} idle[/dim]\"\n792: \n793:         # Elapsed time\n794:         if status.started_at:\n795:             elapsed = time.time() - status.started_at\n796:             mins = int(elapsed // 60)\n797:             secs = int(elapsed % 60)\n798:             elapsed_str = f\"{mins}m {secs}s\" if mins else f\"{secs}s\"\n799:         else:\n800:             elapsed_str = \"0s\"\n801: \n802:         return (\n803:             f\"[bold cyan]●[/bold cyan] {label}: [bold]{status.agent}[/bold] \"\n804:             f\"[blue]{status.feature_slug}[/blue] \"\n805:             f\"[yellow]{status.phase}[/yellow] \"\n806:             f\"[dim]{elapsed_str}[/dim]\"\n807:         )\n808: \n809:     def _render_single(self, status: AgentStatus) -> str:\n810:         if not status.running:\n811:             return \"[dim]● idle[/dim]\"\n812: \n813:         # Elapsed time\n814:         if status.started_at:\n815:             elapsed = time.time() - status.started_at\n816:             mins = int(elapsed // 60)\n817:             secs = int(elapsed % 60)\n818:             elapsed_str = f\"{mins}m {secs}s\" if mins else f\"{secs}s\"\n819:         else:\n820:             elapsed_str = \"0s\"\n821: \n822:         parts = [\n823:             f\"[bold cyan]●[/bold cyan] [bold]{status.agent}[/bold] \"\n824:             f\"[blue]{status.feature_slug}[/blue] \"\n825:             f\"[yellow]{status.phase}[/yellow] \"\n826:             f\"[dim]{elapsed_str}[/dim]\",\n827:         ]\n828: \n829:         tail = status.lines[-_STATUS_TAIL_LINES:] if status.lines else []\n830:         for line in tail:\n831:             safe_line = line.replace(\"[\", r\"\\[\")\n832:             parts.append(f\"[dim]{safe_line}[/dim]\")\n833: \n834:         return \"\\n\".join(parts)\n835: \n836:     def _render_dual(self) -> str:\n837:         \"\"\"Render two status displays side by side or stacked.\"\"\"\n838:         # Get auto flags from app\n839:         app = self.app\n840:         auto_plan = getattr(app, 'auto_plan_enabled', False)\n841:         auto_impl = getattr(app, 'auto_implement_enabled', False)\n842:         \n843:         parts = []\n844:         \n845:         # Plan status\n846:         if self._plan_status and self._plan_status.running:\n847:             parts.append(self._render_status_line(self._plan_status, \"PLAN\"))\n848:         elif auto_plan:\n849:             parts.append(\"[dim]○ PLAN auto-ready[/dim]\")\n850:         else:\n851:             parts.append(\"[dim]○ PLAN idle[/dim]\")\n852:         \n853:         # Implement status\n854:         if self._implement_status and self._implement_status.running:\n855:             parts.append(self._render_status_line(self._implement_status, \"IMPL\"))\n856:         elif auto_impl:\n857:             parts.append(\"[dim]○ IMPL auto-ready[/dim]\")\n858:         else:\n859:             parts.append(\"[dim]○ IMPL idle[/dim]\")\n860:         \n861:         return \"  |  \".join(parts)\n862: \n863:     def _render_status_line(self, status: AgentStatus, label: str) -> str:\n864:         if status.started_at:\n865:             elapsed = time.time() - status.started_at\n866:             mins = int(elapsed // 60)\n867:             secs = int(elapsed % 60)\n868:             elapsed_str = f\"{mins}m{secs}s\" if mins else f\"{secs}s\"\n869:         else:\n870:             elapsed_str = \"0s\"\n871:         \n872:         return (\n873:             f\"[bold cyan]●[/bold cyan] {label}: [bold]{status.agent}[/bold] \"\n874:             f\"[blue]{status.feature_slug}[/blue] \"\n875:             f\"[yellow]{status.phase}[/yellow] [dim]{elapsed_str}[/dim]\"\n876:         )\n877: \n878: \n879: # ---------------------------------------------------------------------------\n880: # Main application\n881: # ---------------------------------------------------------------------------\n882: \n883: \n884: class PipelineApp(App):\n885:     \"\"\"MAD Pipeline TUI -- interactive kanban dashboard.\"\"\"\n886: \n887:     TITLE = \"MAD Pipeline\"\n888: \n889:     BINDINGS = [\n890:         Binding(\"ctrl+q\", \"quit\", \"Quit\"),\n891:         Binding(\"q\", \"answer_questions\", \"Answer\"),\n892:         Binding(\"i\", \"interactive\", \"Interact\"),\n893:         Binding(\"a\", \"approve\", \"Approve\"),\n894:         Binding(\"r\", \"review\", \"Review\"),\n895:         Binding(\"ctrl+r\", \"restart\", \"Restart\"),\n896:         Binding(\"x\", \"reject\", \"Reject\"),\n897:         Binding(\"u\", \"restore\", \"Restore\"),\n898:         Binding(\"p\", \"promote\", \"Promote\"),\n899:         Binding(\"s\", \"start\", \"Start\"),\n900:         Binding(\"ctrl+a\", \"toggle_auto_plan\", \"Auto-Plan\"),\n901:         Binding(\"ctrl+d\", \"toggle_auto_implement\", \"Auto-Impl\"),\n902:         Binding(\"ctrl+s\", \"stop_auto\", \"Stop\"),\n903:         Binding(\"m\", \"move\", \"Move\"),\n904:         Binding(\"n\", \"new_feature\", \"New\"),\n905:         Binding(\"b\", \"new_board\", \"New Board\"),\n906:         Binding(\"f\", \"refresh\", \"Refresh\"),\n907:         Binding(\"tab\", \"toggle_focus\", \"Switch\"),\n908:         Binding(\";\", \"go_to_settings\", \"Settings\"),\n909:         Binding(\"up\", \"focus_previous\", \"Up\"),\n910:         Binding(\"down\", \"focus_next\", \"Down\"),\n911:     ]\n912: \n913:     # Stage -> list of available actions (key, action, label)\n914:     STAGE_ACTIONS = {\n915:         \"ideas\": [(\"m\", \"move\", \"Move\"), (\"i\", \"interactive\", \"Interact\"), (\"a\", \"approve\", \"To Plan\"), (\"x\", \"reject\", \"Reject\")],\n916:         \"plan-inbox\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n917:         \"reviewing-plan\": [(\"m\", \"move\", \"Move\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n918:         \"requested-input\": [(\"m\", \"move\", \"Move\"), (\"q\", \"answer_questions\", \"Answer\"), (\"s\", \"start\", \"Start\")],\n919:         \"approved\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n920:         \"spec-writing\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n921:         \"implementing\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n922:         \"testing\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n923:         \"review\": [(\"m\", \"move\", \"Move\"), (\"a\", \"approve\", \"Approve\"), (\"r\", \"review\", \"Review\"), (\"x\", \"reject\", \"Reject\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n924:         \"final-human-approval\": [(\"m\", \"move\", \"Move\"), (\"a\", \"approve\", \"Done\"), (\"x\", \"reject\", \"Reject\")],\n925:         \"done\": [(\"m\", \"move\", \"Move\"), (\"u\", \"restore\", \"Restore\")],\n926:         \"rejected\": [(\"m\", \"move\", \"Move\"), (\"u\", \"restore\", \"Restore\")],\n927:     }\n928: \n929:     # Stage -> list of available actions (key, action, label)\n930:     STAGE_ACTIONS = {\n931:         \"ideas\": [(\"m\", \"move\", \"Move\"), (\"i\", \"interactive\", \"Interact\"), (\"a\", \"approve\", \"To Plan\"), (\"x\", \"reject\", \"Reject\")],\n932:         \"plan-inbox\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n933:         \"reviewing-plan\": [(\"m\", \"move\", \"Move\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n934:         \"requested-input\": [(\"m\", \"move\", \"Move\"), (\"q\", \"answer_questions\", \"Answer\"), (\"s\", \"start\", \"Start\")],\n935:         \"approved\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n936:         \"spec-writing\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n937:         \"implementing\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"s\", \"start\", \"Start\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n938:         \"testing\": [(\"m\", \"move\", \"Move\"), (\"x\", \"reject\", \"Reject\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n939:         \"review\": [(\"m\", \"move\", \"Move\"), (\"a\", \"approve\", \"Approve\"), (\"x\", \"reject\", \"Reject\"), (\"ctrl+r\", \"restart\", \"Restart\")],\n940:         \"final-human-approval\": [(\"m\", \"move\", \"Move\"), (\"a\", \"approve\", \"Done\"), (\"x\", \"reject\", \"Reject\")],\n941:         \"done\": [(\"m\", \"move\", \"Move\"), (\"u\", \"restore\", \"Restore\")],\n942:         \"rejected\": [(\"m\", \"move\", \"Move\"), (\"u\", \"restore\", \"Restore\")],\n943:     }\n944: \n945:     # Global hotkeys that are always available\n946:     GLOBAL_BINDINGS = [\n947:         (\"n\", \"new_feature\", \"New\"),\n948:         (\"b\", \"new_board\", \"New Board\"),\n949:         (\"f\", \"refresh\", \"Refresh\"),\n950:         (\"ctrl+a\", \"toggle_auto_plan\", \"Auto-Plan\"),\n951:         (\"ctrl+d\", \"toggle_auto_implement\", \"Auto-Impl\"),\n952:     ]\n953: \n954:     def get_contextual_bindings(self) -> list[tuple]:\n955:         \"\"\"Get bindings - global + stage-specific actions.\"\"\"\n956:         # Always include global hotkeys\n957:         bindings = list(self.GLOBAL_BINDINGS)\n958:         \n959:         if not self.selected_feature:\n960:             return bindings + [(\"ctrl+q\", \"quit\", \"Quit\")]\n961:         \n962:         # Add stage-specific actions\n963:         stage = self.selected_feature.current_stage\n964:         stage_bindings = self.STAGE_ACTIONS.get(stage, [])\n965:         \n966:         # Add stage actions in the middle, Quit always last\n967:         return bindings + stage_bindings + [(\"ctrl+q\", \"quit\", \"Quit\")]\n968: \n969:     CSS = \"\"\"\n970:     Screen {\n971:         layout: vertical;\n972:     }\n973: \n974:     #main-layout {\n975:         layout: horizontal;\n976:         height: 1fr;\n977:     }\n978: \n979:     #left-pane {\n980:         width: 34;\n981:         min-width: 24;\n982:         border-right: solid $panel;\n983:         overflow-y: auto;\n984:     }\n985: \n986:     #left-pane:focus-within {\n987:         border-right: solid $accent;\n988:     }\n989: \n990:     #right-pane {\n991:         width: 1fr;\n992:         height: 1fr;\n993:         padding: 0 1;\n994:     }\n995: \n996:     #right-pane:focus-within {\n997:         border-left: solid $accent;\n998:     }\n999: \n1000:     #detail-view {\n1001:         width: 50%;\n1002:         height: 1fr;\n1003:         overflow-y: auto;\n1004:         border-right: solid $panel;\n1005:         padding: 0 1;\n1006:     }\n1007: \n1008:     #right-bottom {\n1009:         width: 50%;\n1010:         height: 1fr;\n1011:     }\n1012: \n1013:     #right-bottom > * {\n1014:         height: 1fr;\n1015:     }\n1016: \n1017:     #log-section, #plan-section, #impl-section {\n1018:         height: 1fr;\n1019:     }\n1020: \n1021:     .panel-header {\n1022:         height: 1;\n1023:         background: $panel;\n1024:         color: $text;\n1025:         text-style: bold;\n1026:         padding: 0 1;\n1027:     }\n1028: \n1029:     .stage-header {\n1030:         color: $text-muted;\n1031:         text-style: bold;\n1032:         padding: 0 1;\n1033:         margin-top: 1;\n1034:     }\n1035: \n1036:     .stage-header.has-features {\n1037:         color: $text;\n1038:     }\n1039: \n1040:     .stage-header.needs-attention {\n1041:         color: yellow;\n1042:         text-style: bold;\n1043:     }\n1044: \n1045:     .feature-item {\n1046:         padding: 0 2;\n1047:         color: $text-muted;\n1048:         height: 1;\n1049:     }\n1050: \n1051:     .feature-item:hover {\n1052:         background: $boost;\n1053:         color: $text;\n1054:     }\n1055: \n1056:     .feature-item:focus {\n1057:         background: $accent;\n1058:         color: $text;\n1059:     }\n1060: \n1061:     .feature-item.--selected {\n1062:         background: $accent;\n1063:         color: $text;\n1064:     }\n1065: \n1066:     #status-bar {\n1067:         dock: bottom;\n1068:         height: 1;\n1069:         background: $panel;\n1070:         color: $text-muted;\n1071:         padding: 0 2;\n1072:     }\n1073: \n1074:     #board-tabs {\n1075:         height: 1fr;\n1076:     }\n1077: \n1078:     AgentStatusWidget {\n1079:         height: 12;\n1080:         border-top: solid $panel;\n1081:         padding: 0 1;\n1082:         color: $text-muted;\n1083:         overflow-y: auto;\n1084:     }\n1085: \n1086:     #contextual-footer {\n1087:         dock: bottom;\n1088:         height: 1;\n1089:         background: $panel;\n1090:     }\n1091:     \n1092:     #contextual-footer Button {\n1093:         margin: 0 1;\n1094:     }\n1095:     \"\"\"\n1096: \n1097:     # Currently selected feature\n1098:     selected_feature: reactive[FeatureFile | None] = reactive(None)\n1099:     # Currently active board tab\n1100:     active_board: reactive[str] = reactive(\"\")\n1101:     # Whether a pipeline run is in progress\n1102:     running: reactive[bool] = reactive(False)\n1103:     # Auto-run modes - can run independently in parallel\n1104:     auto_plan_enabled: reactive[bool] = reactive(False)\n1105:     auto_implement_enabled: reactive[bool] = reactive(False)\n1106:     # Which right pane to show: \"detail\" or \"log\"\n1107:     right_pane_mode: reactive[str] = reactive(\"detail\")\n1108: \n1109:     def __init__(self) -> None:\n1110:         super().__init__()\n1111:         self._config = Config()\n1112:         self._config.setup_boards()\n1113:         # Track previous feature snapshot for change detection in auto-refresh\n1114:         self._prev_snapshot: dict[str, list[tuple[str, str]]] = {}\n1115:         self._prev_mtimes: dict[str, dict[str, float]] = {}\n1116:         # Two separate agent status instances for plan and implement pipelines\n1117:         self._plan_agent_status = AgentStatus()\n1118:         self._implement_agent_status = AgentStatus()\n1119:         # Shared agent status instance (for manual runs)\n1120:         self._agent_status = AgentStatus()\n1121:         # Persistent log buffer - survives view toggles\n1122:         self._log_buffer: list[str] = []\n1123:         # Track which features have been auto-queued to avoid duplicates\n1124:         self._auto_plan_queued: set[str] = set()\n1125:         self._auto_implement_queued: set[str] = set()\n1126:         # Track if plan/implement pipelines are running\n1127:         self._plan_running = False\n1128:         self._implement_running = False\n1129:         # Rate limit tracking - timestamp until which auto modes are disabled\n1130:         self._rate_limit_until: float = 0.0\n1131:         # Server client for pushing state to monitoring server\n1132:         self._server_client: Optional[ServerClient] = None\n1133: \n1134:     def compose(self) -> ComposeResult:\n1135:         yield Header(show_clock=False)\n1136:         boards = self._config.boards\n1137:         if not boards:\n1138:             yield Label(\"No boards configured. Check ~/MAD/config.json\")\n1139:             yield Static(\"\", id=\"contextual-footer\")\n1140:             return\n1141: \n1142:         # Board tabs sit above the main layout - always show tabs to include Settings\n1143:         with TabbedContent(id=\"main-tabs\"):\n1144:             # Board tabs\n1145:             for board in boards:\n1146:                 yield TabPane(board, id=f\"board-{board}\")\n1147:             # Settings tab\n1148:             yield TabPane(\"Settings\", id=\"settings-tab\")\n1149:         \n1150:         self.active_board = boards[0] if boards else \"\"\n1151: \n1152:         # Kanban layout - shown for board tabs, hidden for settings\n1153:         with Horizontal(id=\"main-layout\"):\n1154:             with VerticalScroll(id=\"left-pane\"):\n1155:                 yield Static(\"Loading...\", id=\"kanban-placeholder\")\n1156:             with Horizontal(id=\"right-pane\"):\n1157:                 with VerticalScroll(id=\"detail-view\"):\n1158:                     yield Markdown(\n1159:                         \"*Select a feature to view details*\", id=\"detail-markdown\"\n1160:                     )\n1161:                 with Vertical(id=\"right-bottom\"):\n1162:                     with Vertical(id=\"log-section\"):\n1163:                         yield Static(\"=== LOG ===\", classes=\"panel-header\")\n1164:                         yield Log(id=\"log-view\", auto_scroll=True)\n1165:                     with Vertical(id=\"plan-section\"):\n1166:                         yield Static(\"=== PLAN ===\", classes=\"panel-header\")\n1167:                         yield AgentStatusWidget(\n1168:                             plan_status=self._plan_agent_status,\n1169:                             implement_status=None,\n1170:                             id=\"plan-status\"\n1171:                         )\n1172:                     with Vertical(id=\"impl-section\"):\n1173:                         yield Static(\"=== IMPL ===\", classes=\"panel-header\")\n1174:                         yield AgentStatusWidget(\n1175:                             plan_status=None,\n1176:                             implement_status=self._implement_agent_status,\n1177:                             id=\"impl-status\"\n1178:                         )\n1179: \n1180:         # Settings view - hidden by default\n1181:         with Vertical(id=\"settings-view\"):\n1182:             yield SettingsPane(self._config, id=\"settings-pane\")\n1183: \n1184:         yield Static(\"\", id=\"status-bar\")\n1185:         \n1186:         # Custom contextual footer with clickable buttons\n1187:         with Horizontal(id=\"contextual-footer\"):\n1188:             yield Static(\"\", id=\"footer-content\")\n1189: \n1190:     def on_mount(self) -> None:\n1191:         \"\"\"Initialize the first board and start auto-refresh.\"\"\"\n1192:         boards = self._config.boards\n1193:         if boards:\n1194:             self.active_board = boards[0]\n1195:             self._refresh_board(self.active_board)\n1196:         # Initialize footer\n1197:         self._update_footer()\n1198:         # Hide settings view initially\n1199:         try:\n1200:             self.query_one(\"#settings-view\", Vertical).display = False\n1201:         except NoMatches:\n1202:             pass\n1203:         # Auto-refresh every 10 seconds to pick up external changes\n1204:         self.set_interval(10.0, self._check_for_changes)\n1205:         # Auto-run check every 10 seconds\n1206:         self.set_interval(10.0, self._auto_run_check)\n1207:         # Start server connection if configured\n1208:         server_cfg = self._config.server\n1209:         if server_cfg and HAS_WEBSOCKETS and ServerClient is not None:\n1210:             self._server_client = ServerClient(\n1211:                 url=server_cfg.url,\n1212:                 api_key=server_cfg.api_key,\n1213:                 client_id=server_cfg.client_id,\n1214:                 on_connect=self._on_server_connected,\n1215:                 on_answers_received=self._handle_server_answers,\n1216:                 on_set_auto_mode=self._handle_set_auto_mode,\n1217:                 on_start_agent=self._handle_start_agent,\n1218:                 on_idea_created=self._handle_create_idea,\n1219:             )\n1220:             self._connect_server()\n1221:             self.set_interval(5.0, self._periodic_server_push)\n1222: \n1223:     def _periodic_server_push(self) -> None:\n1224:         \"\"\"Push current state to server periodically (agent status may change without feature changes).\"\"\"\n1225:         if self._server_client and self._server_client.connected:\n1226:             features = getattr(self, \"_current_features\", [])\n1227:             self._push_to_server(features[:])\n1228: \n1229:     @work(thread=False)\n1230:     async def _connect_server(self) -> None:\n1231:         \"\"\"Background task: maintain WebSocket connection to monitoring server.\"\"\"\n1232:         if self._server_client:\n1233:             await self._server_client.reconnect_loop()\n1234: \n1235:     async def _handle_server_answers(self, feature_id: str, answers: list) -> None:\n1236:         \"\"\"Handle answer_questions message from the server (web UI submitted answers).\"\"\"\n1237:         feature = FeatureFile.find(feature_id)\n1238:         if not feature:\n1239:             logger.warning(f\"answer_questions: feature {feature_id} not found\")\n1240:             return\n1241:         if feature.current_stage != \"requested-input\":\n1242:             logger.warning(f\"answer_questions: feature {feature_id} not in requested-input (is {feature.current_stage})\")\n1243:             return\n1244:         for i, a in enumerate(answers):\n1245:             ans_text = a.get(\"answer\", \"\")\n1246:             if ans_text:\n1247:                 feature.answer_question(i, ans_text)\n1248:         feature.add_history(\"PLAN-INBOX\", \"Questions answered via web UI\")\n1249:         feature.move_to_stage(\"plan-inbox\")\n1250:         self._refresh_board(self.active_board)\n1251:         if self._server_client and self._server_client.connected:\n1252:             features = self._load_features(self.active_board)\n1253:             await self._server_client.push_state(\n1254:                 features, self._plan_agent_status, self._implement_agent_status,\n1255:                 auto_plan_enabled=self.auto_plan_enabled,\n1256:                 auto_impl_enabled=self.auto_implement_enabled,\n1257:             )\n1258: \n1259:     def _handle_set_auto_mode(self, mode: str, enabled: bool) -> None:\n1260:         \"\"\"Handle set_auto_mode message from the server (web UI toggled auto mode).\"\"\"\n1261:         if mode == \"plan\":\n1262:             self.auto_plan_enabled = enabled\n1263:         elif mode == \"impl\":\n1264:             self.auto_implement_enabled = enabled\n1265:         self._update_status_bar(self.active_board, self._load_features(self.active_board))\n1266:         # Push updated state back to server\n1267:         if self._server_client and self._server_client.connected:\n1268:             features = self._load_features(self.active_board)\n1269:             self._push_to_server(features[:])\n1270: \n1271:     def _handle_start_agent(self, feature_id: str, action: str) -> None:\n1272:         \"\"\"Handle start_agent message from the server (web UI triggered plan/implement).\"\"\"\n1273:         features = self._load_features(self.active_board)\n1274:         feature = None\n1275:         for f in features:\n1276:             if f.id == feature_id:\n1277:                 feature = f\n1278:                 break\n1279:         if not feature:\n1280:             logger.warning(f\"start_agent: feature {feature_id} not found\")\n1281:             return\n1282:         if action not in STAGE_ACTIONS:\n1283:             logger.warning(f\"start_agent: unknown action {action}\")\n1284:             return\n1285:         if feature.current_stage not in STAGE_ACTIONS[action]:\n1286:             logger.warning(f\"start_agent: feature {feature_id} stage {feature.current_stage} not valid for {action}\")\n1287:             return\n1288:         if action == \"plan\" and self._plan_running:\n1289:             logger.warning(\"start_agent: plan agent already running\")\n1290:             return\n1291:         if action == \"implement\" and self._implement_running:\n1292:             logger.warning(\"start_agent: implement agent already running\")\n1293:             return\n1294: \n1295:         def _do_start():\n1296:             self.selected_feature = feature\n1297:             self._show_log()\n1298:             if action == \"plan\":\n1299:                 self._log_line(f\"=== Running PLAN (via web UI) for: {feature.title} ===\")\n1300:                 self._log_line(f\"Stage: {feature.current_stage}\")\n1301:                 self._log_line(\"\")\n1302:                 self._plan_running = True\n1303:                 self._run_plan_async(feature)\n1304:             else:\n1305:                 self._log_line(f\"=== Running IMPLEMENT (via web UI) for: {feature.title} ===\")\n1306:                 self._log_line(f\"Stage: {feature.current_stage}\")\n1307:                 self._log_line(\"\")\n1308:                 self._implement_running = True\n1309:                 self._run_implement_async(feature)\n1310:         self.call_from_thread(_do_start)\n1311: \n1312:     def _handle_create_idea(self, title: str, board: str, description: str) -> None:\n1313:         \"\"\"Handle create_idea message from the server (web UI created a new idea).\"\"\"\n1314:         def _do_create():\n1315:             try:\n1316:                 feature = FeatureFile.create(board, title, description)\n1317:                 logger.info(f\"Created new idea: {feature.title} ({feature.id}) in board {board}\")\n1318:                 self._refresh_board(self.active_board)\n1319:                 # Push updated state back to server\n1320:                 if self._server_client and self._server_client.connected:\n1321:                     features = self._load_features(self.active_board)\n1322:                     asyncio.create_task(self._server_client.push_state(\n1323:                         features, self._plan_agent_status, self._implement_agent_status,\n1324:                         auto_plan_enabled=self.auto_plan_enabled,\n1325:                         auto_impl_enabled=self.auto_implement_enabled,\n1326:                     ))\n1327:             except Exception as e:\n1328:                 logger.warning(f\"create_idea: failed to create idea: {e}\")\n1329:         self.call_from_thread(_do_create)\n1330: \n1331:     async def _on_server_connected(self) -> None:\n1332:         \"\"\"Push full board state immediately after connecting to server.\"\"\"\n1333:         board = self.active_board\n1334:         if board and self._server_client and self._server_client.connected:\n1335:             features = self._load_features(board)\n1336:             await self._server_client.push_state(\n1337:                 features, self._plan_agent_status, self._implement_agent_status,\n1338:                 auto_plan_enabled=self.auto_plan_enabled,\n1339:                 auto_impl_enabled=self.auto_implement_enabled,\n1340:             )\n1341: \n1342:     @work(thread=False)\n1343:     async def _push_to_server(self, features: list) -> None:\n1344:         \"\"\"Background task: push current feature state to the server.\"\"\"\n1345:         if self._server_client and self._server_client.connected:\n1346:             try:\n1347:                 await self._server_client.push_state(\n1348:                     features, self._plan_agent_status, self._implement_agent_status,\n1349:                     auto_plan_enabled=self.auto_plan_enabled,\n1350:                     auto_impl_enabled=self.auto_implement_enabled,\n1351:                 )\n1352:             except Exception:\n1353:                 pass\n1354: \n1355:     def on_settings_pane_settings_changed(self, event: SettingsPane.SettingsChanged) -> None:\n1356:         \"\"\"Handle settings changes - reload config.\"\"\"\n1357:         # Reload the config to pick up changes\n1358:         self._config = Config(path=self._config._path)\n1359:         self.notify(\"Settings applied\", severity=\"information\")\n1360: \n1361:     def on_tabbed_content_tab_activated(\n1362:         self, event: TabbedContent.TabActivated\n1363:     ) -> None:\n1364:         \"\"\"Handle tab switch - boards or settings.\"\"\"\n1365:         pane_id = event.pane.id or \"\"\n1366:         \n1367:         if pane_id == \"settings-tab\":\n1368:             self._show_settings_view()\n1369:             return\n1370:         \n1371:         if pane_id.startswith(\"board-\"):\n1372:             board = pane_id[len(\"board-\") :]\n1373:             self.active_board = board\n1374:             self.selected_feature = None\n1375:             self._show_kanban_view()\n1376:             self._refresh_board(board)\n1377:             self._update_detail_view()\n1378: \n1379:     def _show_settings_view(self) -> None:\n1380:         \"\"\"Show the settings panel and hide the kanban.\"\"\"\n1381:         try:\n1382:             main_layout = self.query_one(\"#main-layout\", Horizontal)\n1383:             main_layout.display = False\n1384:             settings_view = self.query_one(\"#settings-view\", Vertical)\n1385:             settings_view.display = True\n1386:             self.query_one(\"#status-bar\", Static).display = False\n1387:             self.query_one(\"#contextual-footer\", Horizontal).display = False\n1388:         except NoMatches:\n1389:             pass\n1390: \n1391:     def _show_kanban_view(self) -> None:\n1392:         \"\"\"Show the kanban board and hide settings.\"\"\"\n1393:         try:\n1394:             main_layout = self.query_one(\"#main-layout\", Horizontal)\n1395:             main_layout.display = True\n1396:             settings_view = self.query_one(\"#settings-view\", Vertical)\n1397:             settings_view.display = False\n1398:             self.query_one(\"#status-bar\", Static).display = True\n1399:             self.query_one(\"#contextual-footer\", Horizontal).display = True\n1400:         except NoMatches:\n1401:             pass\n1402: \n1403:     def on_feature_item_selected(self, event: FeatureItem.Selected) -> None:\n1404:         \"\"\"Handle feature selection from the left pane.\"\"\"\n1405:         self.selected_feature = event.feature\n1406:         self._show_detail()  # Switch to detail view when selecting\n1407:         self._update_detail_view()\n1408:         # Re-render left pane to update the selection indicator\n1409:         self._refresh_kanban_widgets()\n1410: \n1411:     # ------------------------------------------------------------------\n1412:     # Board data loading and rendering\n1413:     # ------------------------------------------------------------------\n1414: \n1415:     def _load_features(self, board: str) -> list[FeatureFile]:\n1416:         \"\"\"Load all features for a board.\"\"\"\n1417:         return FeatureFile.list_all(board=board)\n1418: \n1419:     def _snapshot(self, features: list[FeatureFile]) -> list[tuple[str, str]]:\n1420:         \"\"\"Create a lightweight snapshot for change detection.\"\"\"\n1421:         return [(f.slug, f.current_stage) for f in features]\n1422: \n1423:     def _refresh_board(self, board: str) -> None:\n1424:         \"\"\"Reload features and rebuild the kanban left pane for the given board.\"\"\"\n1425:         features = self._load_features(board)\n1426:         self._prev_snapshot[board] = self._snapshot(features)\n1427:         self._current_features = features\n1428:         self._refresh_kanban_widgets()\n1429:         self._update_status_bar(board, features)\n1430: \n1431:     def _refresh_kanban_widgets(self) -> None:\n1432:         \"\"\"Rebuild the kanban left pane widgets from self._current_features.\"\"\"\n1433:         features = getattr(self, \"_current_features\", [])\n1434: \n1435:         # Group features by stage\n1436:         by_stage: dict[str, list[FeatureFile]] = {s: [] for s in STAGES}\n1437:         for f in features:\n1438:             stage = f.current_stage\n1439:             if stage in by_stage:\n1440:                 by_stage[stage].append(f)\n1441: \n1442:         try:\n\n(Output capped at 50 KB. Showing lines 1-1442. Use offset=1443 to continue.)\n</content>","title":"pipeline/tui.py","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"MAD Pipeline TUI — interactive kanban dashboard built with Textual.\"\"\"\n\nimport asyncio\nimport atexit\nimport logging\nimport os\nimport signal\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Optional\n\nlogger = logging.getLogger(__name__)\n\n# Ensure pipeline modules are importable when running tui.py directly\nsys.path.insert(0, str(Path(__file__).parent))\n\nfrom agent_status import AgentStatus\nfrom config import Config","truncated":true,"loaded":[]},"time":{"start":1772833382207,"end":1772833382217}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"All files exist. Let me read them to understand the existing patterns.","format":"anthropic-claude-v1","index":0,"signature":"c7a72a6651ff2fc1a1ad3711cd63eefc7bc527be77e08d0da982ccaeb2bf10f3"}]}}}}
