\",\n3199: \t\t\"features\":  []interface{}{},\n3200: \t\t\"auto_plan\": true,\n3201: \t\t\"auto_impl\": false,\n3202: \t})\n3203: \ttime.Sleep(200 * time.Millisecond)\n3204: \n3205: \t// 4. Verify server stored the state\n3206: \tstate, ok := hub.GetClient(\"e2e-auto\")\n3207: \tif !ok {\n3208: \t\tt.Fatal(\"client not found\")\n3209: \t}\n3210: \tif !state.AutoPlan {\n3211: \t\tt.Error(\"AutoPlan should be true after round trip\")\n3212: \t}\n3213: \n3214: \t// 5. Verify JSON API reflects the state\n3215: \tresp2 := apiGet(t, ts, \"/api/clients/e2e-auto\", \"\")\n3216: \tdefer resp2.Body.Close()\n3217: \tvar jsonState map[string]interface{}\n3218: \tjson.NewDecoder(resp2.Body).Decode(&jsonState)\n3219: \tif jsonState[\"auto_plan\"] != true {\n3220: \t\tt.Errorf(\"JSON API auto_plan should be true, got %v\", jsonState[\"auto_plan\"])\n3221: \t}\n3222: }\n3223: \n3224: // ---------------------------------------------------------------------------\n3225: // Start Agent Edge Cases - additional tests\n3226: // ---------------------------------------------------------------------------\n3227: \n3228: func TestStartAgentPlanWhileImplBusy(t *testing.T) {\n3229: \tcfg := testConfig(\"\")\n3230: \thub, ts := startTestServerT(t, cfg)\n3231: \n3232: \tstageActions := map[string][]string{\"plan\": {\"approved\"}, \"implement\": {\"approved\"}}\n3233: \tfeatures := []map[string]interface{}{\n3234: \t\t{\"title\": \"F1\", \"stage\": \"approved\", \"board\": \"b\", \"id\": \"f1\"},\n3235: \t}\n3236: \timplAgent := map[string]interface{}{\"running\": true, \"phase\": \"implementing\", \"feature\": \"f1\", \"agent\": \"claude\"}\n3237: \tconn := registerClientWithFeaturesAndStageActions(t, hub, ts, \"\", \"plan-while-impl-busy\", features, stageActions, nil, implAgent)\n3238: \tdefer conn.Close()\n3239: \n3240: \tmsgCh := make(chan map[string]interface{}, 1)\n3241: \tgo func() {\n3242: \t\tvar msg map[string]interface{}\n3243: \t\tconn.ReadJSON(&msg)\n3244: \t\tmsgCh <- msg\n3245: 