{"type":"tool_use","timestamp":1772833186119,"sessionID":"ses_33ae96732ffeDfM0NgFPM4w1E1","part":{"id":"prt_cc517a140001TEd3bVQu0jZ0lZ","sessionID":"ses_33ae96732ffeDfM0NgFPM4w1E1","messageID":"msg_cc5179190001KS6N6MITk66nG1","type":"tool","callID":"call_function_svqoqgybcddb_1","tool":"read","state":{"status":"completed","input":{"filePath":"/home/paule/MAD/pipeline/test_auto_mode_full.py"},"output":"<path>/home/paule/MAD/pipeline/test_auto_mode_full.py</path>\n<type>file</type>\n<content>1: \"\"\"Comprehensive tests for auto-plan/auto-impl WebSocket controls - full data flow verification.\n2: \n3: This test module covers:\n4: 1. Pipeline client auto-mode state in state_update messages\n5: 2. ServerClient handles incoming set_auto_mode messages  \n6: 3. TUI callback toggles auto-mode state correctly\n7: 4. Server stores AutoPlan/AutoImpl in ClientState\n8: 5. Server parses auto-mode from state_update messages\n9: 6. API endpoint validation and error handling\n10: 7. Full end-to-end data flow\n11: \"\"\"\n12: \n13: import asyncio\n14: import json\n15: import unittest\n16: from unittest.mock import AsyncMock, MagicMock, patch\n17: \n18: import sys, os\n19: sys.path.insert(0, os.path.dirname(__file__))\n20: \n21: from server_client import ServerClient\n22: \n23: \n24: class FakeWebSocket:\n25:     \"\"\"Fake websocket for testing.\"\"\"\n26:     \n27:     def __init__(self):\n28:         self._sent = []\n29:         \n30:     async def send(self, data):\n31:         self._sent.append(data)\n32:         \n33:     async def close(self):\n34:         pass\n35: \n36: \n37: def _make_feature(title=\"Test Feature\", stage=\"ideas\", board=\"default\",\n38:                   created=\"2025-01-01\", fid=\"f1\"):\n39:     \"\"\"Create a mock feature object.\"\"\"\n40:     from types import SimpleNamespace\n41:     f = SimpleNamespace()\n42:     f.title = title\n43:     f.current_stage = stage\n44:     f.board = board\n45:     f.created = created\n46:     f.id = fid\n47:     f.description = \"\"\n48:     f.questions = []\n49:     f._data = {\"pipeline_log\": [], \"history\": []}\n50:     return f\n51: \n52: \n53: class TestPushStateAutoModeIncludeInPayload(unittest.IsolatedAsyncioTestCase):\n54:     \"\"\"Test 1.1: Pipeline Client includes auto-mode state in push_state() messages.\n55:     \n56:     Verify that push_state() method includes auto_plan and auto_impl boolean \n57:     values in the state_update WebSocket message.\n58:     \"\"\"\n59: \n60:     async def _make_connected_client(self):\n61:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test-client\")\n62:         client._connected = True\n63:         client._ws = AsyncMock()\n64:         client._ws.send = AsyncMock()\n65:         return client\n66: \n67:     async def test_push_state_includes_auto_plan_true_auto_impl_false(self):\n68:         \"\"\"Verify auto_plan=true, auto_impl=false in payload.\"\"\"\n69:         client = await self._make_connected_client()\n70:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=False)\n71:         sent = json.loads(client._ws.send.call_args[0][0])\n72:         self.assertTrue(sent[\"auto_plan\"])\n73:         self.assertFalse(sent[\"auto_impl\"])\n74: \n75:     async def test_push_state_both_false_by_default(self):\n76:         \"\"\"Verify both fields default to false.\"\"\"\n77:         client = await self._make_connected_client()\n78:         await client.push_state([])\n79:         sent = json.loads(client._ws.send.call_args[0][0])\n80:         self.assertFalse(sent[\"auto_plan\"])\n81:         self.assertFalse(sent[\"auto_impl\"])\n82: \n83:     async def test_push_state_both_true(self):\n84:         \"\"\"Verify both fields can be true.\"\"\"\n85:         client = await self._make_connected_client()\n86:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=True)\n87:         sent = json.loads(client._ws.send.call_args[0][0])\n88:         self.assertTrue(sent[\"auto_plan\"])\n89:         self.assertTrue(sent[\"auto_impl\"])\n90: \n91:     async def test_push_state_payload_format(self):\n92:         \"\"\"Verify complete payload format with auto_mode fields.\"\"\"\n93:         client = await self._make_connected_client()\n94:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=False)\n95:         sent = json.loads(client._ws.send.call_args[0][0])\n96:         self.assertEqual(sent[\"type\"], \"state_update\")\n97:         self.assertIn(\"auto_plan\", sent)\n98:         self.assertIn(\"auto_impl\", sent)\n99:         self.assertIsInstance(sent[\"auto_plan\"], bool)\n100:         self.assertIsInstance(sent[\"auto_impl\"], bool)\n101: \n102:     async def test_push_state_not_connected_returns_early(self):\n103:         \"\"\"Verify no message sent when not connected.\"\"\"\n104:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test-client\")\n105:         client._connected = False\n106:         client._ws = None\n107:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=True)\n108: \n109: \n110: class TestHandleIncomingSetAutoMode(unittest.IsolatedAsyncioTestCase):\n111:     \"\"\"Test 1.3: Pipeline Client handles incoming set_auto_mode messages.\n112:     \n113:     Verify that ServerClient._handle_incoming() detects message type \n114:     \"set_auto_mode\" and invokes the callback with correct parameters.\n115:     \"\"\"\n116: \n117:     async def test_set_auto_mode_plan_true(self):\n118:         \"\"\"Verify callback invoked with ('plan', True).\"\"\"\n119:         callback = MagicMock()\n120:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n121:         await client._handle_incoming(json.dumps({\n122:             \"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": True\n123:         }))\n124:         callback.assert_called_once_with(\"plan\", True)\n125: \n126:     async def test_set_auto_mode_impl_false(self):\n127:         \"\"\"Verify callback invoked with ('impl', False).\"\"\"\n128:         callback = MagicMock()\n129:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n130:         await client._handle_incoming(json.dumps({\n131:             \"type\": \"set_auto_mode\", \"mode\": \"impl\", \"enabled\": False\n132:         }))\n133:         callback.assert_called_once_with(\"impl\", False)\n134: \n135:     async def test_set_auto_mode_no_callback_no_crash(self):\n136:         \"\"\"Verify no crash when callback is None.\"\"\"\n137:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\")\n138:         await client._handle_incoming(json.dumps({\n139:             \"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": True\n140:         }))\n141: \n142:     async def test_set_auto_mode_callback_exception_caught(self):\n143:         \"\"\"Verify callback exception doesn't crash handler.\"\"\"\n144:         def bad_callback(mode, enabled):\n145:             raise RuntimeError(\"boom\")\n146:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=bad_callback)\n147:         await client._handle_incoming(json.dumps({\n148:             \"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": True\n149:         }))\n150: \n151: \n152: class TestHandleIncomingSetAutoModeInvalid(unittest.IsolatedAsyncioTestCase):\n153:     \"\"\"Test 2.1-2.3, 2.6-2.9, 2.12, 2.15: Edge cases for set_auto_mode validation.\n154:     \n155:     Verify invalid messages are silently dropped without calling callback.\n156:     \"\"\"\n157: \n158:     async def _assert_callback_not_called(self, msg):\n159:         callback = MagicMock()\n160:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n161:         await client._handle_incoming(json.dumps(msg))\n162:         callback.assert_not_called()\n163: \n164:     async def test_invalid_mode(self):\n165:         \"\"\"Edge case 2.6: Invalid mode value 'foo'.\"\"\"\n166:         await self._assert_callback_not_called(\n167:             {\"type\": \"set_auto_mode\", \"mode\": \"foo\", \"enabled\": True})\n168: \n169:     async def test_empty_mode(self):\n170:         \"\"\"Edge case 2.6: Empty mode string.\"\"\"\n171:         await self._assert_callback_not_called(\n172:             {\"type\": \"set_auto_mode\", \"mode\": \"\", \"enabled\": True})\n173: \n174:     async def test_missing_mode(self):\n175:         \"\"\"Edge case 2.6: Missing mode field.\"\"\"\n176:         await self._assert_callback_not_called(\n177:             {\"type\": \"set_auto_mode\", \"enabled\": True})\n178: \n179:     async def test_enabled_not_bool_string(self):\n180:         \"\"\"Edge case 2.8: enabled as string 'yes'.\"\"\"\n181:         await self._assert_callback_not_called(\n182:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": \"yes\"})\n183: \n184:     async def test_enabled_not_bool_int(self):\n185:         \"\"\"Edge case 2.8: enabled as integer 1.\"\"\"\n186:         await self._assert_callback_not_called(\n187:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": 1})\n188: \n189:     async def test_enabled_null(self):\n190:         \"\"\"Edge case 2.8: enabled as null.\"\"\"\n191:         await self._assert_callback_not_called(\n192:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": None})\n193: \n194:     async def test_missing_enabled(self):\n195:         \"\"\"Edge case 2.7: Missing enabled field.\"\"\"\n196:         await self._assert_callback_not_called(\n197:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\"})\n198: \n199:     async def test_missing_both(self):\n200:         \"\"\"Edge case 2.7: Missing both mode and enabled.\"\"\"\n201:         await self._assert_callback_not_called(\n202:             {\"type\": \"set_auto_mode\"})\n203: \n204:     async def test_null_mode(self):\n205:         \"\"\"Edge case 2.6: mode as null.\"\"\"\n206:         await self._assert_callback_not_called(\n207:             {\"type\": \"set_auto_mode\", \"mode\": None, \"enabled\": True})\n208: \n209:     async def test_non_json_message(self):\n210:         \"\"\"Edge case 2.12: Malformed JSON message.\"\"\"\n211:         callback = MagicMock()\n212:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n213:         await client._handle_incoming(\"hello\")\n214:         callback.assert_not_called()\n215: \n216:     async def test_case_sensitivity_plan_uppercase(self):\n217:         \"\"\"Edge case 2.15: 'PLAN' should be rejected.\"\"\"\n218:         await self._assert_callback_not_called(\n219:             {\"type\": \"set_auto_mode\", \"mode\": \"PLAN\", \"enabled\": True})\n220: \n221:     async def test_case_sensitivity_impl_uppercase(self):\n222:         \"\"\"Edge case 2.15: 'Impl' should be rejected.\"\"\"\n223:         await self._assert_callback_not_called(\n224:             {\"type\": \"set_auto_mode\", \"mode\": \"Impl\", \"enabled\": True})\n225: \n226: \n227: class TestCallbackWiring(unittest.IsolatedAsyncioTestCase):\n228:     \"\"\"Test callback wiring for on_set_auto_mode.\"\"\"\n229: \n230:     def test_on_set_auto_mode_stored_on_init(self):\n231:         \"\"\"Verify callback is stored when provided.\"\"\"\n232:         def cb(mode, enabled):\n233:             pass\n234:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\", on_set_auto_mode=cb)\n235:         assert sc._on_set_auto_mode is cb\n236: \n237:     def test_on_set_auto_mode_default_none(self):\n238:         \"\"\"Verify callback defaults to None.\"\"\"\n239:         sc = ServerClient(\"ws://localhost:8080\", \"key\", \"c\")\n240:         assert sc._on_set_auto_mode is None\n241: \n242: \n243: class TestAutoModeStateNotPresent(unittest.IsolatedAsyncioTestCase):\n244:     \"\"\"Edge case 2.1: Auto-mode state