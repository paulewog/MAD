tted answers).\"\"\"\n1237:         feature = FeatureFile.find(feature_id)\n1238:         if not feature:\n1239:             logger.warning(f\"answer_questions: feature {feature_id} not found\")\n1240:             return\n1241:         if feature.current_stage != \"requested-input\":\n1242:             logger.warning(f\"answer_questions: feature {feature_id} not in requested-input (is {feature.current_stage})\")\n1243:             return\n1244:         for i, a in enumerate(answers):\n1245:             ans_text = a.get(\"answer\", \"\")\n1246:             if ans_text:\n1247:                 feature.answer_question(i, ans_text)\n1248:         feature.add_history(\"PLAN-INBOX\", \"Questions answered via web UI\")\n1249:         feature.move_to_stage(\"plan-inbox\")\n1250:         self._refresh_board(self.active_board)\n1251:         if self._server_client and self._server_client.connected:\n1252:             features = self._load_features(self.active_board)\n1253:             await self._server_client.push_state(\n1254:                 features, self._plan_agent_status, self._implement_agent_status,\n1255:                 auto_plan_enabled=self.auto_plan_enabled,\n1256:                 auto_impl_enabled=self.auto_implement_enabled,\n1257:             )\n1258: \n1259:     def _handle_set_auto_mode(self, mode: str, enabled: bool) -> None:\n1260:         \"\"\"Handle set_auto_mode message from the server (web UI toggled auto mode).\"\"\"\n1261:         if mode == \"plan\":\n1262:             self.auto_plan_enabled = enabled\n1263:         elif mode == \"impl\":\n1264:             self.auto_implement_enabled = enabled\n1265:         self._update_status_bar(self.active_board, self._load_features(self.active_board))\n1266:         # Push updated state back to server\n1267:         if self._server_client and self._server_client.connected:\n1268:             features = self._load_features(self.active_board)\n1269:             self._push_to_server(features[:])\n\n(Showing lines 1210-1269 of 2627. Use offset=1270 to continue.)\n</content>","title":"pipeline/tui.py","metadata":{"preview":"            self._server_client = ServerClient(\n                url=server_cfg.url,\n                api_key=server_cfg.api_key,\n                client_id=server_cfg.client_id,\n                on_connect=self._on_server_connected,\n                on_answers_received=self._handle_server_answers,\n                on_set_auto_mode=self._handle_set_auto_mode,\n                on_start_agent=self._handle_start_agent,\n                on_idea_created=self._handle_create_idea,\n            )\n            self._connect_server()\n            self.set_interval(5.0, self._periodic_server_push)\n\n    def _periodic_server_push(self) -> None:\n        \"\"\"Push current state to server periodically (agent status may change without feature changes).\"\"\"\n        if self._server_client and self._server_client.connected:\n            features = getattr(self, \"_current_features\", [])\n            self._push_to_server(features[:])\n\n    @work(thread=False)","truncated":true,"loaded":[]},"time":{"start":1772833156993,"end":1772833156997}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at the key parts of tui.py to understand the callback wiring:","format":"anthropic-claude-v1","index":0,"signature":"b790e2008f21cad1d5ea1e159af9d27e6a432fe7a1f4396a5ffebf0f8d390ab4"}]}}}}
