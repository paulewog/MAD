{"type":"tool_use","timestamp":1772831805977,"sessionID":"ses_33afe223affe3uN9rDLMVQJuCQ","part":{"id":"prt_cc50290fd001VbiXyynAKa6jvJ","sessionID":"ses_33afe223affe3uN9rDLMVQJuCQ","messageID":"msg_cc5028378001heIhpVO7Xd9F0Z","type":"tool","callID":"call_function_s10qj6ddd35u_1","tool":"read","state":{"status":"completed","input":{"filePath":"/home/paule/MAD/server/api.go"},"output":"<path>/home/paule/MAD/server/api.go</path>\n<type>file</type>\n<content>1: package main\n2: \n3: import (\n4: \t\"embed\"\n5: \t\"encoding/json\"\n6: \t\"html/template\"\n7: \t\"io\"\n8: \t\"log\"\n9: \t\"net/http\"\n10: \t\"strings\"\n11: \n12: \t\"github.com/gorilla/websocket\"\n13: )\n14: \n15: var stageOrder = []string{\n16: \t\"ideas\", \"plan-inbox\", \"reviewing-plan\", \"requested-input\", \"approved\", \"spec-writing\",\n17: \t\"implementing\", \"testing\", \"review\", \"final-human-approval\", \"done\", \"rejected\",\n18: }\n19: \n20: // StageGroup holds features for a single stage, preserving order.\n21: type StageGroup struct {\n22: \tStage    string\n23: \tFeatures []FeatureSummary\n24: }\n25: \n26: // groupFeaturesByStage returns features organized by stage in canonical order.\n27: // Stages with zero features are included so the UI can show empty columns.\n28: func groupFeaturesByStage(features []FeatureSummary) []StageGroup {\n29: \tbyStage := make(map[string][]FeatureSummary)\n30: \tfor _, f := range features {\n31: \t\tbyStage[f.Stage] = append(byStage[f.Stage], f)\n32: \t}\n33: \tgroups := make([]StageGroup, 0, len(stageOrder))\n34: \tfor _, s := range stageOrder {\n35: \t\tgroups = append(groups, StageGroup{Stage: s, Features: byStage[s]})\n36: \t}\n37: \t// Include any stages not in the canonical list (defensive)\n38: \tfor stage, feats := range byStage {\n39: \t\tfound := false\n40: \t\tfor _, s := range stageOrder {\n41: \t\t\tif s == stage {\n42: \t\t\t\tfound = true\n43: \t\t\t\tbreak\n44: \t\t\t}\n45: \t\t}\n46: \t\tif !found {\n47: \t\t\tgroups = append(groups, StageGroup{Stage: stage, Features: feats})\n48: \t\t}\n49: \t}\n50: \treturn groups\n51: }\n52: \n53: //go:embed templates\n54: var templateFS embed.FS\n55: \n56: //go:embed static\n57: var staticFS embed.FS\n58: \n59: var upgrader = websocket.Upgrader{\n60: \tCheckOrigin: func(r *http.Request) bool { return true },\n61: }\n62: \n63: func checkAPIAuth(r *http.Request, apiKey string) bool {\n64: \tif apiKey == \"\" {\n65: \t\treturn true\n66: \t}\n67: \t// Check ?key= query parameter\n68: \tif r.URL.Query().Get(\"key\") == apiKey {\n69: \t\treturn true\n70: \t}\n71: \t// Check Authorization: Bearer <key>\n72: \tif auth := r.Header.Get(\"Authorization\"); auth != \"\" {\n73: \t\tif strings.HasPrefix(auth, \"Bearer \") && strings.TrimPrefix(auth, \"Bearer \") == apiKey {\n74: \t\t\treturn true\n75: \t\t}\n76: \t}\n77: \t// Check X-API-Key header\n78: \tif r.Header.Get(\"X-API-Key\") == apiKey {\n79: \t\treturn true\n80: \t}\n81: \treturn false\n82: }\n83: \n84: func checkDashboardAuth(r *http.Request, dashboardKey string) bool {\n85: \tif dashboardKey == \"\" {\n86: \t\treturn true\n87: \t}\n88: \treturn r.URL.Query().Get(\"key\") == dashboardKey\n89: }\n90: \n91: func writeJSON(w http.ResponseWriter, status int, v interface{}) {\n92: \tw.Header().Set(\"Content-Type\", \"application/json\")\n93: \tw.WriteHeader(status)\n94: \tjson.NewEncoder(w).Encode(v)\n95: }\n96: \n97: func registerRoutes(mux *http.ServeMux, hub *Hub, cfg *Config) {\n98: \tfuncMap := template.FuncMap{\n99: \t\t\"groupByStage\": groupFeaturesByStage,\n100: \t\t\"stageLabel\": func(s string) string {\n101: \t\t\treturn strings.ReplaceAll(s, \"-\", \" \")\n102: \t\t},\n103: \t\t\"toJSON\": func(v interface{}) string {\n104: \t\t\tb, _ := json.Marshal(v)\n105: \t\t\treturn string(b)\n106: \t\t},\n107: \t\t\"uniqueBoards\": func(features []FeatureSummary) string {\n108: \t\t\tseen := map[string]bool{}\n109: \t\t\tvar boards []string\n110: \t\t\tfor _, f := range features {\n111: \t\t\t\tif f.Board != \"\" && !seen[f.Board] {\n112: \t\t\t\t\tseen[f.Board] = true\n113: \t\t\t\t\tboards = append(boards, f.Board)\n114: \t\t\t\t}\n115: \t\t\t}\n116: \t\t\treturn strings.Join(boards, \", \")\n117: \t\t},\n118: \t}\n119: \ttmpl := template.Must(template.New(\"\").Funcs(funcMap).ParseFS(templateFS, \"templates/*.html\"))\n120: \n121: \t// Static files\n122: \tmux.Handle(\"/static/\", http.FileServer(http.FS(staticFS)))\n123: \n124: \t// Dashboard page\n125: \tmux.HandleFunc(\"/\", func(w http.ResponseWriter, r *http.Request) {\n126: \t\t// Only handle exact \"/\" path; let other handlers catch their paths\n127: \t\tpath := r.URL.Path\n128: \t\tif path != \"/\" {\n129: \t\t\t// Check if it matches /clients/{id}\n130: \t\t\tif strings.HasPrefix(path, \"/clients/\") {\n131: \t\t\t\tserveClientPage(w, r, hub, tmpl, cfg)\n132: \t\t\t\treturn\n133: \t\t\t}\n134: \t\t\thttp.NotFound(w, r)\n135: \t\t\treturn\n136: \t\t}\n137: \t\tkey := r.URL.Query().Get(\"key\")\n138: \t\tauthenticated := key != \"\" && (cfg.DashboardKey == \"\" || key == cfg.DashboardKey)\n139: \t\tclients := hub.ListClients()\n140: \t\t// Aggregate all features across all clients, stamping client ID\n141: \t\tvar allFeatures []FeatureSummary\n142: \t\tfor _, c := range clients {\n143: \t\t\tfor _, f := range c.Features {\n144: \t\t\t\tf.ClientID = c.ClientID\n145: \t\t\t\tallFeatures = append(allFeatures, f)\n146: \t\t\t}\n147: \t\t}\n148: \t\tdata := map[string]interface{}{\n149: \t\t\t\"Clients\":       clients,\n150: \t\t\t\"Key\":           key,\n151: \t\t\t\"Authenticated\": authenticated,\n152: \t\t\t\"StageGroups\":   groupFeaturesByStage(allFeatures),\n153: \t\t}\n154: \t\tw.Header().Set(\"Content-Type\", \"text/html\")\n155: \t\tif err := tmpl.ExecuteTemplate(w, \"index.html\", data); err != nil {\n156: \t\t\tlog.Printf(\"template error: %v\", err)\n157: \t\t\thttp.Error(w, \"internal server error\", 500)\n158: \t\t}\n159: \t})\n160: \n161: \t// API: list clients (and sub-paths /api/clients/{id}, /api/clients/{id}/logs)\n162: \tapiClientsHandler := func(w http.ResponseWriter, r *http.Request) {\n163: \t\t// Check if this is /api/clients/{id} or /api/clients/{id}/logs\n164: \t\ttrimmed := strings.TrimPrefix(r.URL.Path, \"/api/clients\")\n165: \t\ttrimmed = strings.TrimPrefix(trimmed, \"/\")\n166: \t\tif trimmed != \"\" {\n167: \t\t\tparts := strings.SplitN(trimmed, \"/\", 2)\n168: \t\t\tclientID := parts[0]\n169: \t\t\tif len(parts) == 2 {\n170: \t\t\t\tsub := parts[1]\n171: \t\t\t\tif sub == \"logs\" {\n172: \t\t\t\t\tserveClientLogs(w, r, hub, cfg, clientID)\n173: \t\t\t\t\treturn\n174: \t\t\t\t}\n175: \t\t\t\tif sub == \"auto-mode\" {\n176: \t\t\t\t\tserveAutoMode(w, r, hub, cfg, clientID)\n177: \t\t\t\t\treturn\n178: \t\t\t\t}\n179: \t\t\t\tif sub == \"ideas\" {\n180: \t\t\t\t\tserveCreateIdea(w, r, hub, cfg, clientID)\n181: \t\t\t\t\treturn\n182: \t\t\t\t}\n183: \t\t\t\t// Match features/{fid}/answers or features/{fid}/start-agent\n184: \t\t\t\tif strings.HasPrefix(sub, \"features/\") {\n185: \t\t\t\t\tfeatureParts := strings.SplitN(strings.TrimPrefix(sub, \"features/\"), \"/\", 2)\n186: \t\t\t\t\tfeatureID := featureParts[0]\n187: \t\t\t\t\tif len(featureParts) == 2 && featureParts[1] == \"answers\" && featureID != \"\" {\n188: \t\t\t\t\t\tserveSubmitAnswers(w, r, hub, cfg, clientID, featureID)\n189: \t\t\t\t\t\treturn\n190: \t\t\t\t\t}\n191: \t\t\t\t\tif len(featureParts) == 2 && featureParts[1] == \"start-agent\" && featureID != \"\" {\n192: \t\t\t\t\t\tserveStartAgent(w, r, hub, cfg, clientID, featureID)\n193: \t\t\t\t\t\treturn\n194: \t\t\t\t\t}\n195: \t\t\t\t}\n196: \t\t\t}\n197: \t\t\tserveClientJSON(w, r, hub, cfg, clientID)\n198: \t\t\treturn\n199: \t\t}\n200: \n201: \t\tif !checkAPIAuth(r, cfg.APIKey) {\n202: \t\t\twriteJSON(w, http.StatusUnauthorized, map[string]string{\"error\": \"unauthorized\"})\n203: \t\t\treturn\n204: \t\t}\n205: \n206: \t\tclients := hub.ListClients()\n207: \t\tkey := r.URL.Query().Get(\"key\")\n208: \n209: \t\t// If HTMX request, return HTML fragment\n210: \t\tif r.Header.Get(\"HX-Request\") != \"\" {\n211: \t\t\tw.Header().Set(\"Content-Type\", \"text/html\")\n212: \t\t\tdata := map[string]interface{}{\n213: \t\t\t\t\"Clients\": clients,\n214: \t\t\t\t\"Key\":     key,\n215: \t\t\t}\n216: \t\t\tif err := tmpl.ExecuteTemplate(w, \"client_rows\", data); err != nil {\n217: \t\t\t\tlog.Printf(\"template error: %v\", err)\n218: \t\t\t\thttp.Error(w, \"internal server error\", 500)\n219: \t\t\t}\n220: \t\t\treturn\n221: \t\t}\n222: \n223: \t\twriteJSON(w, http.StatusOK, clients)\n224: \t}\n225: \tmux.HandleFunc(\"/api/clients\", apiClientsHandler)\n226: \tmux.HandleFunc(\"/api/clients/\", apiClientsHandler)\n227: \n228: \t// HTMX fragment: board view (all features grouped by stage)\n229: \tmux.HandleFunc(\"/api/board\", func(w http.ResponseWriter, r *http.Request) {\n230: \t\tif !checkDashboardAuth(r, cfg.DashboardKey) {\n231: \t\t\thttp.Error(w, \"unauthorized\", http.StatusUnauthorized)\n232: \t\t\treturn\n233: \t\t}\n234: \t\tclients := hub.ListClients()\n235: \t\tvar allFeatures []FeatureSummary\n236: \t\tfor _, c := range clients {\n237: \t\t\tfor _, f := range c.Features {\n238: \t\t\t\tf.ClientID = c.ClientID\n239: \t\t\t\tallFeatures = append(allFeatures, f)\n240: \t\t\t}\n241: \t\t}\n242: \t\tw.Header().Set(\"Content-Type\", \"text/html\")\n243: \t\tdata := map[string]interface{}{\n244: \t\t\t\"StageGroups\": groupFeaturesByStage(allFeatures),\n245: \t\t\t\"Key\":         r.URL.Query().Get(\"key\"),\n246: \t\t}\n247: \t\tif err := tmpl.ExecuteTemplate(w, \"board_fragment\", data); err != nil {\n248: \t\t\tlog.Printf(\"template error: %v\", err)\n249: \t\t\thttp.Error(w, \"internal server error\", 500)\n250: \t\t}\n251: \t})\n252: \n253: \t// Favicon\n254: \tmux.HandleFunc(\"/favicon.svg\", func(w http.ResponseWriter, r *http.Request) {\n255: \t\tdata, err := staticFS.ReadFile(\"static/favicon.svg\")\n256: \t\tif err != nil {\n257: \t\t\thttp.NotFound(w, r)\n258: \t\t\treturn\n259: \t\t}\n260: \t\tw.Header().Set(\"Content-Type\", \"image/svg+xml\")\n261: \t\tw.Header().Set(\"Cache-Control\", \"public, max-age=86400\")\n262: \t\tw.Write(data)\n263: \t})\n264: \n265: \t// Service worker (served from root for scope)\n266: \tmux.HandleFunc(\"/sw.js\", func(w http.ResponseWriter, r *http.Request) {\n267: \t\tdata, err := staticFS.ReadFile(\"static/sw.js\")\n268: \t\tif err != nil {\n269: \t\t\thttp.NotFound(w, r)\n270: \t\t\treturn\n271: \t\t}\n272: \t\tw.Header().Set(\"Content-Type\", \"application/javascript\")\n273: \t\tw.Header().Set(\"Service-Worker-Allowed\", \"/\")\n274: \t\tw.Header().Set(\"Cache-Control\", \"no-cache\")\n275: \t\tw.Write(data)\n276: \t})\n277: \n278: \t// WebSocket endpoint\n279: \tmux.HandleFunc(\"/ws\", func(w http.ResponseWriter, r *http.Request) {\n280: \t\t// Auth via query param or header\n281: \t\tauthorized := false\n282: \t\tif cfg.APIKey == \"\" {\n283: \t\t\tauthorized = true\n284: \t\t} else {\n285: \t\t\tif r.URL.Query().Get(\"api_key\") == cfg.APIKey {\n286: \t\t\t\tauthorized = true\n287: \t\t\t} else if checkAPIAuth(r, cfg.APIKey) {\n288: \t\t\t\tauthorized = true\n289: \t\t\t}\n290: \t\t}\n291: \t\tif !authorized {\n292: \t\t\twriteJSON(w, http.StatusUnauthorized, map[string]string{\"error\": \"unauthorized\"})\n293: \t\t\treturn\n294: \t\t}\n295: \n296: \t\tconn, err := upgrader.Upgrade(w, r, nil)\n297: \t\tif err != nil {\n298: \t\t\tlog.Printf(\"websocket upgrade error: %v\", err)\n299: \t\t\treturn\n300: \t\t}\n301: \n302: \t\tclient := &Client{\n303: \t\t\thub:      hub,\n304: \t\t\tconn:     conn,\n305: \t\t\tsend:     make(chan []byte, 256),\n306: \t\t\tclientID: \"unknown\",\n307: \t\t\tstate: &ClientState{\n308: \t\t\t\tClientID:  \"unknown\",\n309: \t\t\t\tFeatures:  []FeatureSummary{},\n310: \t\t\t\tLogs:      []LogEntry{},\n311: \t\t\t\tConnected: true,\n312: \t\t\t},\n313: \t\t}\n314: \n315: \t\thub.register <- client\n316: \t\tgo client.writePump()\n317: \t\tgo client.readPump()\n318: \t})\n319: }\n320: \n321: func serveSubmitAnswers(w http.ResponseWriter, r *http.Request, hub *Hub, cfg *Config, clientID string, featureID string) {\n322: \tif r.Method != http.MethodPost {\n323: \t\twriteJSON(w, http.StatusMethodNotAllowed, map[string]string{\"error\": \"method not allowed\"})\n324: \t\treturn\n325: \t}\n326: \tif !checkDashboardAuth(r, cfg.DashboardKey) && !checkAPIAuth(r, cfg.APIKey) {\n327: \t\twriteJSON(w, http.StatusUnauthorized, map[string]string{\"error\": \"unauthorized\"})\n328: \t\treturn\n329: \t}\n330: \n331: \t// Parse request body\n332: \tbody, err := io.ReadAll(io.LimitReader(r.Body, 1*1024*1024))\n333: \tif err != nil {\n334: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"failed to read body\"})\n335: \t\treturn\n336: \t}\n337: \tvar req struct {\n338: \t\tAnswers []QuestionAnswer `json:\"answers\"`\n339: \t}\n340: \tif err := json.Unmarshal(body, &req); err != nil {\n341: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"invalid JSON\"})\n342: \t\treturn\n343: \t}\n344: \n345: \t// Validate client exists and is connected\n346: \tstate, ok := hub.GetClient(clientID)\n347: \tif !ok {\n348: \t\twriteJSON(w, http.StatusNotFound, map[string]string{\"error\": \"client not found\"})\n349: \t\treturn\n350: \t}\n351: \tif !state.Connected {\n352: \t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": \"client not connected\"})\n353: \t\treturn\n354: \t}\n355: \n356: \t// Validate feature exists and is in requested-input stage\n357: \tvar found bool\n358: \tfor _, f := range state.Features {\n359: \t\tif f.ID == featureID {\n360: \t\t\tfound = true\n361: \t\t\tif f.Stage != \"requested-input\" {\n362: \t\t\t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": \"feature not in requested-input stage\"})\n363: \t\t\t\treturn\n364: \t\t\t}\n365: \t\t\tbreak\n366: \t\t}\n367: \t}\n368: \tif !found {\n369: \t\twriteJSON(w, http.StatusNotFound, map[string]string{\"error\": \"feature not found\"})\n370: \t\treturn\n371: \t}\n372: \n373: \t// Send answer_questions message to client via WebSocket\n374: \tmsg, _ := json.Marshal(map[string]interface{}{\n375: \t\t\"type\":       \"answer_questions\",\n376: \t\t\"feature_id\": featureID,\n377: \t\t\"answers\":    req.Answers,\n378: \t})\n379: \tif err := hub.SendToClient(clientID, msg); err != nil {\n380: \t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": err.Error()})\n381: \t\treturn\n382: \t}\n383: \n384: \twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n385: }\n386: \n387: func serveAutoMode(w http.ResponseWriter, r *http.Request, hub *Hub, cfg *Config, clientID string) {\n388: \tif r.Method != http.MethodPost {\n389: \t\twriteJSON(w, http.StatusMethodNotAllowed, map[string]string{\"error\": \"method not allowed\"})\n390: \t\treturn\n391: \t}\n392: \tif !checkDashboardAuth(r, cfg.DashboardKey) && !checkAPIAuth(r, cfg.APIKey) {\n393: \t\twriteJSON(w, http.StatusUnauthorized, map[string]string{\"error\": \"unauthorized\"})\n394: \t\treturn\n395: \t}\n396: \n397: \tbody, err := io.ReadAll(io.LimitReader(r.Body, 1*1024*1024))\n398: \tif err != nil {\n399: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"failed to read body\"})\n400: \t\treturn\n401: \t}\n402: \tvar req struct {\n403: \t\tMode    string `json:\"mode\"`\n404: \t\tEnabled bool   `json:\"enabled\"`\n405: \t}\n406: \tif err := json.Unmarshal(body, &req); err != nil {\n407: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"invalid JSON\"})\n408: \t\treturn\n409: \t}\n410: \tif req.Mode != \"plan\" && req.Mode != \"impl\" {\n411: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"invalid mode\"})\n412: \t\treturn\n413: \t}\n414: \n415: \tstate, ok := hub.GetClient(clientID)\n416: \tif !ok {\n417: \t\twriteJSON(w, http.StatusNotFound, map[string]string{\"error\": \"client not found\"})\n418: \t\treturn\n419: \t}\n420: \tif !state.Connected {\n421: \t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": \"client not connected\"})\n422: \t\treturn\n423: \t}\n424: \n425: \tmsg, _ := json.Marshal(map[string]interface{}{\n426: \t\t\"type\":    \"set_auto_mode\",\n427: \t\t\"mode\":    req.Mode,\n428: \t\t\"enabled\": req.Enabled,\n429: \t})\n430: \tif err := hub.SendToClient(clientID, msg); err != nil {\n431: \t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": err.Error()})\n432: \t\treturn\n433: \t}\n434: \n435: \twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n436: }\n437: \n438: func serveStartAgent(w http.ResponseWriter, r *http.Request, hub *Hub, cfg *Config, clientID string, featureID string) {\n439: \tif r.Method != http.MethodPost {\n440: \t\twriteJSON(w, http.StatusMethodNotAllowed, map[string]string{\"error\": \"method not allowed\"})\n441: \t\treturn\n442: \t}\n443: \tif !checkDashboardAuth(r, cfg.DashboardKey) && !checkAPIAuth(r, cfg.APIKey) {\n444: \t\twriteJSON(w, http.StatusUnauthorized, map[string]string{\"error\": \"unauthorized\"})\n445: \t\treturn\n446: \t}\n447: \n448: \tbody, err := io.ReadAll(io.LimitReader(r.Body, 1*1024*1024))\n449: \tif err != nil {\n450: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"failed to read body\"})\n451: \t\treturn\n452: \t}\n453: \tvar req struct {\n454: \t\tAction string `json:\"action\"`\n455: \t}\n456: \tif err := json.Unmarshal(body, &req); err != nil {\n457: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"invalid JSON\"})\n458: \t\treturn\n459: \t}\n460: \tif req.Action != \"plan\" && req.Action != \"implement\" {\n461: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"invalid action, must be 'plan' or 'implement'\"})\n462: \t\treturn\n463: \t}\n464: \n465: \tstate, ok := hub.GetClient(clientID)\n466: \tif !ok {\n467: \t\twriteJSON(w, http.StatusNotFound, map[string]string{\"error\": \"client not found\"})\n468: \t\treturn\n469: \t}\n470: \tif !state.Connected {\n471: \t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": \"client not connected\"})\n472: \t\treturn\n473: \t}\n474: \n475: \t// Find feature and validate stage\n476: \tvar feature *FeatureSummary\n477: \tfor i := range state.Features {\n478: \t\tif state.Features[i].ID == featureID {\n479: \t\t\tfeature = &state.Features[i]\n480: \t\t\tbreak\n481: \t\t}\n482: \t}\n483: \tif feature == nil {\n484: \t\twriteJSON(w, http.StatusNotFound, map[string]string{\"error\": \"feature not found\"})\n485: \t\treturn\n486: \t}\n487: \n488: \t// Check stage is allowed for this action\n489: \tallowedStages, hasAction := state.StageActions[req.Action]\n490: \tif !hasAction {\n491: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"stage actions not available\"})\n492: \t\treturn\n493: \t}\n494: \tstageAllowed := false\n495: \tfor _, s := range allowedStages {\n496: \t\tif s == feature.Stage {\n497: \t\t\tstageAllowed = true\n498: \t\t\tbreak\n499: \t\t}\n500: \t}\n501: \tif !stageAllowed {\n502: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"feature stage '\" + feature.Stage + \"' not valid for action '\" + req.Action + \"'\"})\n503: \t\treturn\n504: \t}\n505: \n506: \t// Check agent not busy\n507: \tif req.Action == \"plan\" && state.PlanAgent.Running {\n508: \t\twriteJSON(w, http.StatusConflict, map[string]string{\"error\": \"plan agent is already running\"})\n509: \t\treturn\n510: \t}\n511: \tif req.Action == \"implement\" && state.ImplAgent.Running {\n512: \t\twriteJSON(w, http.StatusConflict, map[string]string{\"error\": \"implement agent is already running\"})\n513: \t\treturn\n514: \t}\n515: \n516: \t// Send start_agent message to client via WebSocket\n517: \tmsg, _ := json.Marshal(map[string]interface{}{\n518: \t\t\"type\":       \"start_agent\",\n519: \t\t\"feature_id\": featureID,\n520: \t\t\"action\":     req.Action,\n521: \t})\n522: \tif err := hub.SendToClient(clientID, msg); err != nil {\n523: \t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": err.Error()})\n524: \t\treturn\n525: \t}\n526: \n527: \twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n528: }\n529: \n530: func serveClientPage(w http.ResponseWriter, r *http.Request, hub *Hub, tmpl *template.Template, cfg *Config) {\n531: \tpath := strings.TrimPrefix(r.URL.Path, \"/clients/\")\n532: \tpath = strings.TrimSuffix(path, \"/\")\n533: \tparts := strings.SplitN(path, \"/\", 2)\n534: \tclientID := parts[0]\n535: \tif clientID == \"\" {\n536: \t\thttp.NotFound(w, r)\n537: \t\treturn\n538: \t}\n539: \n540: \tstate, ok := hub.GetClient(clientID)\n541: \tif !ok {\n542: \t\thttp.NotFound(w, r)\n543: \t\treturn\n544: \t}\n545: \n546: \tkey := r.URL.Query().Get(\"key\")\n547: \n548: \t// Check for sub-resource (HTMX fragment endpoints)\n549: \tif len(parts) == 2 {\n550: \t\tw.Header().Set(\"Content-Type\", \"text/html\")\n551: \t\tswitch parts[1] {\n552: \t\tcase \"features\":\n553: \t\t\tfdata := map[string]interface{}{\n554: \t\t\t\t\"StageGroups\": groupFeaturesByStage(state.Features),\n555: \t\t\t\t\"Key\":         key,\n556: \t\t\t}\n557: \t\t\tif err := tmpl.ExecuteTemplate(w, \"feature_stages\", fdata); err != nil {\n558: \t\t\t\tlog.Printf(\"template error: %v\", err)\n559: \t\t\t\thttp.Error(w, \"internal server error\", 500)\n560: \t\t\t}\n561: \t\t\treturn\n562: \t\tcase \"logs\":\n563: \t\t\tif err := tmpl.ExecuteTemplate(w, \"log_entries\", state.Logs); err != nil {\n564: \t\t\t\tlog.Printf(\"template error: %v\", err)\n565: \t\t\t\thttp.Error(w, \"internal server error\", 500)\n566: \t\t\t}\n567: \t\t\treturn\n568: \t\t}\n569: \t\thttp.NotFound(w, r)\n570: \t\treturn\n571: \t}\n572: \n573: \tdata := map[string]interface{}{\n574: \t\t\"ClientID\":    state.ClientID,\n575: \t\t\"Features\":    state.Features,\n576: \t\t\"StageGroups\": groupFeaturesByStage(state.Features),\n577: \t\t\"Logs\":        state.Logs,\n578: \t\t\"LastSeen\":    state.LastSeen,\n579: \t\t\"Connected\":   state.Connected,\n580: \t\t\"PlanAgent\":   state.PlanAgent,\n581: \t\t\"ImplAgent\":   state.ImplAgent,\n582: \t\t\"AutoPlan\":    state.AutoPlan,\n583: \t\t\"AutoImpl\":    state.AutoImpl,\n584: \t\t\"Key\":         key,\n585: \t}\n586: \tw.Header().Set(\"Content-Type\", \"text/html\")\n587: \tif err := tmpl.ExecuteTemplate(w, \"client.html\", data); err != nil {\n588: \t\tlog.Printf(\"template error: %v\", err)\n589: \t\thttp.Error(w, \"internal server error\", 500)\n590: \t}\n591: }\n592: \n593: func serveClientJSON(w http.ResponseWriter, r *http.Request, hub *Hub, cfg *Config, clientID string) {\n594: \tif !checkAPIAuth(r, cfg.APIKey) && !checkDashboardAuth(r, cfg.DashboardKey) {\n595: \t\twriteJSON(w, http.StatusUnauthorized, map[string]string{\"error\": \"unauthorized\"})\n596: \t\treturn\n597: \t}\n598: \tstate, ok := hub.GetClient(clientID)\n599: \tif !ok {\n600: \t\twriteJSON(w, http.StatusNotFound, map[string]string{\"error\": \"client not found\"})\n601: \t\treturn\n602: \t}\n603: \twriteJSON(w, http.StatusOK, state)\n604: }\n605: \n606: func serveClientLogs(w http.ResponseWriter, r *http.Request, hub *Hub, cfg *Config, clientID string) {\n607: \tif !checkAPIAuth(r, cfg.APIKey) {\n608: \t\twriteJSON(w, http.StatusUnauthorized, map[string]string{\"error\": \"unauthorized\"})\n609: \t\treturn\n610: \t}\n611: \tstate, ok := hub.GetClient(clientID)\n612: \tif !ok {\n613: \t\twriteJSON(w, http.StatusNotFound, map[string]string{\"error\": \"client not found\"})\n614: \t\treturn\n615: \t}\n616: \twriteJSON(w, http.StatusOK, state.Logs)\n617: }\n618: \n619: type createIdeaData struct {\n620: \tTitle       string `json:\"title\"`\n621: \tBoard       string `json:\"board\"`\n622: \tDescription string `json:\"description\"`\n623: }\n624: \n625: func serveCreateIdea(w http.ResponseWriter, r *http.Request, hub *Hub, cfg *Config, clientID string) {\n626: \tif r.Method != http.MethodPost {\n627: \t\twriteJSON(w, http.StatusMethodNotAllowed, map[string]string{\"error\": \"method not allowed\"})\n628: \t\treturn\n629: \t}\n630: \tif !checkDashboardAuth(r, cfg.DashboardKey) && !checkAPIAuth(r, cfg.APIKey) {\n631: \t\twriteJSON(w, http.StatusUnauthorized, map[string]string{\"error\": \"unauthorized\"})\n632: \t\treturn\n633: \t}\n634: \n635: \tbody, err := io.ReadAll(io.LimitReader(r.Body, 1*1024*1024))\n636: \tif err != nil {\n637: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"failed to read body\"})\n638: \t\treturn\n639: \t}\n640: \n641: \tvar idea createIdeaData\n642: \tif err := json.Unmarshal(body, &idea); err != nil {\n643: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"invalid JSON\"})\n644: \t\treturn\n645: \t}\n646: \n647: \tif strings.TrimSpace(idea.Title) == \"\" {\n648: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"title is required\"})\n649: \t\treturn\n650: \t}\n651: \tif strings.TrimSpace(idea.Board) == \"\" {\n652: \t\twriteJSON(w, http.StatusBadRequest, map[string]string{\"error\": \"board is required\"})\n653: \t\treturn\n654: \t}\n655: \n656: \tstate, ok := hub.GetClient(clientID)\n657: \tif !ok {\n658: \t\twriteJSON(w, http.StatusNotFound, map[string]string{\"error\": \"client not found\"})\n659: \t\treturn\n660: \t}\n661: \tif !state.Connected {\n662: \t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": \"client not connected\"})\n663: \t\treturn\n664: \t}\n665: \n666: \tmsg, _ := json.Marshal(map[string]interface{}{\n667: \t\t\"type\":        \"create_idea\",\n668: \t\t\"title\":       idea.Title,\n669: \t\t\"board\":       idea.Board,\n670: \t\t\"description\": idea.Description,\n671: \t})\n672: \tif err := hub.SendToClient(clientID, msg); err != nil {\n673: \t\twriteJSON(w, http.StatusUnprocessableEntity, map[string]string{\"error\": err.Error()})\n674: \t\treturn\n675: \t}\n676: \n677: \twriteJSON(w, http.StatusOK, 