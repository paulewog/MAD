{"type":"tool_use","timestamp":1772832518810,"sessionID":"ses_33af36f0dffeDPOoVH0pbC35lL","part":{"id":"prt_cc50d7244001flHwZq4ZSTic4q","sessionID":"ses_33af36f0dffeDPOoVH0pbC35lL","messageID":"msg_cc50d647e001RPLTH8th8PwQ21","type":"tool","callID":"call_function_uatkpb3gzj2m_1","tool":"read","state":{"status":"completed","input":{"filePath":"/home/paule/MAD/pipeline/test_auto_mode.py"},"output":"<path>/home/paule/MAD/pipeline/test_auto_mode.py</path>\n<type>file</type>\n<content>1: \"\"\"Tests for auto-plan/auto-impl WebSocket controls in ServerClient.\"\"\"\n2: \n3: import asyncio\n4: import json\n5: import unittest\n6: from unittest.mock import AsyncMock, MagicMock, patch\n7: \n8: import sys, os\n9: sys.path.insert(0, os.path.dirname(__file__))\n10: \n11: from server_client import ServerClient\n12: \n13: \n14: class TestPushStateAutoMode(unittest.IsolatedAsyncioTestCase):\n15:     \"\"\"Test that push_state() includes auto_plan and auto_impl booleans.\"\"\"\n16: \n17:     async def _make_connected_client(self):\n18:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test-client\")\n19:         client._connected = True\n20:         client._ws = AsyncMock()\n21:         client._ws.send = AsyncMock()\n22:         return client\n23: \n24:     async def test_push_state_includes_auto_plan_true_auto_impl_false(self):\n25:         client = await self._make_connected_client()\n26:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=False)\n27:         sent = json.loads(client._ws.send.call_args[0][0])\n28:         self.assertTrue(sent[\"auto_plan\"])\n29:         self.assertFalse(sent[\"auto_impl\"])\n30: \n31:     async def test_push_state_both_false_by_default(self):\n32:         client = await self._make_connected_client()\n33:         await client.push_state([])\n34:         sent = json.loads(client._ws.send.call_args[0][0])\n35:         self.assertFalse(sent[\"auto_plan\"])\n36:         self.assertFalse(sent[\"auto_impl\"])\n37: \n38:     async def test_push_state_both_true(self):\n39:         client = await self._make_connected_client()\n40:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=True)\n41:         sent = json.loads(client._ws.send.call_args[0][0])\n42:         self.assertTrue(sent[\"auto_plan\"])\n43:         self.assertTrue(sent[\"auto_impl\"])\n44: \n45:     async def test_push_state_not_connected_returns_early(self):\n46:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test-client\")\n47:         client._connected = False\n48:         client._ws = None\n49:         # Should not raise\n50:         await client.push_state([], auto_plan_enabled=True, auto_impl_enabled=True)\n51: \n52: \n53: class TestHandleIncomingSetAutoMode(unittest.IsolatedAsyncioTestCase):\n54:     \"\"\"Test _handle_incoming() for set_auto_mode messages.\"\"\"\n55: \n56:     async def test_set_auto_mode_plan_true(self):\n57:         callback = MagicMock()\n58:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n59:         await client._handle_incoming(json.dumps({\n60:             \"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": True\n61:         }))\n62:         callback.assert_called_once_with(\"plan\", True)\n63: \n64:     async def test_set_auto_mode_impl_false(self):\n65:         callback = MagicMock()\n66:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n67:         await client._handle_incoming(json.dumps({\n68:             \"type\": \"set_auto_mode\", \"mode\": \"impl\", \"enabled\": False\n69:         }))\n70:         callback.assert_called_once_with(\"impl\", False)\n71: \n72:     async def test_set_auto_mode_no_callback_no_crash(self):\n73:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\")\n74:         # Should not raise\n75:         await client._handle_incoming(json.dumps({\n76:             \"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": True\n77:         }))\n78: \n79:     async def test_set_auto_mode_callback_exception_caught(self):\n80:         def bad_callback(mode, enabled):\n81:             raise RuntimeError(\"boom\")\n82:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=bad_callback)\n83:         # Should not raise\n84:         await client._handle_incoming(json.dumps({\n85:             \"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": True\n86:         }))\n87: \n88: \n89: class TestHandleIncomingSetAutoModeInvalid(unittest.IsolatedAsyncioTestCase):\n90:     \"\"\"Test that invalid set_auto_mode messages are silently dropped.\"\"\"\n91: \n92:     async def _assert_callback_not_called(self, msg):\n93:         callback = MagicMock()\n94:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n95:         await client._handle_incoming(json.dumps(msg))\n96:         callback.assert_not_called()\n97: \n98:     async def test_invalid_mode(self):\n99:         await self._assert_callback_not_called(\n100:             {\"type\": \"set_auto_mode\", \"mode\": \"foo\", \"enabled\": True})\n101: \n102:     async def test_empty_mode(self):\n103:         await self._assert_callback_not_called(\n104:             {\"type\": \"set_auto_mode\", \"mode\": \"\", \"enabled\": True})\n105: \n106:     async def test_missing_mode(self):\n107:         await self._assert_callback_not_called(\n108:             {\"type\": \"set_auto_mode\", \"enabled\": True})\n109: \n110:     async def test_enabled_not_bool_string(self):\n111:         await self._assert_callback_not_called(\n112:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": \"yes\"})\n113: \n114:     async def test_enabled_not_bool_int(self):\n115:         await self._assert_callback_not_called(\n116:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": 1})\n117: \n118:     async def test_enabled_null(self):\n119:         await self._assert_callback_not_called(\n120:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\", \"enabled\": None})\n121: \n122:     async def test_missing_enabled(self):\n123:         await self._assert_callback_not_called(\n124:             {\"type\": \"set_auto_mode\", \"mode\": \"plan\"})\n125: \n126:     async def test_missing_both(self):\n127:         await self._assert_callback_not_called(\n128:             {\"type\": \"set_auto_mode\"})\n129: \n130:     async def test_null_mode(self):\n131:         await self._assert_callback_not_called(\n132:             {\"type\": \"set_auto_mode\", \"mode\": None, \"enabled\": True})\n133: \n134:     async def test_non_json_message(self):\n135:         callback = MagicMock()\n136:         client = ServerClient(\"ws://localhost:9999\", \"key\", \"test\", on_set_auto_mode=callback)\n137:         await client._handle_incoming(\"hello\")\n138:         callback.assert_not_called()\n139: \n140: \n141: if __name__ == \"__main__\":\n142:     unittest.main()\n\n(End of file - total 142 lines)\n</content>","title":"pipeline/test_auto_mode.py","metadata":{"preview":"\"\"\"Tests for auto-plan/auto-impl WebSocket controls in ServerClient.\"\"\"\n\nimport asyncio\nimport json\nimport unittest\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nimport sys, os\nsys.path.insert(0, os.path.dirname(__file__))\n\nfrom server_client import ServerClient\n\n\nclass TestPushStateAutoMode(unittest.IsolatedAsyncioTestCase):\n    \"\"\"Test that push_state() includes auto_plan and auto_impl booleans.\"\"\"\n\n    async def _make_connected_client(self):\n        client = ServerClient(\"ws://localhost:9999\", \"key\", \"test-client\")\n        client._connected = True\n        client._ws = AsyncMock()","truncated":false,"loaded":[]},"time":{"start":1772832518806,"end":1772832518809}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"There's a test file sp