{"type":"tool_use","timestamp":1772831854231,"sessionID":"ses_33afd20a3ffeZmbv7l8qdy6dCL","part":{"id":"prt_cc5034e08001kK3xafUlxYIA1C","sessionID":"ses_33afd20a3ffeZmbv7l8qdy6dCL","messageID":"msg_cc5033a98001HyELdR0xWSPviZ","type":"tool","callID":"call_function_7f6fg4x54tf9_1","tool":"read","state":{"status":"completed","input":{"filePath":"/home/paule/MAD/server/templates/index.html"},"output":"<path>/home/paule/MAD/server/templates/index.html</path>\n<type>file</type>\n<content>1: <!DOCTYPE html>\n2: <html lang=\"en\">\n3: <head>\n4:     <meta charset=\"UTF-8\">\n5:     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n6:     <title>MAD Pipeline Dashboard</title>\n7:     <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\n8:     <link rel=\"manifest\" href=\"/static/manifest.json\">\n9:     <meta name=\"theme-color\" content=\"#0d1117\">\n10:     <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n11:     <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n12:     <link rel=\"apple-touch-icon\" href=\"/static/icon-192.png\">\n13:     <script src=\"https://unpkg.com/htmx.org@2.0.4\"></script>    <style>\n14:         * { margin: 0; padding: 0; box-sizing: border-box; }\n15:         body {\n16:             font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, monospace;\n17:             background: #0d1117;\n18:             color: #c9d1d9;\n19:             padding: 2rem;\n20:         }\n21:         h1, h2 {\n22:             color: #58a6ff;\n23:             font-weight: 600;\n24:         }\n25:         h1 { font-size: 1.5rem; margin-bottom: 1.5rem; }\n26:         h2 { font-size: 1.1rem; margin: 2rem 0 1rem 0; }\n27:         table {\n28:             width: 100%;\n29:             border-collapse: collapse;\n30:             background: #161b22;\n31:             border-radius: 6px;\n32:             overflow: hidden;\n33:         }\n34:         th, td {\n35:             text-align: left;\n36:             padding: 0.75rem 1rem;\n37:             border-bottom: 1px solid #21262d;\n38:         }\n39:         th {\n40:             background: #1c2128;\n41:             color: #8b949e;\n42:             font-weight: 600;\n43:             font-size: 0.85rem;\n44:             text-transform: uppercase;\n45:             letter-spacing: 0.05em;\n46:         }\n47:         tr:hover td { background: #1c2128; }\n48:         a { color: #58a6ff; text-decoration: none; }\n49:         a:hover { text-decoration: underline; }\n50:         .status-dot {\n51:             display: inline-block;\n52:             width: 8px;\n53:             height: 8px;\n54:             border-radius: 50%;\n55:             margin-right: 0.5rem;\n56:         }\n57:         .status-active { background: #3fb950; }\n58:         .status-stale { background: #484f58; }\n59:         .empty-state {\n60:             text-align: center;\n61:             padding: 3rem;\n62:             color: #484f58;\n63:         }\n64: \n65:         /* Stage sections (vertical collapsible) */\n66:         .stage-section {\n67:             background: #161b22;\n68:             border-radius: 6px;\n69:             margin-bottom: 0.5rem;\n70:             overflow: hidden;\n71:         }\n72:         .stage-toggle {\n73:             width: 100%;\n74:             display: flex;\n75:             justify-content: space-between;\n76:             align-items: center;\n77:             padding: 0.6rem 0.75rem;\n78:             background: #1c2128;\n79:             border: none;\n80:             color: #8b949e;\n81:             font-family: inherit;\n82:             font-size: 0.8rem;\n83:             font-weight: 600;\n84:             text-transform: uppercase;\n85:             letter-spacing: 0.05em;\n86:             cursor: pointer;\n87:             text-align: left;\n88:         }\n89:         .stage-toggle:hover { background: #21262d; }\n90:         .stage-toggle .arrow {\n91:             transition: transform 0.15s;\n92:             font-size: 0.7rem;\n93:         }\n94:         .stage-toggle.collapsed .arrow { transform: rotate(-90deg); }\n95:         .stage-count {\n96:             background: #30363d;\n97:             color: #8b949e;\n98:             padding: 0.1rem 0.45rem;\n99:             border-radius: 10px;\n100:             font-size: 0.7rem;\n101:             min-width: 1.3rem;\n102:             text-align: center;\n103:             margin-left: 0.5rem;\n104:         }\n105:         .stage-count.has-items {\n106:             background: #1f6feb;\n107:             color: #fff;\n108:         }\n109:         .stage-body {\n110:             padding: 0.5rem 0.75rem;\n111:         }\n112:         .stage-body.hidden { display: none; }\n113:         .empty-stage {\n114:             color: #484f58;\n115:             font-size: 0.75rem;\n116:             font-style: italic;\n117:             padding: 0.25rem 0;\n118:         }\n119:         .feature-card {\n120:             background: #0d1117;\n121:             border: 1px solid #21262d;\n122:             border-radius: 4px;\n123:             padding: 0.5rem 0.6rem;\n124:             font-size: 0.8rem;\n125:             cursor: pointer;\n126:             margin-bottom: 0.4rem;\n127:             transition: border-color 0.15s;\n128:         }\n129:         .feature-card:last-child { margin-bottom: 0; }\n130:         .feature-card:hover {\n131:             border-color: #58a6ff;\n132:         }\n133:         .feature-card .title {\n134:             color: #c9d1d9;\n135:             font-weight: 500;\n136:             margin-bottom: 0.25rem;\n137:             word-break: break-word;\n138:         }\n139:         .feature-card .meta {\n140:             color: #484f58;\n141:             font-size: 0.7rem;\n142:         }\n143:         .feature-card .meta span { margin-right: 0.5rem; }\n144: \n145:         /* Feature detail modal */\n146:         .modal-overlay {\n147:             display: none;\n148:             position: fixed;\n149:             top: 0; left: 0; right: 0; bottom: 0;\n150:             background: rgba(0,0,0,0.6);\n151:             z-index: 100;\n152:             justify-content: center;\n153:             align-items: center;\n154:         }\n155:         .modal-overlay.active { display: flex; }\n156:         .modal {\n157:             background: #161b22;\n158:             border: 1px solid #30363d;\n159:             border-radius: 8px;\n160:             padding: 1.5rem;\n161:             max-width: 500px;\n162:             width: 90%;\n163:             max-height: 80vh;\n164:             overflow-y: auto;\n165:         }\n166:         .modal h3 {\n167:             color: #58a6ff;\n168:             font-size: 1rem;\n169:             margin-bottom: 1rem;\n170:         }\n171:         .modal .detail-row {\n172:             display: flex;\n173:             padding: 0.4rem 0;\n174:             border-bottom: 1px solid #21262d;\n175:             font-size: 0.85rem;\n176:         }\n177:         .modal .detail-row:last-child { border-bottom: none; }\n178:         .modal .detail-label {\n179:             color: #8b949e;\n180:             width: 80px;\n181:             flex-shrink: 0;\n182:             font-weight: 600;\n183:         }\n184:         .modal .detail-value {\n185:             color: #c9d1d9;\n186:             word-break: break-word;\n187:         }\n188:         .modal-close {\n189:             float: right;\n190:             background: none;\n191:             border: none;\n192:             color: #8b949e;\n193:             font-size: 1.2rem;\n194:             cursor: pointer;\n195:             padding: 0 0.3rem;\n196:         }\n197:         .modal-close:hover { color: #c9d1d9; }\n198: \n199:         .section-label {\n200:             color: #8b949e;\n201:             font-size: 0.8rem;\n202:             text-transform: uppercase;\n203:             letter-spacing: 0.05em;\n204:             margin-bottom: 0.5rem;\n205:         }\n206:         }\n207:         #dashboard-content { display: none; }\n208:         #dashboard-content.authenticated { display: block; }\n209:     </style>\n210:     {{if .Authenticated}}\n211: </head>\n212: <body>\n213:     <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem\">\n214:         <h1 style=\"margin-bottom:0\">MAD Pipeline Dashboard</h1>\n215:         <button onclick=\"showNewIdeaModal()\" style=\"padding:0.4rem 0.8rem;background:#238636;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:0.85rem;font-weight:600\">+ New Idea</button>\n216:     </div>\n217: \n218:     <div class=\"section-label\">Connected Clients</div>\n219:     <table>\n220:         <thead>\n221:             <tr>\n222:                 <th>Client ID</th>\n223:                 <th>Board(s)</th>\n224:                 <th>Features</th>\n225:                 <th>Plan Agent</th>\n226:                 <th>Impl Agent</th>\n227:                 <th>Last Seen</th>\n228:                 <th>Status</th>\n229:             </tr>\n230:         </thead>\n231:         <tbody hx-get=\"/api/clients?key={{.Key}}\" hx-trigger=\"every 5s\" hx-swap=\"innerHTML\">\n232:             {{template \"client_rows\" .}}\n233:         </tbody>\n234:     </table>\n235: \n236:     <h2>Aggregate View</h2>\n237:     <div id=\"board-container\">\n238:         {{template \"board_fragment\" .}}\n239:     </div>\n240: \n241:     <!-- Feature detail modal -->\n242:     <div class=\"modal-overlay\" id=\"feature-modal\" onclick=\"closeModal(event)\">\n243:         <div class=\"modal\" onclick=\"event.stopPropagation()\">\n244:             <button class=\"modal-close\" onclick=\"closeModal()\">&times;</button>\n245:             <h3 id=\"modal-title\"></h3>\n246:             <div id=\"modal-body\"></div>\n247:         </div>\n248:     </div>\n249: \n250:     <div class=\"modal-overlay\" id=\"key-modal\">\n251:         <div class=\"modal\" style=\"max-width:400px\">\n252:             <h3>Authentication Required</h3>\n253:             <p style=\"color:#8b949e;margin:0.5rem 0 1rem\">Enter your dashboard key to access client details.</p>\n254:             <input type=\"password\" id=\"key-input\" placeholder=\"Enter key\" style=\"width:100%;padding:0.75rem;background:#0d1117;border:1px solid #30363d;border-radius:6px;color:#c9d1d9;font-size:1rem;margin-bottom:1rem\">\n255:             <button onclick=\"saveKey()\" style=\"width:100%;padding:0.75rem;background:#238636;border:none;border-radius:6px;color:#fff;font-size:1rem;cursor:pointer\">Save Key</button>\n256:         </div>\n257:     </div>\n258: \n259:     <!-- New Idea Modal -->\n260:     <div class=\"modal-overlay\" id=\"new-idea-modal\" onclick=\"closeNewIdeaModal(event)\">\n261:         <div class=\"modal\" onclick=\"event.stopPropagation()\" style=\"max-width:450px\">\n262:             <h3 style=\"color:#58a6ff;font-size:1rem;margin-bottom:1rem\">Create New Idea</h3>\n263:             <div style=\"margin-bottom:1rem\">\n264:                 <label style=\"display:block;color:#8b949e;font-size:0.8rem;margin-bottom:0.3rem\">Client *</label>\n265:                 <select id=\"new-idea-client\" style=\"width:100%;padding:0.5rem;background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#c9d1d9;font-size:0.9rem;font-family:inherit\">\n266:                     <option value=\"\">Select a client...</option>\n267:                 </select>\n268:             </div>\n269:             <div style=\"margin-bottom:1rem\">\n270:                 <label style=\"display:block;color:#8b949e;font-size:0.8rem;margin-bottom:0.3rem\">Title *</label>\n271:                 <input type=\"text\" id=\"new-idea-title\" placeholder=\"Enter idea title\" style=\"width:100%;padding:0.5rem;background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#c9d1d9;font-size:0.9rem;font-family:inherit\">\n272:             </div>\n273:             <div style=\"margin-bottom:1rem\">\n274:                 <label style=\"display:block;color:#8b949e;font-size:0.8rem;margin-bottom:0.3rem\">Board *</label>\n275:                 <input type=\"text\" id=\"new-idea-board\" placeholder=\"e.g., default\" style=\"width:100%;padding:0.5rem;background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#c9d1d9;font-size:0.9rem;font-family:inherit\">\n276:             </div>\n277:             <div style=\"margin-bottom:1rem\">\n278:                 <label style=\"display:block;color:#8b949e;font-size:0.8rem;margin-bottom:0.3rem\">Description</label>\n279:                 <textarea id=\"new-idea-description\" placeholder=\"Optional description\" rows=\"3\" style=\"width:100%;padding:0.5rem;background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#c9d1d9;font-size:0.9rem;font-family:inherit;resize:vertical\"></textarea>\n280:             </div>\n281:             <div style=\"display:flex;gap:0.5rem;justify-content:flex-end\">\n282:                 <button onclick=\"closeNewIdeaModal()\" style=\"padding:0.5rem 1rem;background:#30363d;color:#c9d1d9;border:none;border-radius:4px;cursor:pointer;font-size:0.85rem;font-family:inherit\">Cancel</button>\n283:                 <button onclick=\"submitNewIdea()\" id=\"submit-idea-btn\" style=\"padding:0.5rem 1rem;background:#238636;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:0.85rem;font-family:inherit\">Create Idea</button>\n284:             </div>\n285:             <div id=\"new-idea-feedback\" style=\"margin-top:0.75rem;font-size:0.85rem\"></div>\n286:         </div>\n287:     </div>\n288: \n289:     <script>\n290:         // Smart polling for board: only update cards that actually changed\n291:         var _boardURL = '/api/board?key=' + encodeURIComponent(key || '');\n292:         var _lastBoardHTML = '';\n293: \n294:         function smartPollBoard() {\n295:             fetch(_boardURL).then(function(r) { return r.text(); }).then(function(html) {\n296:                 if (html === _lastBoardHTML) return;\n297:                 _lastBoardHTML = html;\n298: \n299:                 var container = document.getElementById('board-container');\n300:                 var tmp = document.createElement('div');\n301:                 tmp.innerHTML = html;\n302: \n303:                 var newSections = tmp.querySelectorAll('.stage-section');\n304:                 var curSections = container.querySelectorAll('.stage-section');\n305: \n306:                 if (newSections.length !== curSections.length) {\n307:                     container.innerHTML = html;\n308:                     return;\n309:                 }\n310: \n311:                 for (var si = 0; si < newSections.length; si++) {\n312:                     var curSec = curSections[si];\n313:                     var newSec = newSections[si];\n314: \n315:                     var curCount = curSec.querySelector('.stage-count');\n316:                     var newCount = newSec.querySelector('.stage-count');\n317:                     if (curCount && newCount) {\n318:                         curCount.textContent = newCount.textContent;\n319:                         curCount.className = newCount.className;\n320:                     }\n321: \n322:                     var curBody = curSec.querySelector('.stage-body');\n323:                     var newBody = newSec.querySelector('.stage-body');\n324: \n325:                     function cardHash(c) {\n326:                         return [c.getAttribute('data-id'), c.getAttribute('data-stage'),\n327:                                 c.getAttribute('data-title'), c.getAttribute('data-description'),\n328:                                 c.getAttribute('data-history')].join('|');\n329:                     }\n330: \n331:                     var newCards = newBody.querySelectorAll('.feature-card');\n332:                     var curCards = curBody.querySelectorAll('.feature-card');\n333:                     var same = curCards.length === newCards.length;\n334:                     if (same) {\n335:                         for (var ci = 0; ci < newCards.length; ci++) {\n336:                             if (cardHash(curCards[ci]) !== cardHash(newCards[ci])) { same = false; break; }\n337:                         }\n338:                     }\n339: \n340:                     if (!same) {\n341:                         var wasHidden = curBody.classList.contains('hidden');\n342:                         curBody.innerHTML = newBody.innerHTML;\n343:                         if (wasHidden) curBody.classList.add('hidden');\n344:                     }\n345:                 }\n346:             }).catch(function() {});\n347:         }\n348: \n349:         setInterval(smartPollBoard, 5000);\n350: \n351:         var _clientsCache = [];\n352: \n353:         function showNewIdeaModal() {\n354:             document.getElementById('new-idea-modal').classList.add('active');\n355:             document.getElementById('new-idea-title').value = '';\n356:             document.getElementById('new-idea-board').value = '';\n357:             document.getElementById('new-idea-description').value = '';\n358:             document.getElementById('new-idea-feedback').textContent = '';\n359:             \n360:             // Fetch clients to populate the dropdown\n361:             fetch('/api/clients?key=' + encodeURIComponent(key)).then(function(r) { return r.json(); }).then(function(clients) {\n362:                 _clientsCache = clients;\n363:                 var select = document.getElementById('new-idea-client');\n364:                 select.innerHTML = '<option value=\"\">Select a client...</option>';\n365:                 clients.forEach(function(c) {\n366:                     var opt = document.createElement('option');\n367:                     opt.value = c.client_id;\n368:                     opt.textContent = c.client_id + (c.connected ? '' : ' (disconnected)');\n369:                     select.appendChild(opt);\n370:                 });\n371:                 // Auto-select if only one connected client\n372:                 var connected = clients.filter(function(c) { return c.connected; });\n373:                 if (connected.length === 1) {\n374:                     select.value = connected[0].client_id;\n375:                 }\n376:             }).catch(function() {});\n377:             \n378:             document.getElementById('new-idea-title').focus();\n379:         }\n380: \n381:         function closeNewIdeaModal(event) {\n382:             if (!event || event.target === document.getElementById('new-idea-modal')) {\n383:                 document.getElementById('new-idea-modal').classList.remove('active');\n384:             }\n385:         }\n386: \n387:         function submitNewIdea() {\n388:             var clientID = document.getElementById('new-idea-client').value;\n389:             var title = document.getElementById('new-idea-title').value.trim();\n390:             var board = document.getElementById('new-idea-board').value.trim();\n391:             var description = document.getElementById('new-idea-description').value.trim();\n392:             var feedback = document.getElementById('new-idea-feedback');\n393:             var btn = document.getElementById('submit-idea-btn');\n394: \n395:             if (!clientID) {\n396:                 feedback.style.color = '#f85149';\n397:                 feedback.textContent = 'Please select a client';\n398:                 return;\n399:             }\n400:             if (!title) {\n401:                 feedback.style.color = '#f85149';\n402:                 feedback.textContent = 'Title is required';\n403:                 return;\n404:             }\n405:             if (!board) {\n406:                 feedback.style.color = '#f85149';\n407:                 feedback.textContent = 'Board is required';\n408:                 return;\n409:             }\n410: \n411:             btn.disabled = true;\n412:             btn.textContent = 'Creating...';\n413: \n414:             fetch('/api/clients/' + encodeURIComponent(clientID) + '/ideas?key=' + encodeURIComponent(key), {\n415:                 method: 'POST',\n416:                 headers: {'Content-Type': 'application/json'},\n417:                 body: JSON.stringify({title: title, board: board, description: description})\n418:             }).then(function(resp) {\n419:                 return resp.json().then(function(data) { return {ok: resp.ok, data: data}; });\n420:             }).then(function(result) {\n421:                 if (result.ok) {\n422:                     feedback.style.color = '#3fb950';\n423:                     feedback.textContent = 'Idea created successfully!';\n424:                     setTimeout(function() {\n425:                         closeNewIdeaModal();\n426:                         smartPollBoard();\n427:                     }, 1000);\n428:                 } else {\n429:                     feedback.style.color = '#f85149';\n430:                     feedback.textContent = result.data.error || 'Failed to create idea';\n431:                     btn.disabled = false;\n432:                     btn.textContent = 'Create Idea';\n433:                 }\n434:             }).catch(function(err) {\n435:                 feedback.style.color = '#f85149';\n436:                 feedback.textContent = 'Network error';\n437:                 btn.disabled = false;\n438:                 btn.textContent = 'Create Idea';\n439:             });\n440:         }\n441: \n442:         function getKey() {\n443:             var urlKey = new URLSearchParams(window.location.search).get('key');\n444:             if (urlKey) {\n445:                 localStorage.setItem('mad_key', urlKey);\n446:                 return urlKey;\n447:             }\n448:             return localStorage.getItem('mad_key') || '';\n449:         }\n450: \n451:         function saveKey() {\n452:             var input = document.getElementById('key-input');\n453:             var k = input.value.trim();\n454:             if (k) {\n455:                 localStorage.setItem('mad_key', k);\n456:                 document.getElementById('key-modal').classList.remove('active');\n457:                 location.reload();\n458:             }\n459:         }\n460: \n461:         var key = getKey();\n462:         if (key) {\n463:             document.addEventListener('htmx:afterSwap', function() {\n464:                 document.querySelectorAll('a[href^=\"/clients/\"]').forEach(a => {\n465:                     if (!a.href.includes('key=')) a.href += '?key=' + key;\n466:                 });\n467:             });\n468:             document.querySelectorAll('a[href^=\"/clients/\"]').forEach(a => {\n469:                 if (!a.href.includes('key=')) a.href += '?key=' + key;\n470:             });\n471:         }\n472: \n473:         document.body.addEventListener('htmx:responseError', function(evt) {\n474:             if (evt.detail.xhr.status === 401) {\n475:                 document.getElementById('key-modal').classList.add('active');\n476:             }\n477:         });\n478: \n479:         document.getElementById('key-input').addEventListener('keypress', function(e) {\n480:             if (e.key === 'Enter') saveKey();\n481:         });\n482: \n483:         if (!key && document.getElementById('key-modal')) {\n484:             document.getElementById('key-modal').classList.add('active');\n485:         }\n486: \n487:         document.querySelectorAll('a[href^=\"/clients/\"]').forEach(a => {\n488:             if (!a.href.includes('key=') && key) a.href += '?key=' + key;\n489:         });\n490: \n491:         function toggleStage(btn) {\n492:             var body = btn.nextElementSibling;\n493:             btn.classList.toggle('collapsed');\n494:             body.classList.toggle('hidden');\n495:         }\n496: \n497:         function showFeature(card) {\n498:             var title = card.getAttribute('data-title');\n499:             var stage = card.getAttribute('data-stage');\n500:             var board = card.getAttribute('data-board');\n501:             var created = card.getAttribute('data-created');\n502:             var featureId = card.getAttribute('data-id');\n503:             var description = card.getAttribute('data-description') || '';\n504:             var historyJSON = card.getAttribute('data-history') || '[]';\n505: \n506:             var html =\n507:                 '<div class=\"detail-row\"><span class=\"detail-label\">Stage</span><span class=\"detail-value\">' + escapeHtml(stage) + '</span></div>' +\n508:                 '<div class=\"detail-row\"><span class=\"detail-label\">Board</span><span class=\"detail-value\">' + escapeHtml(board) + '</span></div>' +\n509:                 '<div class=\"detail-row\"><span class=\"detail-label\">Created</span><span class=\"detail-value\">' + escapeHtml(created) + '</span></div>' +\n510:                 '<div class=\"detail-row\"><span class=\"detail-label\">ID</span><span class=\"detail-value\">' + escapeHtml(featureId) + '</span></div>';\n511: \n512:             if (description) {\n513:                 html += '<div style=\"margin-top:0.75rem;padding-top:0.5rem;border-top:1px solid #21262d\">' +\n514:                     '<div style=\"color:#8b949e;font-size:0.75rem;font-weight:600;text-transform:uppercase;margin-bottom:0.3rem\">Description</div>' +\n515:                     '<div style=\"color:#c9d1d9;font-size:0.8rem;white-space:pre-wrap\">' + escapeHtml(description) + '</div></div>';\n516:             }\n517: \n518:             try {\n519:                 var history = JSON.parse(historyJSON);\n520:                 if (history && history.length > 0) {\n521:                     html += '<div style=\"margin-top:0.75rem;padding-top:0.5rem;border-top:1px solid #21262d\">' +\n522:                         '<div style=\"color:#8b949e;font-size:0.75rem;font-weight:600;text-transform:uppercase;margin-bottom:0.3rem\">History (' + history.length + ')</div>';\n523:                     for (var i = 0; i < history.length; i++) {\n524:                         var h = history[i];\n525:                         html += '<div style=\"font-size:0.75rem;padding:0.2rem 0;border-bottom:1px solid #161b22\">' +\n526:                             '<span style=\"color:#484f58\">' + escapeHtml(h.ts || '') + '</span> ' +\n527:                             '<span style=\"color:#d2a8ff;font-weight:600\">' + escapeHtml(h.stage || '') + '</span> ' +\n528:                             '<span style=\"color:#c9d1d9\">' + escapeHtml(h.note || '') + '</span></div>';\n529:                     }\n530:                     html += '</div>';\n531:                 }\n532:             } catch(e) {}\n533: \n534:             document.getElementById('modal-title').textContent = title;\n535:             document.getElementById('modal-body').innerHTML = html;\n536:             document.getElementById('feature-modal').classList.add('active');\n537:         }\n538: \n539:         function closeModal(event) {\n540:             if (!event || event.target === document.getElementById('feature-modal')) {\n541:                 document.getElementById('feature-modal').classList.remove('active');\n542:             }\n543:         }\n544: \n545:         document.addEventListener('keydown', function(e) {\n546:             if (e.key === 'Escape') {\n547:                 document.getElementById('feature-modal').classList.remove('active');\n548:             }\n549:         });\n550: \n551:         function escapeHtml(text) {\n552:             var div = document.createElement('div');\n553:             div.textContent = text;\n554:             return div.innerHTML;\n555:         }\n556:     </script>\n557:     <script>if ('serviceWorker' in navigator) { navigator.serviceWorker.register('/sw.js'); }</script>\n558: </body>\n559: </html>\n560: \n561: {{define \"client_rows\"}}{{if .Clients}}{{range .Clients}}<tr>\n562:     <td><a href=\"/clients/{{.ClientID}}?key={{$.Key}}\">{{.ClientID}}</a></td>\n563:     <td>{{uniqueBoards .Features}}</td>\n564:     <td>{{len .Features}}</td>\n565:     <td>{{if .PlanAgent.Running}}<span class=\"status-dot status-active\"></span>{{.PlanAgent.Phase}}{{if .PlanAgent.Feature}} ({{.PlanAgent.Feature}}){{end}}{{else}}<span style=\"color:#484f58\">idle</span>{{end}}</td>\n566:     <td>{{if .ImplAgent.Running}}<span class=\"status-dot status-active\"></span>{{.ImplAgent.Phase}}{{if .ImplAgent.Feature}} ({{.ImplAgent.Feature}}){{end}}{{else}}<span style=\"color:#484f58\">idle</span>{{end}}</td>\n567:     <td>{{.LastSeen.Format \"15:04:05\"}}</td>\n568:     <td>{{if .Connected}}<span class=\"status-dot status-active\"></span>Connected{{else}}<span class=\"status-dot status-stale\"></span>Disconnected{{end}}</td>\n569: </tr>{{end}}{{else}}<tr><td colspan=\"7\" class=\"empty-state\">No clients connected</td></tr>{{end}}{{end}}\n570: \n571: {{define \"board_fragment\"}}{{range .StageGroups}}<div class=\"stage-section\">\n572:     <button class=\"stage-toggle{{if not .Features}} collapsed{{end}}\" onclick=\"toggleStage(this)\">\n573:         <span>{{stageLabel .Stage}} <span class=\"stage-count{{if .Features}} has-items{{end}}\">{{len .Features}}</span></span>\n574:         <span class=\"arrow\">&#9660;</span>\n575:     </button>\n576:     <div class=\"stage-body{{if not .Features}} hidden{{end}}\">\n577:         {{if .Features}}{{range .Features}}<div class=\"feature-card\" onclick=\"showFeature(this)\"\n578:             data-title=\"{{.Title}}\"\n579:             data-stage=\"{{.Stage}}\"\n580:             data-board=\"{{.Board}}\"\n581:             data-created=\"{{.Created}}\"\n582:             data-id=\"{{.ID}}\"\n583:             data-description=\"{{.Description}}\"\n584:             data-history=\"{{toJSON .History}}\"\n585:             data-client=\"{{.ClientID}}\">\n586:             <div class=\"title\">{{.Title}}</div>\n587:             <div class=\"meta\">{{if .ClientID}}<span style=\"color:#d2a8ff\">{{.ClientID}}</span>{{end}}<span>{{.Board}}</span><span>{{.Created}}</span></div>\n588:         </div